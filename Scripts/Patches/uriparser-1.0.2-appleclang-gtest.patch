diff --git a/CMakeLists.txt b/CMakeLists.txt
index c7d2591..2f5865d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -354,9 +354,9 @@ if(URIPARSER_BUILD_TESTS)
         ${CMAKE_CURRENT_BINARY_DIR}  # for UriConfig.h
     )
 
-    target_link_libraries(testrunner PUBLIC
-        ${GTEST_BOTH_LIBRARIES}
-    )
+    # The test suite defines its own main(), so linking gtest_main would add a
+    # redundant archive and duplicate GTest::gtest on modern CMake packages.
+    target_link_libraries(testrunner PRIVATE ${GTEST_LIBRARIES})
 
     # NOTE: uriparser does not use pthreads itself but gtest does
     find_package(Threads REQUIRED)
diff --git a/test/VersionSuite.cpp b/test/VersionSuite.cpp
