class Skybridge < Formula
  desc "SkyBridge CLI headless operator surface"
  homepage "https://github.com/billlza/Skybridge-Compass"
  version "__VERSION__"

  on_macos do
    on_arm do
      url "__BASE_URL__/skybridge-aarch64-apple-darwin.tar.gz"
      sha256 "__DARWIN_ARM64_SHA256__"
    end
  end

  on_linux do
    on_arm do
      url "__BASE_URL__/skybridge-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "__LINUX_ARM64_SHA256__"
    end

    on_intel do
      url "__BASE_URL__/skybridge-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "__LINUX_X64_SHA256__"
    end
  end

  def install
    bin.install "skybridge"
  end

  test do
    output = shell_output("#{bin}/skybridge version")
    assert_match version.to_s, output
    assert_match "phase_5_signaling_plane", output
  end
end
