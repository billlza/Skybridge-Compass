<Window
    x:Class="Skybridge.WinClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Skybridge.WinClient.ViewModels"
    xmlns:local="using:Skybridge.WinClient"
    xmlns:settings="using:Skybridge.WinClient.Settings"
    mc:Ignorable="d">
    <Grid
        x:Name="RootShell"
        Background="{StaticResource SkyBridgeWindowGradientBrush}"
        d:DataContext="{d:DesignInstance Type=vm:SessionViewModel, IsDesignTimeCreatable=False}">
        <!-- Sidebar keyboard navigation, matching the macOS app's Cmd+Shift+Up/Down.
             On Windows the native chord is Ctrl+Shift+Up/Down (向日葵/SunloginClient maps
             a Mac Cmd to Win Ctrl, so the same physical chord works over remote control).
             Moves the selected sidebar feature one step, clamped to the list bounds. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Down" Invoked="OnSidebarNavigateNext" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Up" Invoked="OnSidebarNavigatePrevious" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
        <vm:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <vm:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <vm:FeatureEntryIdToAccentBrushConverter x:Key="FeatureAccentBrushConverter" />
        <vm:MetricKeyToGlyphConverter x:Key="MetricGlyphConverter" />
        <vm:MetricKeyToBrushConverter x:Key="MetricAccentBrushConverter" />
        <vm:QuickActionKeyToBrushConverter x:Key="QuickActionAccentBrushConverter" />
        <vm:MonitorTileVisibilityConverter x:Key="MonitorTileVisibilityConverter" />
        <vm:SystemMetricKeyToGlyphConverter x:Key="SystemMetricGlyphConverter" />
        <vm:SystemMetricKeyToBrushConverter x:Key="SystemMetricAccentBrushConverter" />
        <vm:SystemMetricLabelToCaptionConverter x:Key="SystemMetricCaptionConverter" />
        <vm:SystemIndicatorLabelToGlyphConverter x:Key="SystemIndicatorGlyphConverter" />
        <vm:SystemIndicatorStateToBrushConverter x:Key="SystemIndicatorStateBrushConverter" />
        <vm:PlatformToGlyphConverter x:Key="PlatformGlyphConverter" />
        <vm:PeerStatusToBrushConverter x:Key="PeerStatusBrushConverter" />
        <vm:ConnectionStatusToDotBrushConverter x:Key="ConnectionStatusDotBrushConverter" />
        <vm:StringPresenceToVisibilityConverter x:Key="StringPresenceVisibilityConverter" />
        <vm:ServiceKindToGlyphConverter x:Key="ServiceKindGlyphConverter" />
        <vm:ServiceKindToBrushConverter x:Key="ServiceKindBrushConverter" />
        <vm:WeatherConditionToGlyphConverter x:Key="WeatherConditionGlyphConverter" />
        <vm:WeatherConditionToBrushConverter x:Key="WeatherConditionBrushConverter" />
        <vm:WeatherMetricKeyToGlyphConverter x:Key="WeatherMetricGlyphConverter" />
        <vm:WeatherMetricTintToBrushConverter x:Key="WeatherMetricTintBrushConverter" />
        <vm:WeatherPhaseToVisibilityConverter x:Key="WeatherPhaseVisibilityConverter" />
        <vm:SystemProxyStateToBrushConverter x:Key="SystemProxyStateBrushConverter" />
        <vm:FileTransferStateToBrushConverter x:Key="FileTransferStateBrushConverter" />
        <vm:FileTransferStateToGlyphConverter x:Key="FileTransferStateGlyphConverter" />
        <vm:FileTransferDirectionToGlyphConverter x:Key="FileTransferDirectionGlyphConverter" />
        <vm:FileTransferDirectionToBrushConverter x:Key="FileTransferDirectionBrushConverter" />
        <vm:FileTransferResultToShieldGlyphConverter x:Key="FileTransferResultShieldGlyphConverter" />
        <vm:SettingsControlKindToVisibilityConverter x:Key="SettingsControlKindVisibilityConverter" />
        <vm:SettingsValueStateToBrushConverter x:Key="SettingsValueStateBrushConverter" />
        <!-- Host-swap converter: shows the per-tab Settings UserControl whose stable English
             title matches SelectedSettingsTab, so the inline Settings right pane realizes exactly
             one of the eight interactive tab views at a time. -->
        <vm:SettingsTabKeyToVisibilityConverter x:Key="SettingsTabKeyVisibilityConverter" />
        <vm:AvatarUrlToImageSourceConverter x:Key="AvatarUrlImageSourceConverter" />
        <!-- USB Management converters (element-match the Mac USBDeviceManagementView
             DeviceCard icons/tints + USBStatCard icons/tints + MFi-badge gate). -->
        <vm:UsbDeviceTypeToGlyphConverter x:Key="UsbDeviceTypeGlyphConverter" />
        <vm:UsbDeviceTypeToBrushConverter x:Key="UsbDeviceTypeBrushConverter" />
        <vm:UsbMetricKeyToGlyphConverter x:Key="UsbMetricGlyphConverter" />
        <vm:UsbMetricKeyToBrushConverter x:Key="UsbMetricAccentBrushConverter" />
        <vm:BoolToVisibilityValueConverter x:Key="BoolVisibilityConverter" />
        <!-- Soft Remote-Desktop accent fill for the selected connection-mode segment
             (element-matches the Mac segmented control's selected pill =
             accentColor.opacity(0.2)). Indigo RD-nav hue (#6E7BF2) at ~33% alpha. -->
        <SolidColorBrush x:Key="SkyBridgeRemoteDesktopSoftBrush" Color="#556E7BF2" />
        <ItemsPanelTemplate x:Key="VerticalWorkspaceActionItemsPanel">
            <StackPanel Spacing="10" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="HorizontalWorkspaceActionItemsPanel">
            <StackPanel Orientation="Horizontal" Spacing="10" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="SessionWorkspaceActionItemsPanel">
            <StackPanel Orientation="Horizontal" Spacing="12" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WorkspaceMetricCardItemsPanel">
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="232" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="DashboardQuickActionItemsPanel">
            <!-- 2x2 grid of quick-action tiles (Mac QuickActionsPanelView inner
                 LazyVGrid). ItemWidth tuned to 158 so two tiles fit inside the
                 half-width Quick Actions cell of the dashboard 2x2 panel grid. -->
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="158" />
        </ItemsPanelTemplate>
        <!-- System Monitor Overview metric-tile grid: a wrapping row of colored
             metric tiles (Mac SystemMetricsPanelView). 4 Overview metrics
             (CPU/Memory/Disk/Network) flow up to 4-across then wrap. ItemWidth tuned
             to 244 = 232 tile + 12 gutter so tiles sit flush inside the page panel. -->
        <ItemsPanelTemplate x:Key="SystemMonitorMetricTileItemsPanel">
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="244" />
        </ItemsPanelTemplate>
        <!-- System Monitor indicator status-pill strip: horizontally wrapping pills
             (Mac PerformanceMonitoringPanelView Health/Thermal/Load indicators). -->
        <ItemsPanelTemplate x:Key="SystemMonitorIndicatorPillItemsPanel">
            <ItemsWrapGrid Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <!-- NavigationView MenuItemTemplate: per-item content is icon + name on a
             SINGLE line (element-matches the Mac sidebar rows, which carry NO
             secondary/subtitle text). The icon is colored with the feature's own
             accent (per-feature SkyBridgeNav*Brush via FeatureAccentBrushConverter),
             so each section reads as its own destination — Dashboard blue, Device
             Discovery green/cyan, USB teal, File Transfer green, Remote Desktop
             indigo, System Monitor orange, Settings slate.
             The FeatureEntry.Status field is intentionally NOT rendered here (it
             stays on the model as a backend contract); the Mac shows no subtitle,
             so binding it would be the biggest knock-off tell. The native
             NavigationViewItemPresenter owns selection/hover/keyboard/a11y and the
             filled selection pill (App.xaml theme overrides), so this template
             carries ONLY the content — no selection visuals. Row height ~26px of
             content + the presenter's own padding lands at the Mac's generous
             ~52px row. -->
        <DataTemplate x:Key="NavigationItemTemplate">
            <Grid
                MinHeight="44"
                ColumnSpacing="14"
                AutomationProperties.AutomationId="{Binding Id}"
                AutomationProperties.Name="{Binding Title}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    Glyph="{Binding Glyph}"
                    FontSize="22"
                    Foreground="{Binding Id, Converter={StaticResource FeatureAccentBrushConverter}}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                    FontSize="15"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceActionButtonTemplate">
            <Button
                AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding Command}"
                IsEnabled="{Binding IsEnabled}"
                Width="44"
                Height="36"
                MinWidth="44"
                Padding="10,6"
                ToolTipService.ToolTip="{Binding Title}">
                <FontIcon Glyph="{Binding Glyph}" FontSize="14" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceActionButtonWithDetailTemplate">
            <Button
                AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding Command}"
                IsEnabled="{Binding IsEnabled}"
                MinWidth="0"
                Padding="10,6"
                ToolTipService.ToolTip="{Binding Title}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{Binding Glyph}" FontSize="14" />
                    <TextBlock Text="{Binding Title}" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="TopBarStatusActionButtonTemplate">
            <Button
                AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding Command}"
                IsEnabled="{Binding IsEnabled}"
                MinWidth="44"
                Padding="8,6"
                ToolTipService.ToolTip="{Binding Title}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="{Binding Glyph}" FontSize="14" />
                    <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceMetricCardTemplate">
            <!-- Element-matches the Mac StatCard.swift: colored icon top-left,
                 then a small secondary label, then a big bold value. There is NO
                 caption/description under the value on the Mac, so the Detail
                 TextBlock is intentionally absent here. -->
            <Border Style="{StaticResource MetricCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Accent icon chip (top-left), matching the Mac StatCard glyph badge.
                         Glyph + accent hue are keyed per-metric off the stable Title
                         (Online Devices / Active Sessions / Transfer Tasks / System Status)
                         so each card reads distinctly like the Mac StatCard. -->
                    <Border
                        Style="{StaticResource AccentIconChip}"
                        HorizontalAlignment="Left">
                        <FontIcon
                            Glyph="{Binding Title, Converter={StaticResource MetricGlyphConverter}}"
                            FontSize="18"
                            Foreground="{Binding Title, Converter={StaticResource MetricAccentBrushConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <!-- Bottom group: small secondary label + big bold value
                         (Mac VStack rhythm: label .caption .secondary, value .title.bold). -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="4">
                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="12"
                            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}"
                            TextWrapping="Wrap"
                            MaxLines="1" />
                        <TextBlock
                            Text="{Binding Value}"
                            FontSize="30"
                            FontWeight="Bold"
                            LineHeight="34"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Weather metric grid cell: color-emoji icon (fixed 16-wide) + a label-over-value
             VStack, element-matching the Mac WeatherMetric (HStack: icon, then
             [label .caption2 muted; value .caption.bold]). The icon is a COLOR EMOJI via
             Segoe UI Emoji (Segoe Fluent Icons has no weather/humidity/AQI glyphs), so it is
             pre-colored and carries no Foreground tint. The per-metric tint (humidity=cyan,
             wind=mint, visibility=blue, and the AQI bucket color green/yellow/orange/red/
             purple/brown) now lives on the VALUE text, preserving the air-quality signal. -->
        <DataTemplate x:Key="WeatherMetricItemTemplate">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock
                    Text="{Binding Key, Converter={StaticResource WeatherMetricGlyphConverter}}"
                    FontFamily="Segoe UI Emoji"
                    FontSize="14"
                    Width="16"
                    VerticalAlignment="Top" />
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="{Binding Label}"
                        FontSize="11"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    <TextBlock
                        Text="{Binding Value}"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{Binding TintKey, Converter={StaticResource WeatherMetricTintBrushConverter}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WeatherMetricItemsPanel">
            <!-- 2 columns, matching the Mac LazyVGrid(2 flexible cols, spacing 10). -->
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="150" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="DashboardQuickActionTemplate">
            <!-- Element-matches the Mac QuickActionButton.swift: a centered colored
                 icon over a centered title, NO subtitle/description (Mac shows none).
                 The colored glyph hue is keyed per-action off the stable Key. -->
            <Button
                Style="{StaticResource QuickActionTile}"
                AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding Command}"
                IsEnabled="{Binding IsEnabled}"
                Width="146"
                Margin="0,0,12,12">
                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border
                        Width="44"
                        Height="44"
                        CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                        Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                        BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                        <FontIcon
                            Glyph="{Binding Glyph}"
                            FontSize="18"
                            Foreground="{Binding Key, Converter={StaticResource QuickActionAccentBrushConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock
                        Text="{Binding Title}"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <!-- ===================================================================
             Dashboard Device-Discovery summary ROW. Element-matches the Mac
             EnhancedDeviceRow: per-device-type icon (keyed off Platform) +
             [name (.headline white) over device-id (.caption secondary)] + a
             trailing status dot (green when a fingerprint/identity is present,
             i.e. the peer is wire-reachable). Non-interactive (no Connect button
             on the dashboard SUMMARY — the full Device Discovery feature page owns
             connect actions), so it adds no button element to the gated count.
             Bound to the live SessionViewModel.DiscoveredPeers collection
             (DiscoveredPeerView: DeviceId / DisplayName / Platform / ServiceKind /
             PublicKeyFingerprint / ...), which is fed by the Win32 DNS-SD browser.
             =================================================================== -->
        <DataTemplate x:Key="DashboardDeviceSummaryRowTemplate">
            <Border Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="38"
                        Height="38"
                        CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                        Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                        BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                        <FontIcon
                            Glyph="{Binding Platform, Converter={StaticResource PlatformGlyphConverter}}"
                            FontSize="18"
                            Foreground="{StaticResource SkyBridgeAccentSecondaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding DisplayName}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            Text="{Binding DeviceId}"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    </StackPanel>
                    <Ellipse
                        Grid.Column="2"
                        Style="{StaticResource StatusDot}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <!-- ===================================================================
             Dashboard Remote-Sessions summary ROW. Element-matches the Mac
             RemoteSessionStatusView: [target name (.headline white) over
             "<transport> • <quality>" (.subheadline secondary)] on the left, a
             State badge on the right. Non-interactive (no View/Disconnect buttons
             on the SUMMARY — the Remote Desktop feature page owns those), so it
             adds no button element. Bound to SessionViewModel.RemoteDesktopSessions
             (RemoteDesktopSessionItemView: TargetName / State / Transport /
             Quality / Detail). NOTE: per recon this collection currently holds
             only placeholder preview rows (no live-session source), so when it is
             empty the panel shows the honest "No active sessions" empty state.
             =================================================================== -->
        <DataTemplate x:Key="DashboardSessionSummaryRowTemplate">
            <Border Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,0,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding TargetName}"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}">
                            <Run Text="{Binding Transport}" />
                            <Run Text=" • " />
                            <Run Text="{Binding Quality}" />
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding State}"
                            FontSize="12"
                            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- ===================================================================
             Dashboard System-Performance summary ROW. Element-matches the Mac
             MetricView / PerformanceMetricRow: a per-metric colored icon chip +
             [label (.caption secondary) over value (.title3.bold tinted)] on the
             left, the Detail string (.caption muted) on the right. Glyph + tint are
             keyed off the metric Label (CPU / Memory / Disk / Network). Bound to
             SessionViewModel.SystemMonitorOverview (SystemMonitorMetricView:
             Label / Value / Detail), a real in-process read-only sampler — Memory/
             Disk/Network are live; CPU stays honestly labeled (its Detail says
             "Usage sampling requires ETW/EventSource wiring").
             =================================================================== -->
        <DataTemplate x:Key="DashboardSystemMetricRowTemplate">
            <Grid ColumnSpacing="12" Padding="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="34"
                    Height="34"
                    CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                    Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                    BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                    <FontIcon
                        Glyph="{Binding Label, Converter={StaticResource SystemMetricGlyphConverter}}"
                        FontSize="16"
                        Foreground="{Binding Label, Converter={StaticResource SystemMetricAccentBrushConverter}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding Label}"
                        FontSize="12"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    <TextBlock
                        Text="{Binding Value}"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{Binding Label, Converter={StaticResource SystemMetricAccentBrushConverter}}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    Text="{Binding Detail}"
                    FontSize="11"
                    MaxWidth="150"
                    TextWrapping="Wrap"
                    TextAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceFactRowTemplate">
            <Grid Padding="0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                <TextBlock
                    Grid.Column="2"
                    Text="{Binding Detail}"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
            </Grid>
        </DataTemplate>
        <!-- ===================================================================
             SystemMonitorMetricTileTemplate — the colored metric TILE for the
             System Monitor page Overview grid. Element-matches the Mac
             SystemMetricsPanelView / MetricChartView row: a per-metric accent icon
             chip, the metric Label as a .caption secondary sub-label (with a short
             human caption beneath via SystemMetricCaptionConverter), and the big
             tinted Value (Mac .title3.bold in the metric's accent color). The Detail
             string sits beneath in muted text (e.g. "1.2 GB process working set",
             "C:\ 240 GB free", or CPU's honest "Usage sampling requires ETW…").
             Glyph + tint are keyed off Label (SystemMetricGlyphConverter /
             SystemMetricAccentBrushConverter): CPU orange, Memory blue, Disk violet,
             Network green — matching the Mac per-channel tinting. Bound to the REAL
             SystemMonitorOverview sampler (SystemMonitorMetricView Label/Value/Detail):
             Memory/Disk/Network are live; CPU's Value is the honest logical-core count
             ("N logical"), not a fabricated %, because CPU% needs ETW wiring. No inline
             Button — the tile is display-only. Uses the MetricCard glass chrome.
             =================================================================== -->
        <DataTemplate x:Key="SystemMonitorMetricTileTemplate">
            <!-- Tile Visibility ← 系统监控 显示项: the MonitorTileVisibilityConverter maps this
                 tile's Label to the matching ShowMonitor* flag on the MonitorDisplayPrefs resource;
                 a metric turned off in Settings collapses its tile (the VM re-projects the
                 collection on a flag change so this re-evaluates). -->
            <Border Style="{StaticResource MetricCard}" Width="232" Height="132"
                    Visibility="{Binding Label, Converter={StaticResource MonitorTileVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="34"
                            Height="34"
                            CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                            Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                            BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                            <FontIcon
                                Glyph="{Binding Label, Converter={StaticResource SystemMetricGlyphConverter}}"
                                FontSize="16"
                                Foreground="{Binding Label, Converter={StaticResource SystemMetricAccentBrushConverter}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding Label}"
                                FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            <TextBlock
                                Text="{Binding Label, Converter={StaticResource SystemMetricCaptionConverter}}"
                                FontSize="11"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Value}"
                        FontSize="20"
                        FontWeight="Bold"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{Binding Label, Converter={StaticResource SystemMetricAccentBrushConverter}}" />
                    <TextBlock
                        Text="{Binding Detail}"
                        FontSize="11"
                        MaxLines="2"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- ===================================================================
             SystemMonitorIndicatorPillTemplate — the tinted status PILL for the
             System Monitor page indicator strip. Element-matches the Mac
             PerformanceMonitoringPanelView inline indicator rows (Health / Thermal /
             Load) rendered as capsule pills: a status dot + indicator glyph + Label +
             the live State value, all tinted by State via SystemIndicatorStateBrushConverter
             (green = healthy/active/nominal, orange = caution/read-only, red = offline,
             muted = unknown/idle/off — pending states stay muted, never faked-healthy).
             Bound to the REAL SystemMonitorIndicators collection (SystemMonitorIndicatorView
             Label/State/Detail): Health is derived from live memory/disk/network; Thermal
             stays honestly "Unknown" (no Windows temperature provider yet). Detail rides
             as the pill tooltip so the pill stays compact. Uses StatusPill + StatusDot.
             No inline Button — the pill is display-only.
             =================================================================== -->
        <DataTemplate x:Key="SystemMonitorIndicatorPillTemplate">
            <Border Style="{StaticResource StatusPill}" ToolTipService.ToolTip="{Binding Detail}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource SystemIndicatorStateBrushConverter}}" />
                    <FontIcon
                        Glyph="{Binding Label, Converter={StaticResource SystemIndicatorGlyphConverter}}"
                        FontSize="14"
                        Foreground="{Binding State, Converter={StaticResource SystemIndicatorStateBrushConverter}}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{Binding Label}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{Binding State}"
                        Foreground="{Binding State, Converter={StaticResource SystemIndicatorStateBrushConverter}}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- ===================================================================
             DiscoveredPeerItemTemplate — the RICH per-peer row for the full
             Device Discovery page's DiscoveredPeers ListView. Element-matches the
             Mac OnlineDeviceCard / EnhancedDeviceRow:
               [status-tinted device-type icon chip 44x44]
               + [ name (.headline white)  · trust badge · status dot ]
                 [ "<Platform> • <ServiceKind>" secondary line ]
                 [ connection-type chip (transport icon + ServiceKind label) ]
                 [ DeviceId (.caption muted) ]
                 [ Capabilities (.caption2 secondary, only if present) ]
                 [ Fingerprint  (.caption2 muted,    only if present) ]
                 [ TrustSummary (.caption2 secondary, only if present) ]
             All fields are LIVE DiscoveredPeerView data (DNS-SD browser): DeviceId /
             DisplayName / Platform / ServiceKind / PublicKeyFingerprint /
             CapabilitiesSummary / TrustSummary. The device-type icon is keyed off
             Platform (PlatformGlyphConverter); the status dot + icon tint are keyed
             off PublicKeyFingerprint presence (green when the peer advertises a
             verifiable identity, muted gray otherwise) — no fabricated state.
             Wrapped in GlassCard so the full-page peer list matches the carded
             dashboard look (closes the asymmetry noted in recon). Contains NO
             inline button element — connect actions live on the page's shared
             action surfaces, so the gated button count is unaffected.
             =================================================================== -->
        <DataTemplate x:Key="DiscoveredPeerItemTemplate">
            <!-- Padding binds to DeviceDisplayPrefs.CardPadding (紧凑模式 tightens it live). -->
            <Border Style="{StaticResource GlassCard}" Padding="{Binding CardPadding, Source={StaticResource DeviceDisplayPrefs}}" Margin="0,0,0,8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Status-tinted device-type icon chip (Mac 40-50px rounded-square
                         status chip, r12 .continuous). Visibility ← 显示设备图标; Width/Height ←
                         DeviceDisplayPrefs.IconSize (紧凑模式 shrinks it live). -->
                    <Border
                        Width="{Binding IconSize, Source={StaticResource DeviceDisplayPrefs}}"
                        Height="{Binding IconSize, Source={StaticResource DeviceDisplayPrefs}}"
                        Visibility="{Binding ShowIcons, Source={StaticResource DeviceDisplayPrefs}, Converter={StaticResource BoolToVisibilityConverter}}"
                        CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                        Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                        BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Top">
                        <FontIcon
                            Glyph="{Binding Platform, Converter={StaticResource PlatformGlyphConverter}}"
                            FontSize="20"
                            Foreground="{Binding PublicKeyFingerprint, Converter={StaticResource PeerStatusBrushConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <!-- Info column -->
                    <StackPanel Grid.Column="1" Spacing="6">
                        <!-- Name row: name + trust badge + status dot -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding DisplayName}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            <!-- Identity badge (EB95 = Shield) — HONEST: a discovered DNS-SD
                                 peer only advertises a public-key FINGERPRINT; it is NOT a
                                 verified/paired "trusted" device on Windows (there is no
                                 persisted trust store, and the candidate's TrustSummary
                                 explicitly says "fingerprint only; pairing must provide the
                                 peer public key"). So the badge is gated on the real signal —
                                 PublicKeyFingerprint presence — and reads "Fingerprint" in a
                                 neutral accent, never a fabricated green "Trusted" claim. -->
                            <Border
                                Style="{StaticResource Badge}"
                                VerticalAlignment="Center"
                                Visibility="{Binding PublicKeyFingerprint, Converter={StaticResource StringPresenceVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xEB95;" FontSize="11" Foreground="{StaticResource SkyBridgeAccentSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Fingerprint" FontSize="11" Foreground="{StaticResource SkyBridgeAccentSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Ellipse
                                Style="{StaticResource StatusDot}"
                                Fill="{Binding PublicKeyFingerprint, Converter={StaticResource PeerStatusBrushConverter}}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Platform / ServiceKind secondary line -->
                        <TextBlock FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}">
                            <Run Text="{Binding Platform}" />
                            <Run Text=" &#x2022; " />
                            <Run Text="{Binding ServiceKind}" />
                        </TextBlock>
                        <!-- Connection-type chip: transport icon + ServiceKind label -->
                        <Border
                            Style="{StaticResource ConnectionTypeChip}"
                            BorderBrush="{Binding ServiceKind, Converter={StaticResource ServiceKindBrushConverter}}"
                            HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon
                                    Glyph="{Binding ServiceKind, Converter={StaticResource ServiceKindGlyphConverter}}"
                                    FontSize="11"
                                    Foreground="{Binding ServiceKind, Converter={StaticResource ServiceKindBrushConverter}}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{Binding ServiceKind}"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{Binding ServiceKind, Converter={StaticResource ServiceKindBrushConverter}}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- Device-detail block (DeviceId / Capabilities / Fingerprint /
                             TrustSummary) — the whole block's Visibility binds to
                             DeviceDisplayPrefs.ShowDetails (通用 > 界面 > 显示设备详情); each row keeps
                             its own presence gate so a blank field still drops out when shown. -->
                        <StackPanel
                            Spacing="6"
                            Visibility="{Binding ShowDetails, Source={StaticResource DeviceDisplayPrefs}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- DeviceId -->
                            <TextBlock
                                Text="{Binding DeviceId}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                            <!-- Capabilities (only when present) -->
                            <TextBlock
                                Text="{Binding CapabilitiesSummary}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}"
                                Visibility="{Binding CapabilitiesSummary, Converter={StaticResource StringPresenceVisibilityConverter}}" />
                            <!-- Fingerprint (only when present) -->
                            <TextBlock
                                Text="{Binding PublicKeyFingerprint}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}"
                                Visibility="{Binding PublicKeyFingerprint, Converter={StaticResource StringPresenceVisibilityConverter}}" />
                            <!-- Trust summary (only when present) -->
                            <TextBlock
                                Text="{Binding TrustSummary}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}"
                                Visibility="{Binding TrustSummary, Converter={StaticResource StringPresenceVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Trailing chevron affordance (Mac TrustedDeviceCard chevron).
                         E76C = ChevronRight. Decorative; no command. -->
                    <FontIcon
                        Grid.Column="2"
                        Glyph="&#xE76C;"
                        FontSize="12"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <!-- ===================================================================
             UsbDeviceItemTemplate — element-matches the Mac DeviceCard
             (USBDeviceManagementView.swift): a glass card with a 40px rounded
             device-type icon tile (type-tinted glyph via UsbDeviceTypeGlyph/
             BrushConverter), a name + type-description header with an MFi badge
             (shown only when IsMfiCertified), then the Mac "deviceInfoRow" detail
             block — Device ID / Vendor ID / Product ID / Serial Number /
             Connection Interface, each a fixed-width label over a MONOSPACED value
             (Mac .fontDesign(.monospaced)), and a final capabilities line. Each
             optional row is presence-gated (StringPresenceVisibilityConverter) so
             blank fields drop out instead of showing empty colons. Bound to the
             REAL UsbDeviceItemView projected from UsbManagementWorkspaceClient
             (live WinRT Windows.Devices.Usb / DeviceInformation enumeration);
             carries NO inline button (gated button count unaffected).
             Human-label parity: the Mac ships these row labels untranslated so
             they render as literal keys ("usb.device.id:") — a Mac localization
             gap; Windows shows the proper human labels per the spec.
             =================================================================== -->
        <DataTemplate x:Key="UsbDeviceItemTemplate">
            <Border Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,8">
                <StackPanel Spacing="12">
                    <!-- Header: type-tinted icon tile + name/type + MFi badge -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="40"
                            Height="40"
                            CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                            Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                            BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                            <FontIcon
                                Glyph="{Binding DeviceTypeKey, Converter={StaticResource UsbDeviceTypeGlyphConverter}}"
                                FontSize="18"
                                Foreground="{Binding DeviceTypeKey, Converter={StaticResource UsbDeviceTypeBrushConverter}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding Name}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1"
                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            <TextBlock
                                Text="{Binding DeviceType}"
                                FontSize="13"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                        </StackPanel>
                        <!-- MFi badge (Mac DeviceCard: checkmark.seal.fill + "MFi Certified",
                             shown only when device.isMFiCertified). EC61 = CompletedSolid
                             (sealed checkmark). -->
                        <Border
                            Grid.Column="2"
                            Style="{StaticResource BadgeSuccess}"
                            VerticalAlignment="Top"
                            Visibility="{Binding IsMfiCertified, Converter={StaticResource BoolVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEC61;" FontSize="11" Foreground="{StaticResource SkyBridgeSuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="MFi Certified" FontSize="11" Foreground="{StaticResource SkyBridgeSuccessBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- Detail block (Mac deviceInfoRow rhythm): fixed-width label +
                         monospaced value. Each row drops out when its value is blank. -->
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Device ID" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding DeviceId}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="8" Visibility="{Binding VendorId, Converter={StaticResource StringPresenceVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Vendor ID" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding VendorId}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="8" Visibility="{Binding ProductId, Converter={StaticResource StringPresenceVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Product ID" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ProductId}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="8" Visibility="{Binding SerialNumber, Converter={StaticResource StringPresenceVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Serial Number" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding SerialNumber}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="8" Visibility="{Binding ConnectionInterface, Converter={StaticResource StringPresenceVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Connection Interface" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ConnectionInterface}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        </Grid>
                        <!-- Capabilities (Mac "usb.device.capabilities" chip section, rendered
                             here as a labeled wrapped line); only when present. -->
                        <Grid ColumnSpacing="8" Visibility="{Binding Capabilities, Converter={StaticResource StringPresenceVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Capabilities" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Capabilities}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- ===================================================================
             FileTransferQueueItemTemplate — the active/queued transfer ROW for
             the File Transfer page Transfer Queue list. Element-matches the Mac
             ModernTransferRowView:
               [ direction icon (up=outgoing blue / down=incoming green, derived
                 honestly from State via FileTransferDirectionGlyph/BrushConverter) ]
               + [ file-type tile holding a status glyph (queued clock / sync /
                   completed check / error, tinted by State) ]
               + [ Name (.subheadline medium) over Size (.caption secondary) ]
               + [ Spacer ]
               + [ right column: State value (tinted) over Binding (channel kind,
                   muted caption) ]
             Bound to the REAL FileTransferQueue collection (FileTransferQueueItemView
             Name/State/Size/Binding/Detail) projected from the read-only workspace
             snapshot. There is NO numeric progress field in the Windows snapshot, so
             the row shows the honest State text (Queued / Intent ready / …) instead
             of a fabricated progress bar — matching the Mac status semantics without
             faking a percentage. Detail rides as the row tooltip. No inline Button —
             the row is display-only; transfer actions live on the shared action surface.
             =================================================================== -->
        <DataTemplate x:Key="FileTransferQueueItemTemplate">
            <Grid Padding="2,8" ColumnSpacing="12" ToolTipService.ToolTip="{Binding Detail}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Direction icon (Mac arrow.up/down.circle.fill: outgoing blue / incoming green) -->
                <FontIcon
                    Grid.Column="0"
                    Glyph="{Binding State, Converter={StaticResource FileTransferDirectionGlyphConverter}}"
                    FontSize="18"
                    Foreground="{Binding State, Converter={StaticResource FileTransferDirectionBrushConverter}}"
                    VerticalAlignment="Center" />
                <!-- File-type tile holding the State status glyph (Mac 40x40 icon tile) -->
                <Border
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    CornerRadius="8"
                    Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                    BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                    <FontIcon
                        Glyph="{Binding State, Converter={StaticResource FileTransferStateGlyphConverter}}"
                        FontSize="16"
                        Foreground="{Binding State, Converter={StaticResource FileTransferStateBrushConverter}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <!-- Name + size -->
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <TextBlock Text="{Binding Size}" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                </StackPanel>
                <!-- State (tinted) over Binding channel kind (muted) -->
                <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="120">
                    <TextBlock
                        Text="{Binding State}"
                        FontWeight="Medium"
                        TextAlignment="Right"
                        Foreground="{Binding State, Converter={StaticResource FileTransferStateBrushConverter}}" />
                    <TextBlock
                        Text="{Binding Binding}"
                        FontSize="11"
                        TextAlignment="Right"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- ===================================================================
             FileTransferHistoryItemTemplate — the completed-transfer ROW for the
             File Transfer page Transfer History list. Element-matches the Mac
             EnhancedHistoryRowView:
               [ Result status icon (completed check / error, tinted by Result) ]
               + [ Name (.subheadline medium) over a meta line: Hmac • Signature
                   (both .caption2 secondary) ]
               + [ Spacer ]
               + [ verification shield pill (Mac scan-result capsule): a shield glyph
                   tinted green when Verified / red when failed + the Result text ]
             Bound to the REAL FileTransferHistory collection (FileTransferHistoryItemView
             Name/Result/Hmac/Signature). Carded per-row (GlassCard) to match the Mac
             EnhancedHistoryRowView's own ultraThinMaterial card. No inline Button.
             =================================================================== -->
        <DataTemplate x:Key="FileTransferHistoryItemTemplate">
            <Border Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,0,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Result status icon (Mac checkmark/xmark.circle.fill) -->
                    <FontIcon
                        Grid.Column="0"
                        Glyph="{Binding Result, Converter={StaticResource FileTransferStateGlyphConverter}}"
                        FontSize="20"
                        Foreground="{Binding Result, Converter={StaticResource FileTransferStateBrushConverter}}"
                        VerticalAlignment="Center" />
                    <!-- Name + HMAC/Signature meta line -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}">
                            <Run Text="{Binding Hmac}" />
                            <Run Text=" &#x2022; " />
                            <Run Text="{Binding Signature}" />
                        </TextBlock>
                    </StackPanel>
                    <!-- Verification shield pill (Mac scan-result capsule) -->
                    <Border
                        Grid.Column="2"
                        Style="{StaticResource ConnectionTypeChip}"
                        BorderBrush="{Binding Result, Converter={StaticResource FileTransferStateBrushConverter}}"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon
                                Glyph="{Binding Result, Converter={StaticResource FileTransferResultShieldGlyphConverter}}"
                                FontSize="12"
                                Foreground="{Binding Result, Converter={StaticResource FileTransferStateBrushConverter}}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{Binding Result}"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{Binding Result, Converter={StaticResource FileTransferStateBrushConverter}}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="RemoteDesktopSessionItemTemplate">
            <Grid Padding="0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding State}" />
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding Transport}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Quality}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceStateRowTemplate">
            <Grid Padding="0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding State}" TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="2"
                    Text="{Binding Detail}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SettingsDetailRowTemplate">
            <Grid Padding="0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Section}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" />
                <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="3"
                    Text="{Binding Detail}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SettingsActionRowTemplate">
            <Grid Padding="0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" />
                <TextBlock Grid.Column="2" Text="{Binding State}" />
                <TextBlock
                    Grid.Column="3"
                    Text="{Binding Detail}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <!-- ===================================================================
             SettingsTabItemTemplate — the LEFT sub-nav row for the Settings
             two-pane layout. Element-matches the Mac SettingsView sidebar row: a
             per-tab accent icon chip + the tab Title (SemiBold) over the localized
             EN+ZH section summary (Detail, 12px secondary). Selection (the filled
             pill) is owned by the native ListView container — exactly one tab
             highlights at a time — so this template carries content ONLY, no
             selection visuals and no push-button (keeps the gated button count at 7).
             Bound to SettingsTabItemView (Title / Detail / Glyph).
             =================================================================== -->
        <DataTemplate x:Key="SettingsTabItemTemplate">
            <Grid MinHeight="48" ColumnSpacing="12" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Style="{StaticResource AccentIconChip}"
                    VerticalAlignment="Center">
                    <FontIcon
                        Glyph="{Binding Glyph}"
                        FontSize="16"
                        Foreground="{StaticResource SkyBridgeNavSettingsBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding Title}"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <TextBlock
                        Text="{Binding Detail}"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        FontSize="11"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- ===================================================================
             SettingsControlRowTemplate — one control row inside a section card.
             Element-matches a Mac SettingsView row: ControlName label on the left,
             then ONE of three control affordances on the right keyed off the row's
             honest, backend-derived ControlKind (SettingsControlKindVisibilityConverter):
               • Toggle   — a ToggleSwitch (IsOn from the On/Off value). ALWAYS
                            IsEnabled="False": the snapshot is display-only and no
                            set-command exists, so the switch shows the value but is
                            non-interactive — honest, never implying Windows toggles it.
               • Dropdown — a display-only ComboBox populated with the parsed Mac
                            option set (DropdownOptions), current value selected. Also
                            IsEnabled="False" (no persistence behind it).
               • Value    — right-aligned status text, tinted by the value's honesty
                            vocabulary (SettingsValueStateBrushConverter): cyan for
                            Core-owned/Read-only, muted for macOS-only/OS-managed,
                            amber for Gated/Disabled/Not-wired, primary otherwise.
             The Detail string rides as the row tooltip (the Windows truth: Display-only
             / Not persisted / Core-owned / macOS-only …). NO inline push-button — none of
             ToggleSwitch / ComboBox / FontIcon match the gated push-button pattern.
             Bound to SettingsDetailItemView (ControlName / ControlKind / IsOn /
             DropdownOptions / DropdownSelection / Value / Detail).
             =================================================================== -->
        <DataTemplate x:Key="SettingsControlRowTemplate">
            <Grid Padding="0,6" ColumnSpacing="12" ToolTipService.ToolTip="{Binding Detail}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding ControlName}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                <!-- Toggle affordance (display-only: OneWay to the get-only IsOn, disabled) -->
                <ToggleSwitch
                    Grid.Column="1"
                    IsOn="{Binding IsOn, Mode=OneWay}"
                    IsEnabled="{Binding IsSettable}"
                    MinWidth="0"
                    OnContent=""
                    OffContent=""
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="{Binding ControlKind, Converter={StaticResource SettingsControlKindVisibilityConverter}, ConverterParameter=Toggle}" />
                <!-- Dropdown affordance (display-only: OneWay selection, disabled) -->
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding DropdownOptions}"
                    SelectedItem="{Binding DropdownSelection, Mode=OneWay}"
                    IsEnabled="{Binding IsSettable}"
                    MinWidth="160"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="{Binding ControlKind, Converter={StaticResource SettingsControlKindVisibilityConverter}, ConverterParameter=Dropdown}" />
                <!-- Value affordance (right-aligned status text) -->
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Value}"
                    TextWrapping="Wrap"
                    MaxWidth="240"
                    TextAlignment="Right"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Foreground="{Binding Value, Converter={StaticResource SettingsValueStateBrushConverter}}"
                    Visibility="{Binding ControlKind, Converter={StaticResource SettingsControlKindVisibilityConverter}, ConverterParameter=Value}" />
            </Grid>
        </DataTemplate>
        <!-- ===================================================================
             SettingsCardGroupTemplate — one section CARD in the right pane.
             Element-matches the Mac SettingsView section: a gray section title
             (CardName) over a glass card (GlassCard) holding that card's control
             rows. The rows are an inner ItemsControl over the group's Rows, each
             rendered by SettingsControlRowTemplate. Bound to SettingsCardGroupView
             (CardName / Rows). No Button.
             =================================================================== -->
        <DataTemplate x:Key="SettingsCardGroupTemplate">
            <StackPanel Spacing="8" Margin="0,0,0,14">
                <TextBlock
                    Text="{Binding CardName}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                <Border Style="{StaticResource GlassCard}">
                    <ItemsControl
                        ItemsSource="{Binding Rows}"
                        ItemTemplate="{StaticResource SettingsControlRowTemplate}" />
                </Border>
            </StackPanel>
        </DataTemplate>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================================================================
             Sidebar shell — WinUI 3 NavigationView (the Windows-standard nav).
             The native control owns the nav list, single-selection, the
             selection indicator/pill, keyboard navigation and accessibility,
             so exactly one item highlights at a time (replaces the custom
             ListView + NavItemContainer pill, which painted every item's pill).

               • MenuItemsSource = NavigationItems   (was ItemsSource)
               • MenuItemTemplate = NavigationItemTemplate  (was ItemTemplate)
               • SelectedItem    = SelectedFeature (TwoWay)  — unchanged binding
               • PaneHeader      = 44x44 brand block + name + ConnectionStatus
               • PaneFooter      = account block (no sidebar session actions, Mac parity)
               • On-brand selected/hover surfaces come from the documented
                 NavigationView theme-resource overrides in App.xaml.
             =================================================================== -->
        <NavigationView
            Grid.Column="0"
            Grid.ColumnSpan="2"
            x:Name="SidebarNavigation"
            AutomationProperties.AutomationId="Skybridge.Navigation.List"
            PaneDisplayMode="Left"
            OpenPaneLength="280"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            MenuItemsSource="{Binding NavigationItems}"
            MenuItemTemplate="{StaticResource NavigationItemTemplate}"
            SelectedItem="{Binding SelectedFeature, Mode=TwoWay}"
            BorderBrush="{StaticResource SkyBridgePanelStrokeBrush}"
            BorderThickness="0,0,1,0">

            <!-- ===========================================================
                 Profile card (element-matches the Mac sidebar header):
                 48x48 rounded app-icon square + app name "SkyBridge Compass"
                 (bold ~17) + bilingual tagline (gray ~12), then a thin divider.
                 The Mac header also shows a device line ("Lza's MacBook Pro ·
                 Apple M1 Max"); there is no bindable local-device-name on the
                 Windows ViewModel and the constraints forbid fabricating one, so
                 the device line is intentionally OMITTED rather than faked (see
                 the account block below for the live session state). This is a
                 Border/Grid block built without any Button element, so the gated
                 button count is unaffected. -->
            <NavigationView.PaneHeader>
                <StackPanel Padding="16,20,16,8" Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="48"
                            Height="48"
                            CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                            Background="{StaticResource SkyBridgeAccentBrush}"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE80F;" FontSize="24" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Skybridge Compass" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="17" FontWeight="Bold" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            <TextBlock Text="下一代跨平台连接体验" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            <TextBlock Text="Next-gen cross-platform connectivity" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource SkyBridgePanelStrokeBrush}" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <!-- ===========================================================
                 Bottom-pinned account block.

                 The Mac sidebar footer is an ACCOUNT block (avatar + username +
                 ID + gear) on a slightly darker footer, and — like the Mac — it
                 carries NO sidebar Connect / Disconnect actions. The sole connect
                 affordance lives in the always-visible "Session Controls" panel
                 (Connect / Heartbeat / Disconnect), so no user is stranded. The
                 account block is glass chrome: a circular avatar + a session label
                 + the live ConnectionStatus (honest session state, the only
                 identity-like value the VM exposes) + a chevron + a gear glyph. It
                 is built entirely from Border / Grid / Ellipse / FontIcon /
                 TextBlock with no Button element. -->
            <NavigationView.PaneFooter>
                <StackPanel Padding="16,8,16,16" Spacing="12">
                    <Border Height="1" Background="{StaticResource SkyBridgePanelStrokeBrush}" />
                    <!-- Account block (Mac account footer): REAL signed-in user. The avatar
                         + DisplayName + NebulaId bind to the live Supabase identity the
                         AccountSessionCoordinator resolves; the whole Border is Tapped to
                         open the in-window AuthOverlay (signed out) or the UserProfileOverlay
                         (signed in) — the crashing ContentDialog is gone. Still pure Border /
                         Grid / Ellipse / FontIcon / TextBlock chrome — the Tapped handler is
                         the trigger, so no Button element is added. -->
                    <Border
                        x:Name="AccountBlock"
                        Tapped="OnAccountBlockTapped"
                        Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                        BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                        Padding="12,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Circular avatar (~36px): the accent-glyph fallback (person
                                 glyph) sits underneath; the real avatar Ellipse paints on top
                                 only when AvatarUrl resolves to a valid http(s) image (the
                                 converter returns null otherwise, so the Ellipse's ImageBrush
                                 has no source and the glyph shows through). -->
                            <Grid Width="36" Height="36" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource SkyBridgeAccentBrush}">
                                    <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Ellipse Width="36" Height="36">
                                    <Ellipse.Fill>
                                        <ImageBrush
                                            Stretch="UniformToFill"
                                            ImageSource="{Binding AvatarUrl, Converter={StaticResource AvatarUrlImageSourceConverter}}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <!-- DisplayName ("Sign in" when signed out) over the NEBULA id -->
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                                <TextBlock Text="{Binding NebulaId}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                            </StackPanel>
                            <!-- Chevron affordance (decorative) -->
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{StaticResource SkyBridgeTextMutedBrush}" VerticalAlignment="Center" />
                            <!-- Settings gear glyph (decorative; the Settings nav item owns the page) -->
                            <FontIcon Grid.Column="3" Glyph="&#xE713;" FontSize="16" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </NavigationView.PaneFooter>

        <!-- NavigationView Content = top bar + the 7 feature workspace panels;
             they switch via the IsXxxSelected Visibility bindings as the
             SelectedFeature changes. Content is unchanged from the prior shell. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="24,8"
                Background="{StaticResource SkyBridgeTopBarFillBrush}"
                BorderBrush="{StaticResource SkyBridgePanelStrokeBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            AutomationProperties.AutomationId="Skybridge.SelectedFeature.Title"
                            Text="{Binding SelectedFeature.Title}"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            AutomationProperties.AutomationId="Skybridge.Status.Message"
                            Text="{Binding StatusMessage}"
                            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- ===========================================================
                         Top bar status cluster — Mac TopNavigationBarView parity.

                         The Mac top bar is a row of rich glass CAPSULE pills (IP/
                         location, net speed, latency, connection, FPS) then a bell +
                         paintbrush action cluster. We port that density here with the
                         TopBarGlassPill capsule style + small colored Segoe Fluent
                         icons matching the Mac iconColor (speed cyan, latency mint,
                         connection green/amber/red dot, FPS orange). Pills are
                         Border-based display chrome (no Button element), so the
                         gated MainWindow button count is unchanged; the only interactive
                         affordances stay the bell + theme buttons inside the existing
                         TopBarActions ItemsControl.

                         HONESTY (the user rejects fabricated telemetry):
                          • IP / location + proxy pill — OMITTED. The Windows session/
                            top-bar layer has NO egress-region / system-proxy / public-IP
                            concept, and there is no bindable local-host name on the VM
                            (the sidebar header omits the device line for the same
                            reason). Rather than invent a city/host, the pill is dropped.
                          • Net speed + Latency pills — rendered as MUTED "—" placeholders
                            (no bytes/sec counters and no RTT/ping probe exist on Windows
                            yet; see "wire later" note). Muted text + a tooltip that says
                            it's pending, so it never reads as a real measured value.
                          • Connection pill — REAL: live ConnectionStatus text + a dot
                            colored off the real EngineConnectionState (green/amber/red).
                          • FPS / Diagnostics pill — the real coarse busy/nominal health
                            label (TopBarDiagnosticsStatus); NOT a fabricated frame rate.
                          • Bell + theme — the existing TopBarActions (in-memory bell
                            toggle + theme), no fake numeric badge.

                         Order note: the structural parity gate (verify-windows-ui-parity)
                         asserts ConnectionStatus → DiagnosticsStatus(FPS) → TopBarActions
                         appear in that order. The added network pills sit BEFORE the
                         connection pill (matching the Mac left→right: network pills,
                         then connection, then FPS, then actions), preserving the gate. -->
                    <!-- Overflow safety: the compacted + MaxWidth-capped pills are the
                         primary fit fix; this ScrollViewer is the belt-and-suspenders so a
                         very narrow window degrades by scrolling/clipping the row toward the
                         LEFT (keeping the rightmost connection/FPS/bell/theme actions
                         reachable) instead of the pills disappearing past the right edge.
                         Horizontal bar hidden (pills still scrollable via trackpad/wheel),
                         vertical disabled. Right-aligned so the cluster hugs the right like
                         the Mac. -->
                    <ScrollViewer
                        Grid.Column="1"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Net speed (Mac pill 2): ↓↑ arrows, cyan. REAL now — bound to
                             TopBarNetworkSpeed, fed by the TopBarNetworkCoordinator (cumulative
                             interface byte counters → delta ÷ elapsed = bytes/sec, base-1000
                             formatted "↓ 24.0 KB/s · ↑ 6.1 KB/s"). Shows the honest
                             "↓ — · ↑ —" placeholder until the first sample lands. -->
                        <Border
                            Style="{StaticResource TopBarGlassPill}"
                            MaxWidth="170"
                            Visibility="{Binding ShowTopBarSpeedPill, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.AutomationId="Skybridge.TopBar.NetworkSpeed"
                            ToolTipService.ToolTip="Network throughput (down / up), sampled every ~2s">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xEC4A;" FontSize="13" Foreground="{StaticResource SkyBridgeAccentSecondaryBrush}" />
                                <TextBlock Text="{Binding TopBarNetworkSpeed}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <!-- Latency (Mac pill 3): stopwatch, mint. REAL now — bound to
                             TopBarNetworkLatency, measured by a HEAD probe to the fast endpoint
                             (Stopwatch elapsed ms, refreshed every ~15s). Shows the honest
                             "— ms" placeholder on probe failure. -->
                        <Border
                            Style="{StaticResource TopBarGlassPill}"
                            Visibility="{Binding ShowTopBarLatencyPill, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.AutomationId="Skybridge.TopBar.NetworkLatency"
                            ToolTipService.ToolTip="Round-trip latency to the SkyBridge endpoint, refreshed every ~15s">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE916;" FontSize="13" Foreground="{StaticResource SkyBridgeWeatherWindBrush}" />
                                <TextBlock Text="{Binding TopBarNetworkLatency}" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <!-- IP + proxy (Mac pill 1): globe icon, BLUE when direct / ORANGE when a
                             system proxy is configured (icon color driven by IsSystemProxyEnabled
                             via SystemProxyStateBrushConverter). Bound to TopBarIpLocation, fed by
                             the coordinator (ipapi.co {city,country_code} + HKCU ProxyEnable read):
                             "City · 代理" / "City · 直连", or the honest "IP · 不可用" on failure.
                             This pill was previously OMITTED; it is now wired to real data. -->
                        <Border
                            Style="{StaticResource TopBarGlassPill}"
                            MaxWidth="170"
                            Visibility="{Binding ShowTopBarIpLocationPill, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.AutomationId="Skybridge.TopBar.IpLocation"
                            ToolTipService.ToolTip="Public IP location and system-proxy state, refreshed every ~5min">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="{Binding IsSystemProxyEnabled, Converter={StaticResource SystemProxyStateBrushConverter}}" />
                                <TextBlock Text="{Binding TopBarIpLocation}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <!-- Connection status (Mac pill 4): REAL. Colored dot off the live
                             EngineConnectionState (green/amber/red) + the live status text.
                             KEEP the gated automation id + TopBarConnectionStatus binding.
                             Wider H-pad (12,6) mirrors the Mac connection pill. -->
                        <Border
                            Style="{StaticResource TopBarGlassPill}"
                            Padding="10,5"
                            AutomationProperties.AutomationId="Skybridge.TopBar.ConnectionStatus">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding ConnectionStatus, Converter={StaticResource ConnectionStatusDotBrushConverter}}" />
                                <FontIcon Glyph="&#xE9F5;" FontSize="13" Foreground="{Binding ConnectionStatus, Converter={StaticResource ConnectionStatusDotBrushConverter}}" />
                                <TextBlock Text="{Binding TopBarConnectionStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <!-- FPS / Diagnostics (Mac pill 5): speedometer, orange. This is the
                             real coarse busy/nominal HEALTH label (TopBarDiagnosticsStatus),
                             not a measured frame rate — kept honest per the audit. -->
                        <Border
                            Style="{StaticResource TopBarGlassPill}"
                            AutomationProperties.AutomationId="Skybridge.TopBar.DiagnosticsStatus"
                            ToolTipService.ToolTip="FPS / Diagnostics">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{StaticResource SkyBridgeWarningBrush}" />
                                <TextBlock Text="FPS" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                <TextBlock Text="{Binding TopBarDiagnosticsStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <!-- Bell + theme action cluster (Mac actions A/B): the existing
                             TopBarActions ItemsControl renders the in-memory notification
                             bell + the theme toggle as the only interactive buttons. No
                             fabricated unread badge. Shared resources kept verbatim for
                             the structural parity gate. -->
                        <ItemsControl
                            AutomationProperties.AutomationId="Skybridge.Actions.TopBar"
                            ItemsSource="{Binding TopBarActions}"
                            ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                            ItemTemplate="{StaticResource TopBarStatusActionButtonTemplate}" />
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1">
                <StackPanel Padding="32,24" Spacing="24">
                    <StackPanel
                        Visibility="{Binding IsDashboardSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                        Spacing="24">
                        <!-- Live overview metric cards: 4-up equal-width row (matches Mac StatCard row) -->
                        <ItemsControl
                            ItemsSource="{Binding DashboardMetrics}"
                            ItemsPanel="{StaticResource WorkspaceMetricCardItemsPanel}"
                            ItemTemplate="{StaticResource WorkspaceMetricCardTemplate}" />

                        <!-- ===================================================================
                             Weather hero card — full-width, element-matches the Mac
                             WeatherDashboardCard. GlassPanel chrome (full-width like the
                             Quick Actions panel below) with the corner radius pinned to 20
                             to match the Mac r20 hero. Three mutually-exclusive state layers
                             (Loading / Loaded / Error) keyed off WeatherPhase via the
                             WeatherPhaseVisibilityConverter, mirroring the Mac body state
                             machine. Min height 168 keeps the two-column loaded layout from
                             clipping; the loading/error layers center inside the same chrome.
                             =================================================================== -->
                        <Border Style="{StaticResource GlassPanel}" CornerRadius="20" MinHeight="168">
                            <Grid>
                                <!-- Loaded state: header + big glyph/temp + condition + metric grid + footer -->
                                <Grid Visibility="{Binding WeatherPhase, Converter={StaticResource WeatherPhaseVisibilityConverter}, ConverterParameter=Loaded}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Header row: location glyph + name (left), refresh button (right).
                                         No nav-arrow exists on the Mac card, so none is added here. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!-- E81D = Location (a map pin) ~ SF "location.fill", cyan -->
                                            <FontIcon Glyph="&#xE81D;" FontSize="15" Foreground="{StaticResource SkyBridgeAccentSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{Binding WeatherLocation}"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <!-- Refresh button: 32x32 glass circle + E72C (Refresh, a circular
                                             arrow) ~ SF "arrow.clockwise". The only nav control on the card. -->
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="Skybridge.Weather.Refresh"
                                            AutomationProperties.Name="Refresh weather"
                                            ToolTipService.ToolTip="Refresh weather"
                                            Command="{Binding RefreshWeatherCommand}"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            CornerRadius="16"
                                            Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                                            BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                                            BorderThickness="1">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                                        </Button>
                                    </Grid>

                                    <!-- Body: left = big glyph + temperature (fixed 120 wide);
                                         right = condition text + metric grid + footer. -->
                                    <Grid Grid.Row="1" Margin="0,14,0,0" ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left column: condition emoji over big temperature.
                                             Color EMOJI via Segoe UI Emoji (Segoe Fluent Icons has no
                                             weather glyphs); emoji are pre-colored so no Foreground. -->
                                        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding WeatherConditionKey, Converter={StaticResource WeatherConditionGlyphConverter}}"
                                                FontFamily="Segoe UI Emoji"
                                                FontSize="40"
                                                HorizontalAlignment="Center" />
                                            <!-- Big temperature: integer + degree sign, thin/rounded feel via light weight -->
                                            <TextBlock
                                                Text="{Binding WeatherTemperature}"
                                                FontSize="44"
                                                FontWeight="Thin"
                                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}"
                                                HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Right column -->
                                        <StackPanel Grid.Column="1" Spacing="12">
                                            <!-- Condition text (Clear/Cloudy/Rain/...) -->
                                            <TextBlock
                                                Text="{Binding WeatherCondition}"
                                                FontSize="15"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                            <!-- Hairline divider, white@0.1 like the Mac overlay -->
                                            <Border Height="1" Background="{StaticResource SkyBridgePanelStrokeBrush}" />
                                            <!-- Metric grid: humidity / wind / visibility / AQI (2 cols).
                                                 Visibility + AQI cells are emitted only when present, so the
                                                 grid shows 2/3/4 cells exactly like the Mac. -->
                                            <ItemsControl
                                                AutomationProperties.AutomationId="Skybridge.Weather.Metrics"
                                                ItemsSource="{Binding WeatherMetrics}"
                                                ItemsPanel="{StaticResource WeatherMetricItemsPanel}"
                                                ItemTemplate="{StaticResource WeatherMetricItemTemplate}" />
                                            <!-- Footer: source label ("wttr.in" / "wttr.in + AQI") + relative time -->
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <!-- E704 = Streaming/antenna waves ~ SF "antenna.radiowaves.left.and.right" -->
                                                    <FontIcon Glyph="&#xE704;" FontSize="11" Foreground="{StaticResource SkyBridgeTextMutedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock
                                                        Text="{Binding WeatherSource}"
                                                        FontSize="11"
                                                        Foreground="{StaticResource SkyBridgeTextMutedBrush}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding WeatherUpdatedRelative}"
                                                    FontSize="11"
                                                    Foreground="{StaticResource SkyBridgeTextMutedBrush}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Loading state: spinner + title + hint, centered in the same chrome -->
                                <StackPanel
                                    Spacing="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding WeatherPhase, Converter={StaticResource WeatherPhaseVisibilityConverter}, ConverterParameter=Loading}">
                                    <ProgressRing IsActive="{Binding IsWeatherLoading}" Width="32" Height="32" HorizontalAlignment="Center" />
                                    <TextBlock Text="Loading weather..." FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="First load can take a few seconds" FontSize="12" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Error state: warning glyph + title + message + Retry, centered -->
                                <StackPanel
                                    Spacing="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding WeatherPhase, Converter={StaticResource WeatherPhaseVisibilityConverter}, ConverterParameter=Error}">
                                    <!-- E7BA = Warning (triangle with !) ~ SF "exclamationmark.triangle.fill", orange -->
                                    <FontIcon Glyph="&#xE7BA;" FontSize="36" Foreground="{StaticResource SkyBridgeWarningBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Weather unavailable" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock
                                        Text="{Binding WeatherErrorMessage}"
                                        FontSize="12"
                                        Foreground="{StaticResource SkyBridgeTextMutedBrush}"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        MaxWidth="360"
                                        HorizontalAlignment="Center" />
                                    <Button
                                        AutomationProperties.AutomationId="Skybridge.Weather.Retry"
                                        AutomationProperties.Name="Retry"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding RefreshWeatherCommand}"
                                        HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <!-- E72C = Refresh ~ SF "arrow.clockwise" -->
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            <TextBlock Text="Retry" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ===================================================================
                             Dashboard 2x2 PANEL GRID — element-matches the Mac
                             DashboardContentView LazyVGrid(2 flexible cols, spacing 20).
                             Sits BELOW the full-width weather hero card. Two equal
                             columns, 18px column gap + 18px row gap, four GlassPanel
                             cells in the Mac row-major order:
                               Row 0:  Device Discovery   |  Remote Sessions
                               Row 1:  Quick Actions      |  System Performance
                             Each cell is the shared GlassPanel chrome (r22 glass card),
                             header = accent glyph + title, body = a bound row list OR an
                             honest empty state. The Quick Actions cell REUSES the existing
                             DashboardQuickActions ItemsControl (same automation id, panel
                             and template) — it is relocated here, not duplicated. Summary
                             rows are non-interactive (the feature pages own the actions),
                             so no button element is added and the gated count stays at 7.
                             =================================================================== -->
                        <Grid ColumnSpacing="18" RowSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- (1) Device Discovery summary — top-left. Bound to the LIVE
                                 DiscoveredPeers collection (Win32 DNS-SD), with an honest
                                 empty state when nothing has been discovered. -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassPanel}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- E721 = Search (magnifier) ~ SF "magnifyingglass", cyan -->
                                        <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{StaticResource SkyBridgeAccentSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Device Discovery" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <!-- Live count badge (DiscoveredPeerCount raises change
                                             notifications via WorkspaceCountNotifier). -->
                                        <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DiscoveredPeerCount}" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <!-- Populated list (Visible when count > 0) -->
                                    <ItemsControl
                                        AutomationProperties.AutomationId="Skybridge.Dashboard.DeviceDiscoverySummary"
                                        ItemsSource="{Binding DiscoveredPeers}"
                                        ItemTemplate="{StaticResource DashboardDeviceSummaryRowTemplate}"
                                        Visibility="{Binding DiscoveredPeerCount, Converter={StaticResource CountToVisibilityConverter}}" />
                                    <!-- Honest empty state (Visible when count == 0) -->
                                    <StackPanel
                                        Spacing="6"
                                        Padding="0,18"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding DiscoveredPeerCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}">
                                        <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No devices found" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Open Device Discovery to start scanning" FontSize="12" Foreground="{StaticResource SkyBridgeTextMutedBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- (2) Remote Sessions summary — top-right. Bound to
                                 RemoteDesktopSessions (preview rows per recon); honest
                                 "No active sessions" empty state when the collection is empty. -->
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassPanel}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- E7F4 = TVMonitor (a display) ~ SF "display.2", indigo -->
                                        <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{StaticResource SkyBridgeNavRemoteDesktopBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Remote Sessions" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RemoteDesktopSessionCount}" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <ItemsControl
                                        AutomationProperties.AutomationId="Skybridge.Dashboard.RemoteSessionsSummary"
                                        ItemsSource="{Binding RemoteDesktopSessions}"
                                        ItemTemplate="{StaticResource DashboardSessionSummaryRowTemplate}"
                                        Visibility="{Binding RemoteDesktopSessionCount, Converter={StaticResource CountToVisibilityConverter}}" />
                                    <StackPanel
                                        Spacing="6"
                                        Padding="0,18"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding RemoteDesktopSessionCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="28" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No active sessions" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Connect from Remote Desktop to start a session" FontSize="12" Foreground="{StaticResource SkyBridgeTextMutedBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- (3) Quick Actions — bottom-left. RELOCATED existing panel
                                 (same automation id / panel / template, now in the grid). -->
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassPanel}">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE80A;" FontSize="16" Foreground="{StaticResource SkyBridgeAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Quick Actions" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                                    </StackPanel>
                                    <ItemsControl
                                        AutomationProperties.AutomationId="Skybridge.Actions.DashboardQuickActions"
                                        ItemsSource="{Binding DashboardQuickActions}"
                                        ItemsPanel="{StaticResource DashboardQuickActionItemsPanel}"
                                        ItemTemplate="{StaticResource DashboardQuickActionTemplate}" />
                                </StackPanel>
                            </Border>

                            <!-- (4) System Performance summary — bottom-right. Bound to the
                                 REAL in-process SystemMonitorOverview sampler (Memory/Disk/
                                 Network live, CPU honestly labeled); honest placeholder when
                                 the sampler has not produced rows yet. -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassPanel}">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- E9D9 = Speed (gauge) ~ SF "cpu.fill"/"speedometer", orange -->
                                        <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{StaticResource SkyBridgeNavMonitorBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="System Performance" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                                    </StackPanel>
                                    <ItemsControl
                                        AutomationProperties.AutomationId="Skybridge.Dashboard.SystemPerformanceSummary"
                                        ItemsSource="{Binding SystemMonitorOverview}"
                                        ItemTemplate="{StaticResource DashboardSystemMetricRowTemplate}"
                                        Visibility="{Binding SystemMonitorMetricCount, Converter={StaticResource CountToVisibilityConverter}}" />
                                    <StackPanel
                                        Spacing="6"
                                        Padding="0,18"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding SystemMonitorMetricCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No metrics yet" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Open System Monitor to sample performance" FontSize="12" Foreground="{StaticResource SkyBridgeTextMutedBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsDeviceDiscoverySelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Device Discovery" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DiscoveryStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <!-- Live discovered-peer count badge (Mac "discovery.onlineDevices(n)").
                                     Bound to DiscoveredPeerCount (change-notified via
                                     WorkspaceCountNotifier). -->
                                <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE772;" FontSize="12" Foreground="{StaticResource SkyBridgeAccentSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DiscoveredPeerCount}" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl
                                    Grid.Column="2"
                                    ItemsSource="{Binding DeviceDiscoveryPrimaryActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- ===================================================================
                                 Connection-mode segmented header — element-matches the Mac
                                 EnhancedDeviceDiscoveryView connectionModePicker (4 equal-width
                                 tabs: Local Scan / QR Code / Cloud Link / Connection Code, each a
                                 VStack of accent icon over title over subtitle). This is a
                                 NON-INTERACTIVE orientation header (the Windows page already shows
                                 ALL four connection surfaces stacked below — there is no mode swap
                                 to drive), so it is built from Borders + FontIcons + TextBlocks and
                                 contains NO inline button element, keeping the gated button count at 7.
                                 The first tab (Local Scan) carries the selected styling (accent
                                 fill + 3px bottom indicator) because the page leads with the local
                                 scan surface, mirroring the Mac default selection.
                                 =================================================================== -->
                            <Border
                                AutomationProperties.AutomationId="Skybridge.DeviceDiscovery.ConnectionModeHeader"
                                Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                                BorderBrush="{StaticResource SkyBridgePanelStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Tab 1: Local Scan (green) — selected -->
                                    <Grid Grid.Column="0">
                                        <Border Background="{StaticResource SkyBridgeSelectedNavFillBrush}" CornerRadius="12,0,0,0" Opacity="0.18" />
                                        <StackPanel Spacing="4" Padding="8,12" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE701;" FontSize="20" Foreground="{StaticResource SkyBridgeSuccessBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Local Scan" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeSuccessBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Same network" FontSize="11" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <Border Height="3" Background="{StaticResource SkyBridgeSuccessBrush}" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <!-- Tab 2: QR Code (blue) -->
                                    <StackPanel Grid.Column="1" Spacing="4" Padding="8,12" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xED14;" FontSize="20" Foreground="{StaticResource SkyBridgeNavDashboardBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="QR Code" FontSize="12" Foreground="{StaticResource SkyBridgeNavDashboardBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Scan to pair" FontSize="11" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <!-- Tab 3: Cloud Link (purple) -->
                                    <StackPanel Grid.Column="2" Spacing="4" Padding="8,12" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE753;" FontSize="20" Foreground="{StaticResource SkyBridgeNavQuantumBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Cloud Link" FontSize="12" Foreground="{StaticResource SkyBridgeNavQuantumBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Across networks" FontSize="11" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <!-- Tab 4: Connection Code (orange) -->
                                    <StackPanel Grid.Column="3" Spacing="4" Padding="8,12" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE943;" FontSize="20" Foreground="{StaticResource SkyBridgeWarningBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Connection Code" FontSize="12" Foreground="{StaticResource SkyBridgeWarningBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock Text="6-digit code" FontSize="11" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ===================================================================
                                 Local Scan info banner — element-matches the Mac localScan
                                 InfoBanner (green wifi.router icon + title + description, glass
                                 card r12, 1px stroke). Orientation card for the local-scan surface.
                                 =================================================================== -->
                            <Border
                                Background="{StaticResource SkyBridgeCardFillBrush}"
                                BorderBrush="{StaticResource SkyBridgeCardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE701;" FontSize="26" Foreground="{StaticResource SkyBridgeSuccessBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Local network discovery" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                                        <TextBlock Text="Devices advertising over DNS-SD on this network appear below." FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Content="Compatibility Mode"
                                    IsChecked="{Binding IsDiscoveryCompatibilityModeEnabled, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <ItemsControl
                                        ItemsSource="{Binding DeviceDiscoveryScanActions}"
                                        ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                        ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                                    <TextBlock Text="{Binding ExtendedSearchCountdown}" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- ===================================================================
                                     Labeled scan-toolbar legend — gives the icon-only scan buttons the
                                     Mac's clear LABELED row (Mac scanToolbar: 扩展搜索 15s / 手动连接 /
                                     停止扫描·开始扫描 / refresh, all carry visible text). The buttons
                                     themselves are gate-locked to the compact icon-only
                                     WorkspaceActionButtonTemplate (Scripts/verify-windows-ui-parity.ps1
                                     pins DeviceDiscoveryScanActions to that shared template + the
                                     HorizontalWorkspaceActionItemsPanel), and the template is shared by
                                     ~19 other action surfaces that intentionally stay compact — so the
                                     labels are surfaced here as a NON-INTERACTIVE legend (FontIcon +
                                     TextBlock pairs, ZERO button elements) directly beneath the icons,
                                     in the exact left-to-right order of DeviceDiscoveryScanActions
                                     (Extended Search / Manual Connect / Start Scan / Stop Scan /
                                     Refresh). Each glyph matches its button's glyph so the mapping is
                                     unambiguous. Adds no button element; the gated button count is unchanged. -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="14"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE7B3;" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Extended Search" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Manual Connect" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource SkyBridgeSuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Start Scan" FontSize="12" Foreground="{StaticResource SkyBridgeSuccessBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Stop Scan" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Refresh" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBox
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding DiscoverySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Search devices"
                                    HorizontalAlignment="Stretch" />
                            </Grid>

                            <TextBlock Text="{Binding DiscoveryBrowserStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl
                                ItemsSource="{Binding DiscoveryBrowserFacts}"
                                ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Manual Host / IP" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding ManualConnectionHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="IP Address" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Port" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding ManualConnectionPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="11550" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Code" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding ManualConnectionCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Optional code" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding ManualConnectionStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl
                                ItemsSource="{Binding ManualConnectionFacts}"
                                ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />

                            <ItemsControl
                                AutomationProperties.AutomationId="Skybridge.Actions.DeviceDiscoveryManualConnectFinal"
                                ItemsSource="{Binding DeviceDiscoveryManualConnectFinalActions}"
                                ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                ItemTemplate="{StaticResource WorkspaceActionButtonWithDetailTemplate}" />

                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Dynamic Encrypted QR Code" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl
                                            ItemsSource="{Binding CrossNetworkQrActions}"
                                            ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                            ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Text="{Binding CrossNetworkQrInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="skybridge://connect/&lt;base64url-json&gt;"
                                            HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <Border
                                        AutomationProperties.AutomationId="CrossNetworkGeneratedQrCodePreview"
                                        Width="168"
                                        Height="168"
                                        Padding="10"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding IsCrossNetworkGeneratedQrCodeVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Image
                                            AutomationProperties.AutomationId="CrossNetworkGeneratedQrCodeImage"
                                            Source="{Binding CrossNetworkGeneratedQrCodeImage}"
                                            Stretch="Uniform" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <TextBlock Text="Smart Connection Code" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl
                                            ItemsSource="{Binding CrossNetworkCodePrimaryActions}"
                                            ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                            ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Text="{Binding CrossNetworkCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="ABC234"
                                            MaxLength="6"
                                            HorizontalContentAlignment="Center" />
                                        <ItemsControl
                                            Grid.Column="2"
                                            ItemsSource="{Binding CrossNetworkCodeConnectActions}"
                                            ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                            ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                                    </Grid>
                                    <TextBlock Text="{Binding CrossNetworkGeneratedCode}" FontSize="28" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding CrossNetworkStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl
                                ItemsSource="{Binding CrossNetworkConnectionFacts}"
                                ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Service" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding DiscoveryService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsDeviceDiscoverySelected}"
                                        PlaceholderText="_skybridge._udp" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="TXT record" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding DiscoveryTxtRecord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsDeviceDiscoverySelected}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="82" />
                                </StackPanel>
                            </Grid>

                            <!-- ===================================================================
                                 我的设备 — "This device" card. Element-matches the Mac
                                 EnhancedDeviceDiscoveryView "我的设备" section: a glass card with a
                                 BLUE ring (Mac Color.blue.opacity(0.6) stroke), holding the local
                                 machine as a device card (laptop icon + name + a "This device" pill
                                 + an "Online" status). On the Mac the card is built from
                                 LocalDevicePresentation.current() (hostname, isLocalDevice=true,
                                 status=.online) and is ALWAYS shown regardless of scan results. The
                                 Windows ground truth is the real OS host name + platform (read from
                                 Environment.MachineName / Environment.OSVersion via the VM's
                                 LocalDeviceName / LocalDevicePlatform — no DI client, no network, no
                                 fabrication). Non-interactive (no connect button for the local
                                 machine, same as the Mac no-op local card); adds no button element. -->
                            <Border
                                Background="{StaticResource SkyBridgeCardFillBrush}"
                                BorderBrush="{StaticResource SkyBridgeNavDashboardBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="My Device" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Status-tinted device icon chip (laptop, blue = local machine) -->
                                        <Border
                                            Width="44"
                                            Height="44"
                                            CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                                            Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                                            BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Top">
                                            <FontIcon Glyph="&#xE977;" FontSize="20" Foreground="{StaticResource SkyBridgeNavDashboardBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <!-- Name + "This device" pill (Mac discovery.device.thisDevice) -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding LocalDeviceName}"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                                                <Border Style="{StaticResource BadgeAccent}" VerticalAlignment="Center">
                                                    <TextBlock Text="This device" FontSize="11" Foreground="{StaticResource SkyBridgeNavDashboardBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <!-- Platform secondary line -->
                                            <TextBlock
                                                Text="{Binding LocalDevicePlatform}"
                                                FontSize="12"
                                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                        </StackPanel>
                                        <!-- "Online" status capsule (Mac local card statusText = 在线) -->
                                        <Border Grid.Column="2" Style="{StaticResource BadgeSuccess}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource SkyBridgeSuccessBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="Online" FontSize="11" Foreground="{StaticResource SkyBridgeSuccessBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ===================================================================
                                 已信任设备 / 最近连接 — HONEST OMISSION note. The Mac discovery
                                 screen has dedicated "已信任设备" (trusted) and "最近连接" (recent)
                                 sections, sourced on the Mac from TrustSyncService.activeTrustRecords
                                 (a persisted PQC trust store) and a recent-connections history. The
                                 Windows client has NEITHER yet: discovered peers carry only a
                                 fingerprint (the candidate's TrustSummary literally says "fingerprint
                                 only; pairing must provide the peer public key"), there is no
                                 persisted trust store and no connection-history store in the
                                 ViewModel/Services. Rather than fabricate a trusted/recent list, this
                                 honest one-line note states why those sections are not shown — the
                                 "omit honestly" path. (When a Windows trust/recent store lands, replace
                                 this note with the real sections.) -->
                            <Border
                                Background="{StaticResource SkyBridgeCardFillBrush}"
                                BorderBrush="{StaticResource SkyBridgeCardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE946;" FontSize="20" Foreground="{StaticResource SkyBridgeTextMutedBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Trusted &amp; recent devices" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                        <TextBlock Text="Devices appear here after you pair them. This build does not yet persist a trusted-device list or connection history, so no trusted or recently-connected devices are shown." FontSize="12" Foreground="{StaticResource SkyBridgeTextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ===================================================================
                                 Discovered-devices group — element-matches the Mac localScan
                                 discovered "online devices" section: a section header ("Discovered
                                 devices" + live count) over the rich peer list, framed with a faint
                                 green tint ring (Mac "Recently / discovered" group, green@0.35).
                                 The DiscoveredPeers ListView keeps its DiscoveredPeerItemTemplate
                                 binding (template-key preserved for the parity gate); the rows are
                                 now the rich Mac OnlineDeviceCard-style cards. An honest empty state
                                 shows when no peers are present (CountToVisibilityConverter "Empty").
                                 =================================================================== -->
                            <Border
                                Background="{StaticResource SkyBridgeCardFillBrush}"
                                BorderBrush="{StaticResource SkyBridgeSuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE701;" FontSize="16" Foreground="{StaticResource SkyBridgeSuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Discovered devices" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Style="{StaticResource BadgeSuccess}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DiscoveredPeerCount}" FontSize="12" Foreground="{StaticResource SkyBridgeSuccessBrush}" />
                                        </Border>
                                    </Grid>
                                    <!-- Populated rich list (Visible when count > 0) -->
                                    <ListView
                                        ItemsSource="{Binding DiscoveredPeers}"
                                        ItemTemplate="{StaticResource DiscoveredPeerItemTemplate}"
                                        MinHeight="86"
                                        SelectionMode="None"
                                        Visibility="{Binding DiscoveredPeerCount, Converter={StaticResource CountToVisibilityConverter}}" />
                                    <!-- Honest empty state (Visible when count == 0) — Mac
                                         emptyStateView: large muted icon + title + message. -->
                                    <StackPanel
                                        Spacing="8"
                                        Padding="0,28"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding DiscoveredPeerCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}">
                                        <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No devices found" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Start a scan to discover devices advertising on this network." FontSize="12" Foreground="{StaticResource SkyBridgeTextMutedBrush}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Pairing Code" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding PairingConnectionCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsDeviceDiscoverySelected}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="96" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="{Binding PairingStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl
                                        ItemsSource="{Binding PairingFacts}"
                                        ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />
                                    <TextBlock Text="{Binding ConnectionPreflightStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl
                                        ItemsSource="{Binding ConnectionPreflightFacts}"
                                        ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsUsbManagementSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="USB Management" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UsbManagementStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding UsbManagementHeaderActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl
                                ItemsSource="{Binding UsbDeviceStats}"
                                ItemsPanel="{StaticResource WorkspaceMetricCardItemsPanel}"
                                ItemTemplate="{StaticResource WorkspaceMetricCardTemplate}" />

                            <!-- Connected-devices group — element-matches the Mac
                                 deviceListView + emptyStateView: a section header
                                 ("Connected Devices" + live UsbDeviceCount badge) over the
                                 rich DeviceCard rows, with an honest empty state shown only
                                 when nothing is connected (CountToVisibilityConverter "Empty").
                                 The ListView keeps its UsbDeviceItemTemplate binding; rows are
                                 the Mac DeviceCard-style cards. UsbDeviceCount change-notifies
                                 via WorkspaceCountNotifier so the badge + empty state update
                                 live with the real WinRT enumeration. -->
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE88E;" FontSize="16" Foreground="{StaticResource SkyBridgeAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Connected Devices" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Style="{StaticResource BadgeAccent}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UsbDeviceCount}" FontSize="12" Foreground="{StaticResource SkyBridgeAccentBrush}" />
                                    </Border>
                                </Grid>
                                <!-- Populated rich list (Visible when count > 0) -->
                                <ListView
                                    ItemsSource="{Binding UsbDevices}"
                                    ItemTemplate="{StaticResource UsbDeviceItemTemplate}"
                                    MinHeight="118"
                                    SelectionMode="None"
                                    IsEnabled="{Binding IsUsbManagementSelected}"
                                    Visibility="{Binding UsbDeviceCount, Converter={StaticResource CountToVisibilityConverter}}" />
                                <!-- Honest empty state (Visible when count == 0) — Mac
                                     emptyStateView: large muted cable.connector icon + title +
                                     guidance subtitle. E88E ~ cable.connector. -->
                                <StackPanel
                                    Spacing="8"
                                    Padding="0,28"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding UsbDeviceCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}">
                                    <FontIcon Glyph="&#xE88E;" FontSize="40" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No USB devices found" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Connect a device and refresh, or check the cable and port." FontSize="12" Foreground="{StaticResource SkyBridgeTextMutedBrush}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================================
                         FILE TRANSFER screen — element-matched to the Mac FileTransferView
                         two-pane layout (Sources/SkyBridgeUI/FileTransfer/FileTransferView.swift):
                           HEADER (title + status + header actions)
                           TWO PANES:
                             LEFT sidebar (fixed 260): Connection Status card +
                               Quick Actions card (the shared FileTransferActions surface) +
                               Recent Transfers card (last completed = FileTransferHistory).
                             RIGHT main: Drop zone card (visual-only, honest "not yet wired")
                               + QR preview (gated) + Transfer Queue section + Transfer History
                               section + File Transfer Security facts.
                         All buttons flow through the shared FileTransferHeaderActions /
                         FileTransferActions ItemsControls (no inline button elements), so the
                         gated button count is unchanged. Bound entirely to REAL workspace data:
                         FileTransferStatus, FileTransferQueue, FileTransferHistory,
                         FileTransferSecurityFacts, FileTransferShareQrCodeImage.
                         =================================================================== -->
                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsFileTransferSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="File Transfer" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FileTransferStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding FileTransferHeaderActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- TWO-PANE BODY: fixed sidebar (Mac 240) + main content -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- LEFT SIDEBAR -->
                                <StackPanel Grid.Column="0" Spacing="14">
                                    <!-- Connection Status card (Mac connectionStatusCard) -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE701;" FontSize="18" Foreground="{StaticResource SkyBridgeNavDashboardBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="Connection Status" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource SkyBridgeNavFileTransferBrush}" />
                                                <TextBlock
                                                    Text="{Binding FileTransferStatus}"
                                                    FontSize="13"
                                                    TextWrapping="Wrap"
                                                    Foreground="{StaticResource SkyBridgeTextSecondaryBrush}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick Actions card (Mac quickActionsCard) — shared action surface -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Quick Actions" FontWeight="SemiBold" />
                                            <ItemsControl
                                                ItemsSource="{Binding FileTransferActions}"
                                                ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                                ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                                            <TextBlock
                                                Text="Select files / folder or generate a share QR. Selection prepares an in-memory intent only — no picker is opened and no files are read."
                                                FontSize="11"
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Recent Transfers card (Mac recentTransfersCard — last completed) -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Recent Transfers" FontWeight="SemiBold" />
                                            <!-- Empty state (Mac fileTransfer.recent.empty) -->
                                            <StackPanel
                                                Spacing="6"
                                                HorizontalAlignment="Center"
                                                Padding="0,12"
                                                Visibility="{Binding FileTransferHistoryCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}">
                                                <FontIcon Glyph="&#xE81C;" FontSize="22" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                                <TextBlock
                                                    Text="No recent transfers yet"
                                                    FontSize="12"
                                                    Foreground="{StaticResource SkyBridgeTextMutedBrush}"
                                                    HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <!-- Populated: compact recent rows -->
                                            <ItemsControl
                                                ItemsSource="{Binding FileTransferHistory}"
                                                ItemTemplate="{StaticResource FileTransferHistoryItemTemplate}"
                                                Visibility="{Binding FileTransferHistoryCount, Converter={StaticResource CountToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- RIGHT MAIN CONTENT -->
                                <StackPanel Grid.Column="1" Spacing="14">
                                    <!-- Drop zone card (Mac modernDropZone) — VISUAL ONLY:
                                         honest "drag-and-drop not yet wired on Windows" subtitle.
                                         No .onDrop handler exists on the Windows client yet; use
                                         the shared Quick Actions buttons to stage a transfer. -->
                                    <Border Style="{StaticResource GlassCard}" Padding="28" MinHeight="160">
                                        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE898;" FontSize="48" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Drop files to transfer" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock
                                                Text="Drag-and-drop is not yet wired on the Windows client. Use Select Files / Select Folder above to stage a transfer intent."
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                TextAlignment="Center"
                                                MaxWidth="420"
                                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}"
                                                HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- QR preview (gated by IsFileTransferShareQrCodeVisible) -->
                                    <Border
                                        AutomationProperties.AutomationId="FileTransferShareQrPreview"
                                        Style="{StaticResource GlassCard}"
                                        Visibility="{Binding IsFileTransferShareQrCodeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="132" Height="132" Padding="8" Background="White" CornerRadius="4">
                                                <Image
                                                    AutomationProperties.AutomationId="FileTransferShareQrImage"
                                                    Source="{Binding FileTransferShareQrCodeImage}"
                                                    Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="File Transfer QR" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding FileTransferStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Transfer Queue section (Mac activeTransfersSection) -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Transfer Queue" FontWeight="SemiBold" />
                                            <ListView
                                                ItemsSource="{Binding FileTransferQueue}"
                                                ItemTemplate="{StaticResource FileTransferQueueItemTemplate}"
                                                MinHeight="112"
                                                SelectionMode="None"
                                                IsEnabled="{Binding IsFileTransferSelected}" />
                                            <TextBlock
                                                Text="Queue is empty. Stage files or a folder from Quick Actions to populate it."
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Transfer History section (Mac enhancedTransferHistoryTab) -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Transfer History" FontWeight="SemiBold" />
                                            <ListView
                                                ItemsSource="{Binding FileTransferHistory}"
                                                ItemTemplate="{StaticResource FileTransferHistoryItemTemplate}"
                                                MinHeight="112"
                                                SelectionMode="None"
                                                IsEnabled="{Binding IsFileTransferSelected}" />
                                            <TextBlock
                                                Text="No completed transfers yet."
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource SkyBridgeTextMutedBrush}"
                                                Visibility="{Binding FileTransferHistoryCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- File Transfer Security facts -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="File Transfer Security" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding FileTransferSecurityFacts}" ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================================
                         Remote Desktop screen — recomposed into a two-pane layout that
                         element-matches the Mac RemoteDesktopView (sessionSidebar +
                         remoteWorkspaceContent).

                         LEFT pane (~300px glass) = search field + 3-tab connection-mode
                         segmented control (Auto / Near / Far) + Active Sessions list +
                         Recent Connections section + bottom New Connection action.
                         RIGHT pane = "Trusted Active Sessions" card + "Preview" card +
                         Quality + control facts.

                         GATE-CRITICAL ordering (verify-windows-ui-parity.ps1 L3628):
                         Text="Remote Desktop"  ->  RemoteDesktopHeaderActions  ->
                         RemoteDesktopActions  ->  Text="Active Sessions". The header,
                         the header-actions ItemsControl, and the FIRST RemoteDesktopActions
                         ItemsControl stay above the two-pane grid in exactly that order.

                         BUTTON BUDGET (matrix L511 = 7): NO inline button element is added.
                         The segmented control is non-interactive Borders; every clickable
                         connect/refresh control routes through the shared
                         WorkspaceActionButtonTemplate via RemoteDesktopActions /
                         RemoteDesktopHeaderActions ItemsControls (buttons live in the
                         DataTemplate, not inline here).
                         =================================================================== -->
                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsRemoteDesktopSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <!-- Header: title + status (left) and the Refresh-Sessions
                                 header action (right). Mac toolbar new-connection menu +
                                 refresh + gear collapse onto these data-driven actions. -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Remote Desktop" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RemoteDesktopStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding RemoteDesktopHeaderActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- The canonical Remote Desktop action row (Recommended /
                                 Advanced Connect / Performance Overlay / Quality / Settings /
                                 Full Screen / Disconnect). Kept here, directly under the
                                 header, to preserve the gate-required action order. These ARE
                                 the Mac "+ menu / refresh / gear / connect" actions. -->
                            <ItemsControl
                                ItemsSource="{Binding RemoteDesktopActions}"
                                ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />

                            <!-- Two-pane body: ~300px session sidebar (left) + workspace
                                 content (right). -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- ===== LEFT PANE — session sidebar (Mac sessionSidebar) ===== -->
                                <Border Grid.Column="0" Style="{StaticResource GlassCard}" VerticalAlignment="Stretch">
                                    <StackPanel Spacing="12">
                                        <!-- Search field (Mac searchBar): magnifier + plain
                                             text field over a glass surface. Filters the
                                             session rows by target name via RemoteDesktopSearchText. -->
                                        <Border
                                            Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                                            BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,2">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    Text="{Binding RemoteDesktopSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="Search sessions..."
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    IsEnabled="{Binding IsRemoteDesktopSelected}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Connection-mode segmented control (Mac
                                             connectionModeSelector): a glass "track" holding 3
                                             equal segments (Auto / Near / Far), each = icon over
                                             label. Auto is the selected (soft-accent pill) default,
                                             matching connectionMode = .auto on the Mac. These are
                                             non-interactive display segments (no live Near/Far
                                             command on Windows yet): they describe the available
                                             modes without faking a transport. -->
                                        <Border
                                            Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                                            BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="4">
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Auto (selected) — E945 = Light(bulb), reads as
                                                     "smart/auto" ~ Mac wand.and.stars. Valid Segoe
                                                     Fluent Icons glyph. -->
                                                <Border Grid.Column="0" CornerRadius="6" Padding="0,8" Background="{StaticResource SkyBridgeRemoteDesktopSoftBrush}">
                                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                        <FontIcon Glyph="&#xE945;" FontSize="14" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Auto" FontSize="11" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- Near — E701 = Wifi ~ SF wifi.circle.fill -->
                                                <Border Grid.Column="1" CornerRadius="6" Padding="0,8" Background="Transparent">
                                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                        <FontIcon Glyph="&#xE701;" FontSize="14" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Near" FontSize="11" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- Far — E774 = Globe ~ SF globe -->
                                                <Border Grid.Column="2" CornerRadius="6" Padding="0,8" Background="Transparent">
                                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                        <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Far" FontSize="11" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Active Sessions section (Mac sessionList "Active
                                             Sessions" section). Bound to RemoteDesktopSessions
                                             (gate L1119). The preview rows + their search-filtered
                                             slice render here; the empty state shows when the
                                             filtered count is 0. -->
                                        <TextBlock Text="Active Sessions" FontWeight="SemiBold" />
                                        <ListView
                                            ItemsSource="{Binding RemoteDesktopSessions}"
                                            ItemTemplate="{StaticResource RemoteDesktopSessionItemTemplate}"
                                            MinHeight="118"
                                            SelectionMode="None"
                                            IsEnabled="{Binding IsRemoteDesktopSelected}"
                                            Visibility="{Binding RemoteDesktopSessionCount, Converter={StaticResource CountToVisibilityConverter}}" />
                                        <StackPanel
                                            Spacing="6"
                                            Padding="0,18"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding RemoteDesktopSessionCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="26" Foreground="{StaticResource SkyBridgeTextMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="No active sessions" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Trusted sessions appear here once verified" FontSize="12" Foreground="{StaticResource SkyBridgeTextMutedBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Recent Connections section (Mac sessionList "Recent
                                             Connections"). The preview rows carrying State="Recent"
                                             already surface in the list above; this honest note
                                             documents that recents reconnect only once a verified
                                             peer key is provided (no fake reconnect entries). -->
                                        <TextBlock Text="Recent Connections" FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="Recent peers reconnect only after a verified peer key is provided."
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />

                                        <!-- Bottom New Connection action (Mac bottomActionBar).
                                             Reuses the data-driven RemoteDesktopActions row so no
                                             inline button element is added; the Recommended/Advanced
                                             connect actions live here for the sidebar footer. -->
                                        <ItemsControl
                                            ItemsSource="{Binding RemoteDesktopActions}"
                                            ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                            ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                                    </StackPanel>
                                </Border>

                                <!-- ===== RIGHT PANE — workspace content (Mac remoteWorkspaceContent) ===== -->
                                <StackPanel Grid.Column="1" Spacing="16">
                                    <!-- "Trusted Active Sessions" card (Mac trustedActiveSessionsPanel):
                                         header + count/"No active session" trailing + descriptive
                                         text + the two connect actions. -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Trusted Active Sessions" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <!-- Trailing badge: shows "No active session" when
                                                     empty (Mac trailing), session count otherwise. -->
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="No active session"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource SkyBridgeTextSecondaryBrush}"
                                                    Visibility="{Binding RemoteDesktopSessionCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}" />
                                                <Border
                                                    Grid.Column="1"
                                                    Style="{StaticResource BadgeSuccess}"
                                                    Visibility="{Binding RemoteDesktopSessionCount, Converter={StaticResource CountToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding RemoteDesktopSessionCount}" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock
                                                Text="Trusted peers will appear here once a verified remote session is established."
                                                FontSize="13"
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                            <!-- The two connect actions (Recommended / Advanced) —
                                                 reuses RemoteDesktopActions, no inline button element. -->
                                            <ItemsControl
                                                ItemsSource="{Binding RemoteDesktopActions}"
                                                ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                                ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- "Preview" card (Mac previewPanel): header + Idle trailing +
                                         big monitor glyph + "Select a session to start Remote
                                         Desktop" + subtitle + the two actions. Honest idle state —
                                         no live frame source until transport is wired. -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel Spacing="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Preview" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="Idle" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                            </Grid>
                                            <!-- Idle empty-state surface (Mac emptyStateView over the
                                                 black.opacity(0.22) backdrop). -->
                                            <Border
                                                Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                                                CornerRadius="14"
                                                MinHeight="320"
                                                Padding="24">
                                                <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                                                    <FontIcon Glyph="&#xE7F4;" FontSize="56" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock
                                                        Text="Select a session to start Remote Desktop"
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap"
                                                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}"
                                                        HorizontalAlignment="Center" />
                                                    <TextBlock
                                                        Text="Connect from Device Discovery for a one-tap session. Manual RDP/VNC/SSH is an advanced path."
                                                        FontSize="13"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap"
                                                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}"
                                                        HorizontalAlignment="Center" />
                                                    <!-- The same two actions, large, in the idle
                                                         preview (Mac controlSize(.large)) — reuses
                                                         RemoteDesktopActions, no inline button element. -->
                                                    <ItemsControl
                                                        ItemsSource="{Binding RemoteDesktopActions}"
                                                        ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                                        ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                                        HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Quality (Mac video-quality controls): bitrate +
                                                 framerate profile pickers, sourced from the
                                                 RemoteDesktopProfileCatalogClient. -->
                                            <TextBlock Text="Quality" FontWeight="SemiBold" />
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" ItemsSource="{Binding BitrateProfiles}" SelectedItem="{Binding SelectedBitrate, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRemoteDesktopSelected}" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding FramerateProfiles}" SelectedItem="{Binding SelectedFramerate, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRemoteDesktopSelected}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Control facts (transport / channel-map / encode plan). -->
                                    <ItemsControl ItemsSource="{Binding RemoteDesktopControlFacts}" ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsSystemMonitorSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="System Monitor" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SystemMonitorStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding SystemMonitorHeaderActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl
                                ItemsSource="{Binding SystemMonitorActions}"
                                ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />

                            <!-- Status-pill strip (Mac PerformanceMonitoringPanelView
                                 Health/Thermal/Load indicators rendered as tinted pills).
                                 Bound to the live SystemMonitorIndicators collection; each
                                 pill's dot/icon/value is tinted by State (green healthy,
                                 orange caution/read-only, red offline, muted unknown/idle/
                                 off — pending stays muted, never fake-healthy). -->
                            <ItemsControl
                                AutomationProperties.AutomationId="Skybridge.SystemMonitor.IndicatorPills"
                                ItemsSource="{Binding SystemMonitorIndicators}"
                                ItemsPanel="{StaticResource SystemMonitorIndicatorPillItemsPanel}"
                                ItemTemplate="{StaticResource SystemMonitorIndicatorPillTemplate}" />

                            <!-- ============ Card 1 — System Metrics ============
                                 Mac SystemMetricsPanelView: colored metric tile grid.
                                 The hero presentation is the tile grid (live Memory/Disk/
                                 Network + honest CPU logical-core count). The gated
                                 WorkspaceFactRowTemplate ListView below is the canonical
                                 data surface the parity gate asserts on; it is collapsed so
                                 the same rows are not rendered twice (no data is hidden —
                                 every Overview row appears as a tile). -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Overview" FontWeight="SemiBold" />
                                <ItemsControl
                                    AutomationProperties.AutomationId="Skybridge.SystemMonitor.MetricTiles"
                                    ItemsSource="{Binding SystemMonitorOverview}"
                                    ItemsPanel="{StaticResource SystemMonitorMetricTileItemsPanel}"
                                    ItemTemplate="{StaticResource SystemMonitorMetricTileTemplate}" />
                                <ListView Visibility="Collapsed" ItemsSource="{Binding SystemMonitorOverview}" ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" MinHeight="118" SelectionMode="None" IsEnabled="{Binding IsSystemMonitorSelected}" />
                            </StackPanel>

                            <!-- Indicators heading kept for parity/section order; the live
                                 indicator data is rendered above as the tinted pill strip.
                                 The gated WorkspaceStateRowTemplate ListView is collapsed
                                 (the pills are the visible presentation of the same rows). -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Indicators" FontWeight="SemiBold" />
                                <ListView Visibility="Collapsed" ItemsSource="{Binding SystemMonitorIndicators}" ItemTemplate="{StaticResource WorkspaceStateRowTemplate}" MinHeight="118" SelectionMode="None" IsEnabled="{Binding IsSystemMonitorSelected}" />
                            </StackPanel>

                            <!-- ============ Card 2 — Detailed Monitoring ============
                                 Mac PerformanceMonitoringPanelView insight/detail rows:
                                 OS / .NET / GC heap / Advanced (live) plus the honest
                                 pending rows (Thermal "Windows provider pending", GPU
                                 "provider pending", Helper "not installed"). Bound to the
                                 live SystemMonitorDetails collection via the gated
                                 WorkspaceFactRowTemplate (label / value / detail). -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Detailed Monitoring" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SystemMonitorDetails}" ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SettingsStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding SettingsHeaderActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl
                                ItemsSource="{Binding SettingsToolbarActions}"
                                ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />

                            <!-- ===========================================================
                                 Settings two-pane (element-matches the Mac SettingsView):
                                   LEFT  (~210px) — the tab sub-nav. A native ListView bound
                                          to SettingsTabs; the native container owns single
                                          selection + the filled selection pill (exactly one
                                          tab highlighted). SelectedItem is TwoWay-bound to
                                          SelectedSettingsTab, which drives the right pane.
                                   RIGHT (*)      — the selected tab's grouped section CARDS,
                                          bound to SelectedSettingsTabCards (re-derived from
                                          the 142-row SettingsDetails slice for the selected
                                          tab). Each group = gray section title + glass card
                                          of control rows (toggle / dropdown / value).
                                 No push-button anywhere here (gated count stays 7); controls
                                 are ToggleSwitch / ComboBox / FontIcon / TextBlock only.
                                 =========================================================== -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Settings Tabs" FontWeight="SemiBold" />
                                    <ListView
                                        AutomationProperties.AutomationId="Skybridge.Settings.TabNav"
                                        ItemsSource="{Binding SettingsTabs}"
                                        ItemTemplate="{StaticResource SettingsTabItemTemplate}"
                                        SelectedItem="{Binding SelectedSettingsTab, Mode=TwoWay}"
                                        SelectionMode="Single"
                                        MinHeight="220"
                                        VerticalAlignment="Top"
                                        IsEnabled="{Binding IsSettingsSelected}" />
                                </StackPanel>

                                <!-- RIGHT — the per-tab interactive UserControl HOST, swapped by
                                     SelectedSettingsTab. The eight Settings*View tab views are
                                     stacked; each is gated by SettingsTabKeyVisibilityConverter on
                                     the selected tab's stable English title so exactly one is
                                     realized/visible. These ARE the live interactive Settings
                                     (every control two-way binds to the SettingsCoordinator the
                                     SessionViewModel exposes as `Settings`). DataContext is the
                                     SessionViewModel inherited from RootShell, so every binding
                                     inside the tab views resolves. -->
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Settings Details" FontWeight="SemiBold" />
                                    <ScrollViewer
                                        VerticalScrollBarVisibility="Auto"
                                        VerticalScrollMode="Auto"
                                        MaxHeight="520">
                                        <Grid>
                                            <settings:SettingsGeneralView
                                                Visibility="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabKeyVisibilityConverter}, ConverterParameter=General}" />
                                            <settings:SettingsNetworkView
                                                Visibility="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabKeyVisibilityConverter}, ConverterParameter=Network}" />
                                            <settings:SettingsDevicesView
                                                Visibility="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabKeyVisibilityConverter}, ConverterParameter=Devices}" />
                                            <settings:SettingsFileTransferView
                                                Visibility="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabKeyVisibilityConverter}, ConverterParameter='File Transfer'}" />
                                            <settings:SettingsRemoteDesktopView
                                                Visibility="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabKeyVisibilityConverter}, ConverterParameter='Remote Desktop'}" />
                                            <settings:SettingsSystemMonitorView
                                                Visibility="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabKeyVisibilityConverter}, ConverterParameter='System Monitor'}" />
                                            <settings:SettingsPermissionsView
                                                Visibility="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabKeyVisibilityConverter}, ConverterParameter=Permissions}" />
                                            <settings:SettingsAdvancedView
                                                Visibility="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabKeyVisibilityConverter}, ConverterParameter=Advanced}" />
                                        </Grid>
                                    </ScrollViewer>
                                </StackPanel>
                            </Grid>

                            <!-- ===========================================================
                                 Full read-only mirror of the active settings snapshot. The
                                 two-pane above is the primary, grouped, control-styled view;
                                 this collapsed block keeps the flat, contract-shaped
                                 SettingsDetails (all 142 rows: Section / Label / Value /
                                 Detail) bound through SettingsDetailRowTemplate so the
                                 underlying read-only data stays directly inspectable and the
                                 service-boundary contract (every row surfaced 1:1) is
                                 preserved. Collapsed so it does not double-render beneath the
                                 cards — same real collection, no duplicate visual.
                                 =========================================================== -->
                            <ItemsControl
                                AutomationProperties.AutomationId="Skybridge.Settings.SectionCards"
                                Visibility="Collapsed"
                                ItemsSource="{Binding SettingsDetails}"
                                ItemTemplate="{StaticResource SettingsDetailRowTemplate}" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="Settings Actions" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SettingsActions}" ItemTemplate="{StaticResource SettingsActionRowTemplate}" />
                                <ItemsControl
                                    ItemsSource="{Binding SettingsMaintenanceActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel Spacing="14">
                                <TextBlock
                                    AutomationProperties.AutomationId="Skybridge.Session.SelectedFeature.Title"
                                    Text="{Binding SelectedFeature.Title}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedFeature.Status}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ItemsControl
                                    AutomationProperties.AutomationId="Skybridge.Actions.SessionControls"
                                    ItemsSource="{Binding SessionControlActions}"
                                    ItemsPanel="{StaticResource SessionWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassPanel}" Grid.Column="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Session Controls" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Bitrate" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox
                                        AutomationProperties.AutomationId="Skybridge.SessionControls.Bitrate"
                                        ItemsSource="{Binding BitrateProfiles}"
                                        SelectedItem="{Binding SelectedBitrate, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Framerate" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox
                                        AutomationProperties.AutomationId="Skybridge.SessionControls.Framerate"
                                        ItemsSource="{Binding FramerateProfiles}"
                                        SelectedItem="{Binding SelectedFramerate, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </NavigationView>

        <!-- ===================================================================
             Account overlays — full-bleed layers over the whole shell (both
             sidebar + content columns), on top of the NavigationView (later in
             markup = higher z-order). These REPLACE the crashing SignInDialog /
             sign-out ContentDialog: each is a UserControl in the window's visual
             tree, so there is no XamlRoot, no single-dialog-at-a-time rule, and
             no async-void ShowAsync teardown. Visibility is bound to the VM
             flags (set true on the account-block Tapped handler). The
             UserControls carry ALL their own button elements, so the gated
             MainWindow.xaml button-element count is unchanged.

               • AuthOverlay         — visible when signed-OUT + ShowAuthOverlay
               • UserProfileOverlay  — visible when signed-IN  + ShowProfileOverlay
             =================================================================== -->
        <local:AuthOverlay
            Grid.Column="0"
            Grid.ColumnSpan="2"
            DataContext="{Binding}"
            Visibility="{Binding ShowAuthOverlay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <local:UserProfileOverlay
            Grid.Column="0"
            Grid.ColumnSpan="2"
            DataContext="{Binding}"
            Visibility="{Binding ShowProfileOverlay, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</Window>
