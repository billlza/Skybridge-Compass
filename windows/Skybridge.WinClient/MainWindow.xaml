<Window
    x:Class="Skybridge.WinClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Skybridge.WinClient.ViewModels"
    mc:Ignorable="d">
    <Grid
        x:Name="RootShell"
        Background="{StaticResource SkyBridgeWindowGradientBrush}"
        d:DataContext="{d:DesignInstance Type=vm:SessionViewModel, IsDesignTimeCreatable=False}">
        <Grid.Resources>
        <vm:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <vm:FeatureEntryIdToAccentBrushConverter x:Key="FeatureAccentBrushConverter" />
        <vm:MetricKeyToGlyphConverter x:Key="MetricGlyphConverter" />
        <vm:MetricKeyToBrushConverter x:Key="MetricAccentBrushConverter" />
        <vm:QuickActionKeyToBrushConverter x:Key="QuickActionAccentBrushConverter" />
        <ItemsPanelTemplate x:Key="VerticalWorkspaceActionItemsPanel">
            <StackPanel Spacing="10" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="HorizontalWorkspaceActionItemsPanel">
            <StackPanel Orientation="Horizontal" Spacing="10" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="SessionWorkspaceActionItemsPanel">
            <StackPanel Orientation="Horizontal" Spacing="12" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WorkspaceMetricCardItemsPanel">
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="232" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="DashboardQuickActionItemsPanel">
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="318" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="SidebarWorkspaceActionButtonTemplate">
            <Button
                AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding Command}"
                IsEnabled="{Binding IsEnabled}"
                HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{Binding Glyph}" FontSize="14" />
                    <TextBlock Text="{Binding Title}" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <!-- NavigationView MenuItemTemplate: per-item content is a 32x32 accent
             icon chip (per-feature accent via FeatureAccentBrushConverter) +
             title (SemiBold) + status subtitle (12px secondary). The native
             NavigationViewItem owns selection/hover/keyboard/accessibility, so
             this template carries ONLY the content — no selection visuals. -->
        <DataTemplate x:Key="NavigationItemTemplate">
            <Grid
                MinHeight="48"
                ColumnSpacing="12"
                AutomationProperties.AutomationId="{Binding Id}"
                AutomationProperties.Name="{Binding Title}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                    Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                    VerticalAlignment="Center">
                    <FontIcon
                        Glyph="{Binding Glyph}"
                        FontSize="16"
                        Foreground="{Binding Id, Converter={StaticResource FeatureAccentBrushConverter}}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <TextBlock
                        Text="{Binding Status}"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        FontSize="12"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceActionButtonTemplate">
            <Button
                AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding Command}"
                IsEnabled="{Binding IsEnabled}"
                Width="44"
                Height="36"
                MinWidth="44"
                Padding="10,6"
                ToolTipService.ToolTip="{Binding Title}">
                <FontIcon Glyph="{Binding Glyph}" FontSize="14" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceActionButtonWithDetailTemplate">
            <Button
                AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding Command}"
                IsEnabled="{Binding IsEnabled}"
                MinWidth="0"
                Padding="10,6"
                ToolTipService.ToolTip="{Binding Title}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{Binding Glyph}" FontSize="14" />
                    <TextBlock Text="{Binding Title}" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="TopBarStatusActionButtonTemplate">
            <Button
                AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding Command}"
                IsEnabled="{Binding IsEnabled}"
                MinWidth="44"
                Padding="8,6"
                ToolTipService.ToolTip="{Binding Title}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="{Binding Glyph}" FontSize="14" />
                    <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceMetricCardTemplate">
            <!-- Element-matches the Mac StatCard.swift: colored icon top-left,
                 then a small secondary label, then a big bold value. There is NO
                 caption/description under the value on the Mac, so the Detail
                 TextBlock is intentionally absent here. -->
            <Border Style="{StaticResource MetricCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Accent icon chip (top-left), matching the Mac StatCard glyph badge.
                         Glyph + accent hue are keyed per-metric off the stable Title
                         (Online Devices / Active Sessions / Transfer Tasks / System Status)
                         so each card reads distinctly like the Mac StatCard. -->
                    <Border
                        Style="{StaticResource AccentIconChip}"
                        HorizontalAlignment="Left">
                        <FontIcon
                            Glyph="{Binding Title, Converter={StaticResource MetricGlyphConverter}}"
                            FontSize="18"
                            Foreground="{Binding Title, Converter={StaticResource MetricAccentBrushConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <!-- Bottom group: small secondary label + big bold value
                         (Mac VStack rhythm: label .caption .secondary, value .title.bold). -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="4">
                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="12"
                            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}"
                            TextWrapping="Wrap"
                            MaxLines="1" />
                        <TextBlock
                            Text="{Binding Value}"
                            FontSize="30"
                            FontWeight="Bold"
                            LineHeight="34"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DashboardQuickActionTemplate">
            <!-- Element-matches the Mac QuickActionButton.swift: a centered colored
                 icon over a centered title, NO subtitle/description (Mac shows none).
                 The colored glyph hue is keyed per-action off the stable Key. -->
            <Button
                Style="{StaticResource QuickActionTile}"
                AutomationProperties.AutomationId="{Binding AutomationId}"
                AutomationProperties.Name="{Binding Title}"
                Command="{Binding Command}"
                IsEnabled="{Binding IsEnabled}"
                Width="306"
                Margin="0,0,12,12">
                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border
                        Width="44"
                        Height="44"
                        CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                        Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                        BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                        <FontIcon
                            Glyph="{Binding Glyph}"
                            FontSize="18"
                            Foreground="{Binding Key, Converter={StaticResource QuickActionAccentBrushConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock
                        Text="{Binding Title}"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceFactRowTemplate">
            <Grid Padding="0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="2"
                    Text="{Binding Detail}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DiscoveredPeerItemTemplate">
            <Grid Padding="0,8" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DeviceId}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding Platform}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ServiceKind}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="{Binding CapabilitiesSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PublicKeyFingerprint}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding TrustSummary}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="UsbDeviceItemTemplate">
            <Grid Padding="0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DeviceType}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Capabilities}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="Device ID" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DeviceId}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding ConnectionInterface}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="Vendor / Product" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VendorId}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding ProductId}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding SerialNumber}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FileTransferQueueItemTemplate">
            <Grid Padding="0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Size}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding State}" />
                <TextBlock Grid.Column="2" Text="{Binding Binding}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FileTransferHistoryItemTemplate">
            <Grid Padding="0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Result}" />
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding Hmac}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Signature}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RemoteDesktopSessionItemTemplate">
            <Grid Padding="0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding State}" />
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding Transport}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Quality}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="WorkspaceStateRowTemplate">
            <Grid Padding="0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding State}" TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="2"
                    Text="{Binding Detail}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SettingsDetailRowTemplate">
            <Grid Padding="0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Section}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" />
                <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="3"
                    Text="{Binding Detail}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SettingsActionRowTemplate">
            <Grid Padding="0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" />
                <TextBlock Grid.Column="2" Text="{Binding State}" />
                <TextBlock
                    Grid.Column="3"
                    Text="{Binding Detail}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SettingsTabItemTemplate">
            <StackPanel Padding="0,8" Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock
                    Text="{Binding Detail}"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================================================================
             Sidebar shell — WinUI 3 NavigationView (the Windows-standard nav).
             The native control owns the nav list, single-selection, the
             selection indicator/pill, keyboard navigation and accessibility,
             so exactly one item highlights at a time (replaces the custom
             ListView + NavItemContainer pill, which painted every item's pill).

               • MenuItemsSource = NavigationItems   (was ItemsSource)
               • MenuItemTemplate = NavigationItemTemplate  (was ItemTemplate)
               • SelectedItem    = SelectedFeature (TwoWay)  — unchanged binding
               • PaneHeader      = 44x44 brand block + name + ConnectionStatus
               • PaneFooter      = Connect / Disconnect session actions
               • On-brand selected/hover surfaces come from the documented
                 NavigationView theme-resource overrides in App.xaml.
             =================================================================== -->
        <NavigationView
            Grid.Column="0"
            Grid.ColumnSpan="2"
            x:Name="SidebarNavigation"
            AutomationProperties.AutomationId="Skybridge.Navigation.List"
            PaneDisplayMode="Left"
            OpenPaneLength="280"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            MenuItemsSource="{Binding NavigationItems}"
            MenuItemTemplate="{StaticResource NavigationItemTemplate}"
            SelectedItem="{Binding SelectedFeature, Mode=TwoWay}"
            BorderBrush="{StaticResource SkyBridgePanelStrokeBrush}"
            BorderThickness="0,0,1,0">

            <!-- Brand header block (44x44 accent icon + name + status subtitle) -->
            <NavigationView.PaneHeader>
                <Grid Padding="16,20,16,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="44"
                        Height="44"
                        CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                        Background="{StaticResource SkyBridgeAccentBrush}"
                        VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE80F;" FontSize="22" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Skybridge Compass" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" MaxLines="1" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <!-- Bottom-pinned session controls (Connect / Disconnect) -->
            <NavigationView.PaneFooter>
                <Grid Padding="16,8,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Height="1" Margin="0,0,0,12" Background="{StaticResource SkyBridgePanelStrokeBrush}" />
                    <ItemsControl
                        Grid.Row="1"
                        AutomationProperties.AutomationId="Skybridge.Actions.SidebarSession"
                        ItemsSource="{Binding SidebarSessionActions}"
                        ItemsPanel="{StaticResource VerticalWorkspaceActionItemsPanel}"
                        ItemTemplate="{StaticResource SidebarWorkspaceActionButtonTemplate}" />
                </Grid>
            </NavigationView.PaneFooter>

        <!-- NavigationView Content = top bar + the 8 feature workspace panels;
             they switch via the IsXxxSelected Visibility bindings as the
             SelectedFeature changes. Content is unchanged from the prior shell. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="24,8"
                Background="{StaticResource SkyBridgeTopBarFillBrush}"
                BorderBrush="{StaticResource SkyBridgePanelStrokeBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            AutomationProperties.AutomationId="Skybridge.SelectedFeature.Title"
                            Text="{Binding SelectedFeature.Title}"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            AutomationProperties.AutomationId="Skybridge.Status.Message"
                            Text="{Binding StatusMessage}"
                            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border
                            Style="{StaticResource StatusPill}"
                            AutomationProperties.AutomationId="Skybridge.TopBar.ConnectionStatus">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource SkyBridgeSuccessBrush}" />
                                <FontIcon Glyph="&#xE9F5;" FontSize="12" Foreground="{StaticResource SkyBridgeSuccessBrush}" />
                                <TextBlock Text="{Binding TopBarConnectionStatus}" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Style="{StaticResource StatusPill}"
                            AutomationProperties.AutomationId="Skybridge.TopBar.DiagnosticsStatus"
                            ToolTipService.ToolTip="FPS / Diagnostics">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource SkyBridgeWarningBrush}" />
                                <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{StaticResource SkyBridgeWarningBrush}" />
                                <TextBlock Text="FPS" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                <TextBlock Text="{Binding TopBarDiagnosticsStatus}" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <ItemsControl
                            AutomationProperties.AutomationId="Skybridge.Actions.TopBar"
                            ItemsSource="{Binding TopBarActions}"
                            ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                            ItemTemplate="{StaticResource TopBarStatusActionButtonTemplate}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1">
                <StackPanel Padding="32,24" Spacing="24">
                    <StackPanel
                        Visibility="{Binding IsDashboardSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                        Spacing="24">
                        <!-- Live overview metric cards: 4-up equal-width row (matches Mac StatCard row) -->
                        <ItemsControl
                            ItemsSource="{Binding DashboardMetrics}"
                            ItemsPanel="{StaticResource WorkspaceMetricCardItemsPanel}"
                            ItemTemplate="{StaticResource WorkspaceMetricCardTemplate}" />

                        <!-- Quick Actions panel (matches Mac 2x2 QuickActionsPanelView) -->
                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE80A;" FontSize="16" Foreground="{StaticResource SkyBridgeAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Quick Actions" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    AutomationProperties.AutomationId="Skybridge.Actions.DashboardQuickActions"
                                    ItemsSource="{Binding DashboardQuickActions}"
                                    ItemsPanel="{StaticResource DashboardQuickActionItemsPanel}"
                                    ItemTemplate="{StaticResource DashboardQuickActionTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsDeviceDiscoverySelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Device Discovery" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DiscoveryStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding DeviceDiscoveryPrimaryActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    Content="Compatibility Mode"
                                    IsChecked="{Binding IsDiscoveryCompatibilityModeEnabled, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <ItemsControl
                                        ItemsSource="{Binding DeviceDiscoveryScanActions}"
                                        ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                        ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                                    <TextBlock Text="{Binding ExtendedSearchCountdown}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBox
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding DiscoverySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Search devices"
                                    HorizontalAlignment="Stretch" />
                            </Grid>

                            <TextBlock Text="{Binding DiscoveryBrowserStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl
                                ItemsSource="{Binding DiscoveryBrowserFacts}"
                                ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Manual Host / IP" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding ManualConnectionHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="IP Address" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Port" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding ManualConnectionPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="11550" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Code" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding ManualConnectionCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Optional code" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding ManualConnectionStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl
                                ItemsSource="{Binding ManualConnectionFacts}"
                                ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />

                            <ItemsControl
                                AutomationProperties.AutomationId="Skybridge.Actions.DeviceDiscoveryManualConnectFinal"
                                ItemsSource="{Binding DeviceDiscoveryManualConnectFinalActions}"
                                ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                ItemTemplate="{StaticResource WorkspaceActionButtonWithDetailTemplate}" />

                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Dynamic Encrypted QR Code" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl
                                            ItemsSource="{Binding CrossNetworkQrActions}"
                                            ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                            ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Text="{Binding CrossNetworkQrInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="skybridge://connect/&lt;base64url-json&gt;"
                                            HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <Border
                                        AutomationProperties.AutomationId="CrossNetworkGeneratedQrCodePreview"
                                        Width="168"
                                        Height="168"
                                        Padding="10"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding IsCrossNetworkGeneratedQrCodeVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Image
                                            AutomationProperties.AutomationId="CrossNetworkGeneratedQrCodeImage"
                                            Source="{Binding CrossNetworkGeneratedQrCodeImage}"
                                            Stretch="Uniform" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <TextBlock Text="Smart Connection Code" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl
                                            ItemsSource="{Binding CrossNetworkCodePrimaryActions}"
                                            ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                            ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Text="{Binding CrossNetworkCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="ABC234"
                                            MaxLength="6"
                                            HorizontalContentAlignment="Center" />
                                        <ItemsControl
                                            Grid.Column="2"
                                            ItemsSource="{Binding CrossNetworkCodeConnectActions}"
                                            ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                            ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                                    </Grid>
                                    <TextBlock Text="{Binding CrossNetworkGeneratedCode}" FontSize="28" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding CrossNetworkStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl
                                ItemsSource="{Binding CrossNetworkConnectionFacts}"
                                ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Service" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding DiscoveryService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsDeviceDiscoverySelected}"
                                        PlaceholderText="_skybridge._udp" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="TXT record" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding DiscoveryTxtRecord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsDeviceDiscoverySelected}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="82" />
                                </StackPanel>
                            </Grid>

                            <ListView ItemsSource="{Binding DiscoveredPeers}" ItemTemplate="{StaticResource DiscoveredPeerItemTemplate}" MinHeight="86" SelectionMode="None" />

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Pairing Code" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding PairingConnectionCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsDeviceDiscoverySelected}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="96" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="{Binding PairingStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl
                                        ItemsSource="{Binding PairingFacts}"
                                        ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />
                                    <TextBlock Text="{Binding ConnectionPreflightStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl
                                        ItemsSource="{Binding ConnectionPreflightFacts}"
                                        ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsUsbManagementSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="USB Management" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UsbManagementStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding UsbManagementHeaderActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl
                                ItemsSource="{Binding UsbDeviceStats}"
                                ItemsPanel="{StaticResource WorkspaceMetricCardItemsPanel}"
                                ItemTemplate="{StaticResource WorkspaceMetricCardTemplate}" />

                            <StackPanel Spacing="8">
                                <TextBlock Text="Connected Devices" FontWeight="SemiBold" />
                                <ListView ItemsSource="{Binding UsbDevices}" ItemTemplate="{StaticResource UsbDeviceItemTemplate}" MinHeight="118" SelectionMode="None" IsEnabled="{Binding IsUsbManagementSelected}" />
                                <TextBlock Text="No USB devices detected. Connect a device and refresh, or check the cable and port." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsFileTransferSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="File Transfer" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FileTransferStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding FileTransferHeaderActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl
                                ItemsSource="{Binding FileTransferActions}"
                                ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />

                            <Border
                                AutomationProperties.AutomationId="FileTransferShareQrPreview"
                                Visibility="{Binding IsFileTransferShareQrCodeVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                Padding="12"
                                CornerRadius="8"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="132" Height="132" Padding="8" Background="White" CornerRadius="4">
                                        <Image
                                            AutomationProperties.AutomationId="FileTransferShareQrImage"
                                            Source="{Binding FileTransferShareQrCodeImage}"
                                            Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="File Transfer QR" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FileTransferStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Transfer Queue" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{Binding FileTransferQueue}" ItemTemplate="{StaticResource FileTransferQueueItemTemplate}" MinHeight="112" SelectionMode="None" IsEnabled="{Binding IsFileTransferSelected}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Transfer History" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{Binding FileTransferHistory}" ItemTemplate="{StaticResource FileTransferHistoryItemTemplate}" MinHeight="112" SelectionMode="None" IsEnabled="{Binding IsFileTransferSelected}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="File Transfer Security" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding FileTransferSecurityFacts}" ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsRemoteDesktopSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Remote Desktop" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RemoteDesktopStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding RemoteDesktopHeaderActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl
                                ItemsSource="{Binding RemoteDesktopActions}"
                                ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Active Sessions" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{Binding RemoteDesktopSessions}" ItemTemplate="{StaticResource RemoteDesktopSessionItemTemplate}" MinHeight="118" SelectionMode="None" IsEnabled="{Binding IsRemoteDesktopSelected}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Quality" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding BitrateProfiles}" SelectedItem="{Binding SelectedBitrate, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRemoteDesktopSelected}" />
                                    <ComboBox ItemsSource="{Binding FramerateProfiles}" SelectedItem="{Binding SelectedFramerate, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRemoteDesktopSelected}" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RemoteDesktopControlFacts}" ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsQuantumSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Quantum / Core Diagnostics" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CoreDiagnosticsStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding QuantumDiagnosticsHeaderActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ListView ItemsSource="{Binding CoreDiagnosticFacts}" ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" MinHeight="118" SelectionMode="None" IsEnabled="{Binding IsQuantumSelected}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsSystemMonitorSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="System Monitor" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SystemMonitorStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding SystemMonitorHeaderActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl
                                ItemsSource="{Binding SystemMonitorActions}"
                                ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Overview" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{Binding SystemMonitorOverview}" ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" MinHeight="118" SelectionMode="None" IsEnabled="{Binding IsSystemMonitorSelected}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Indicators" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{Binding SystemMonitorIndicators}" ItemTemplate="{StaticResource WorkspaceStateRowTemplate}" MinHeight="118" SelectionMode="None" IsEnabled="{Binding IsSystemMonitorSelected}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Detailed Monitoring" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SystemMonitorDetails}" ItemTemplate="{StaticResource WorkspaceFactRowTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassPanel}" Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SettingsStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding SettingsHeaderActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl
                                ItemsSource="{Binding SettingsToolbarActions}"
                                ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Settings Tabs" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{Binding SettingsTabs}" ItemTemplate="{StaticResource SettingsTabItemTemplate}" MinHeight="220" SelectionMode="None" IsEnabled="{Binding IsSettingsSelected}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="12">
                                    <TextBlock Text="Settings Details" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding SettingsDetails}" ItemTemplate="{StaticResource SettingsDetailRowTemplate}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Settings Actions" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SettingsActions}" ItemTemplate="{StaticResource SettingsActionRowTemplate}" />
                                <ItemsControl
                                    ItemsSource="{Binding SettingsMaintenanceActions}"
                                    ItemsPanel="{StaticResource HorizontalWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource GlassPanel}">
                            <StackPanel Spacing="14">
                                <TextBlock
                                    AutomationProperties.AutomationId="Skybridge.Session.SelectedFeature.Title"
                                    Text="{Binding SelectedFeature.Title}"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedFeature.Status}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ItemsControl
                                    AutomationProperties.AutomationId="Skybridge.Actions.SessionControls"
                                    ItemsSource="{Binding SessionControlActions}"
                                    ItemsPanel="{StaticResource SessionWorkspaceActionItemsPanel}"
                                    ItemTemplate="{StaticResource WorkspaceActionButtonTemplate}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassPanel}" Grid.Column="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Session Controls" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Bitrate" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox
                                        AutomationProperties.AutomationId="Skybridge.SessionControls.Bitrate"
                                        ItemsSource="{Binding BitrateProfiles}"
                                        SelectedItem="{Binding SelectedBitrate, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Framerate" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox
                                        AutomationProperties.AutomationId="Skybridge.SessionControls.Framerate"
                                        ItemsSource="{Binding FramerateProfiles}"
                                        SelectedItem="{Binding SelectedFramerate, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </NavigationView>
    </Grid>
</Window>
