<Window
    x:Class="Skybridge.WinClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Skybridge.WinClient.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SessionViewModel, IsDesignTimeCreatable=False}">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBase}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <Grid Padding="20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock Text="Skybridge Compass" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    Margin="0,22,0,18"
                    ItemsSource="{Binding NavigationItems}"
                    SelectedItem="{Binding SelectedFeature, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="48" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="{Binding Glyph}"
                                    FontSize="16"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{Binding Status}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Spacing="10">
                    <Button Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Connect" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DisconnectCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                            <TextBlock Text="Disconnect" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="24,14"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedFeature.Title}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border
                            Padding="12,7"
                            CornerRadius="6"
                            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9F5;" FontSize="12" />
                                <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding HeartbeatCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE95B;" FontSize="14" />
                                <TextBlock Text="Heartbeat" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1">
                <StackPanel Padding="24" Spacing="20">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Online Devices" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding OnlineDeviceCount}" FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Active Sessions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ActiveSessionCount}" FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Transfer Tasks" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding TransferTaskCount}" FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Performance" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding PerformanceStatus}" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Device Discovery" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DiscoveryStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ParseAdvertisementCommand}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="14" />
                                        <TextBlock Text="Parse TXT" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Service" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding DiscoveryService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsDeviceDiscoverySelected}"
                                        PlaceholderText="_skybridge._udp" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="TXT record" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        Text="{Binding DiscoveryTxtRecord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsDeviceDiscoverySelected}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="82" />
                                </StackPanel>
                            </Grid>

                            <ListView ItemsSource="{Binding DiscoveredPeers}" MinHeight="86" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DeviceId}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Platform}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ServiceKind}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="3">
                                                <TextBlock Text="{Binding CapabilitiesSummary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding PublicKeyFingerprint}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding TrustSummary}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="File Transfer" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FileTransferStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding RefreshFileTransferCommand}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                        <TextBlock Text="Refresh Plan" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                        <TextBlock Text="Select Files" />
                                    </StackPanel>
                                </Button>
                                <Button IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                        <TextBlock Text="Select Folder" />
                                    </StackPanel>
                                </Button>
                                <Button IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE97E;" FontSize="14" />
                                        <TextBlock Text="Generate QR" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Transfer Queue" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{Binding FileTransferQueue}" MinHeight="112" SelectionMode="None" IsEnabled="{Binding IsFileTransferSelected}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,8" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="160" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Size}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding State}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Binding}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Transfer History" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{Binding FileTransferHistory}" MinHeight="112" SelectionMode="None" IsEnabled="{Binding IsFileTransferSelected}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,8" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="160" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Result}" />
                                                    <StackPanel Grid.Column="2" Spacing="2">
                                                        <TextBlock Text="{Binding Hmac}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Signature}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding FileTransferSecurityFacts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Quantum / Core Diagnostics" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CoreDiagnosticsStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding RunCoreDiagnosticsCommand}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                        <TextBlock Text="Run Diagnostics" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ListView ItemsSource="{Binding CoreDiagnosticFacts}" MinHeight="118" SelectionMode="None" IsEnabled="{Binding IsQuantumSelected}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="240" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{Binding SelectedFeature.Title}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedFeature.Status}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Command="{Binding ConnectCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="Connect" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding HeartbeatCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE95B;" FontSize="14" />
                                            <TextBlock Text="Heartbeat" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DisconnectCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                            <TextBlock Text="Disconnect" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Session Controls" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Bitrate" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding BitrateProfiles}" SelectedItem="{Binding SelectedBitrate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Framerate" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox ItemsSource="{Binding FramerateProfiles}" SelectedItem="{Binding SelectedFramerate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
