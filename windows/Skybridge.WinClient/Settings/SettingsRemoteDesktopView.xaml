<?xml version="1.0" encoding="utf-8"?>
<!--
  SettingsRemoteDesktopView — Tab 5 (远程桌面 / Remote Desktop), FULLY built.

  Element-for-element faithful to the Mac 远程桌面 tab (SettingsView.swift §"TAB 5", see
  macSpec lines 136-175). Four frosted-glass section cards (GlassCard) with the verbatim zh
  section headers, every interactive control two-way bound to Settings.<Prop> on the
  SettingsCoordinator (SessionViewModel.Settings) per the binding contract (contract.md Tab 5).

  Sections, ONE FOR ONE with Mac:
    • 画质与性能 — Status header (当前配置 summary · 已优化/需调整 badge · 预估传输率 MB/s · 负载
                  tier) computed read-only from the live selection (NO fabricated numbers — same
                  base-rate × fps-multiplier × compression-ratio formula as the Mac
                  VideoTransferConfiguration.estimatedDataRate). 预设方案 (平衡/高性能/高质量/低延迟)
                  as a SELECTABLE RadioButtons group that applies the real Mac preset combo
                  (resolution+frameRate+compression+adaptiveBitrate) to the coordinator. Resolution
                  cards (RadioButtons → VideoResolution), Frame-rate cards (RadioButtons →
                  VideoFrameRate), 压缩质量 dropdown (→ VideoCompressionQuality), 启用硬件加速 toggle
                  (→ EnableHardwareAcceleration), 自适应比特率 toggle (→ EnableAdaptiveBitrate),
                  Apple Silicon 优化 (OMIT-APPLE-ONLY, disabled).
    • 显示       — 压缩级别 slider 1…100 (→ RdCompressionLevelDisplay), 全屏模式 toggle
                  (→ RdFullScreenMode).
    • 交互       — 启用剪贴板同步 toggle REAL-FULL (→ EnableClipboardSync, gates the existing
                  WindowsClipboardSyncService), 启用文件传输 toggle (→ EnableRemoteFileTransfer),
                  鼠标灵敏度 slider 0.1…3.0 (→ MouseSensitivity), 双击间隔 slider 200…1000
                  (→ DoubleClickInterval); 音频重定向 (LOCKED "暂不可用"), 触控板手势
                  (OMIT-APPLE-ONLY).
    • 网络优化   — 启用带宽自适应 toggle (→ RdEnableAdaptiveQuality), 启用UDP传输 toggle
                  (→ RdEnableUDPTransport), 启用数据压缩 — 网络压缩级别 slider 0…9
                  (→ RdNetworkCompressionLevel), 带宽限制 slider 0…1000 (→ RdBandwidthLimit),
                  缓冲区大小 dropdown (→ RdBufferSize); 启用网络加密 Strict-PQC / TLS 1.3
                  (LOCKED-STATUS).

  Wiring honesty: dropdowns use ComboBox + SelectedValue/SelectedValuePath="Tag" so the
  display label (e.g. "1080P (Full HD)") round-trips to the stored tag (e.g. "hd1080p") through
  the string coordinator property — no fabricated mapping. Resolution / frame-rate / 预设方案 use
  RadioButtons (a selectable card-style group, NOT <Button>) bound the same way. The 预设方案
  group is NOT bound to a (non-existent) preset key — its SelectionChanged handler in the
  code-behind applies a REAL multi-key combo to the existing coordinator props (the same combo the
  Mac applyPresetConfiguration applies). The 画质与性能 status header is a read-only computed block
  recalculated by the code-behind whenever resolution / fps / compression / hardware-accel /
  adaptive-bitrate change. OMIT-APPLE-ONLY rows render disabled with a "macOS 专属" caption;
  LOCKED-STATUS rows render as read-only status text. No <Button> anywhere — only ToggleSwitch /
  ComboBox / Slider / TextBlock / FontIcon / Border / RadioButtons (the gated 1/5/3 push-button
  surfaces stay frozen).

  DataContext inherits the SessionViewModel from SettingsView → MainWindow RootShell, so every
  {Binding Settings.<Prop>} resolves to the SettingsCoordinator.
-->
<UserControl
    x:Class="Skybridge.WinClient.Settings.SettingsRemoteDesktopView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12" Margin="0,0,0,14">

        <!-- ===================================================================
             SECTION 1 — 画质与性能 (Quality & Performance)
             =================================================================== -->
        <TextBlock
            Text="画质与性能"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="16">

                <!-- ============================================================
                     Status header — read-only computed config summary, optimal
                     badge, estimated transfer rate, and load tier. All four are
                     recomputed in the code-behind (UpdateStatusHeader) from the
                     live resolution · fps · compression · hardware-accel ·
                     adaptive-bitrate selection. No fabricated numbers: the rate
                     uses the same base × fps-multiplier × compression-ratio
                     formula as the Mac VideoTransferConfiguration.estimatedDataRate.
                     ============================================================ -->
                <Border
                    Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                    BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                    <StackPanel Spacing="8">

                        <!-- 当前配置 summary + 已优化 / 需调整 badge -->
                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="当前配置"
                                    FontSize="11"
                                    Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                                <TextBlock
                                    x:Name="ConfigSummaryText"
                                    Text="—"
                                    TextWrapping="Wrap"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            </StackPanel>
                            <Border
                                x:Name="StatusBadge"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                                BorderBrush="{StaticResource SkyBridgeSuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,4">
                                <TextBlock
                                    x:Name="StatusBadgeText"
                                    Text="已优化"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SkyBridgeSuccessBrush}" />
                            </Border>
                        </Grid>

                        <!-- 预估传输率 + 负载 tier -->
                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="预估传输率"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="EstimatedRateText"
                                    Text="0.0 MB/s"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource SkyBridgeAccentBrush}" />
                                <TextBlock
                                    x:Name="LoadTierText"
                                    Text="负载 低"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource SkyBridgeSuccessBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 预设方案 — SELECTABLE RadioButtons (平衡/高性能/高质量/低延迟). NOT a <Button>
                     group and NOT bound to a key; the SelectionChanged handler applies the real
                     Mac preset combo (resolution + frameRate + compression + adaptiveBitrate, with
                     hardware-accel on) to the existing coordinator props. -->
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="预设方案"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <RadioButtons
                        x:Name="PresetGroup"
                        MaxColumns="4"
                        SelectionChanged="OnPresetSelectionChanged">
                        <RadioButton Tag="balanced" Content="平衡" />
                        <RadioButton Tag="highPerformance" Content="高性能" />
                        <RadioButton Tag="highQuality" Content="高质量" />
                        <RadioButton Tag="lowLatency" Content="低延迟" />
                    </RadioButtons>
                    <TextBlock
                        Text="选择预设可一键套用分辨率 / 帧率 / 压缩质量 / 自适应比特率组合"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                </StackPanel>

                <!-- Resolution cards → VideoResolution (RadioButtons, selectable group) -->
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="分辨率"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <RadioButtons
                        MaxColumns="2"
                        SelectedValue="{Binding Settings.VideoResolution, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <RadioButton Tag="hd1080p" Content="1080P (Full HD)　1920×1080" />
                        <RadioButton Tag="qhd2k" Content="2K (QHD)　2560×1440" />
                        <RadioButton Tag="uhd4k" Content="4K (Ultra HD)　3840×2160" />
                        <RadioButton Tag="apple5k" Content="5K (Apple Retina)　5120×2880" />
                    </RadioButtons>
                </StackPanel>

                <!-- Frame-rate cards → VideoFrameRate (RadioButtons) -->
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="帧率"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <RadioButtons
                        MaxColumns="3"
                        SelectedValue="{Binding Settings.VideoFrameRate, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <RadioButton Tag="fps30" Content="30 fps" />
                        <RadioButton Tag="fps60" Content="60 fps" />
                        <RadioButton Tag="fps120" Content="120 fps" />
                    </RadioButtons>
                </StackPanel>

                <!-- 压缩质量 dropdown → VideoCompressionQuality -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="压缩质量"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="160"
                        SelectedValue="{Binding Settings.VideoCompressionQuality, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Tag="none" Content="无压缩" />
                        <ComboBoxItem Tag="fast" Content="快速压缩" />
                        <ComboBoxItem Tag="balanced" Content="平衡压缩" />
                        <ComboBoxItem Tag="maximum" Content="最大压缩" />
                    </ComboBox>
                </Grid>

                <!-- 启用硬件加速 toggle → EnableHardwareAcceleration -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="启用硬件加速"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.EnableHardwareAcceleration, Mode=TwoWay}" />
                </Grid>

                <!-- 自适应比特率 toggle → EnableAdaptiveBitrate -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="自适应比特率"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.EnableAdaptiveBitrate, Mode=TwoWay}" />
                </Grid>

                <!-- Apple Silicon 优化 — OMIT-APPLE-ONLY (disabled + macOS-only caption) -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="Apple Silicon 优化"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        <TextBlock
                            Text="macOS 专属"
                            FontSize="11"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="False"
                        IsEnabled="False" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================================================================
             SECTION 2 — 显示 (Display)
             =================================================================== -->
        <TextBlock
            Text="显示"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="16">

                <!-- 压缩级别 slider 1…100 step 1 → RdCompressionLevelDisplay -->
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="压缩级别"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Settings.RdCompressionLevelDisplay, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeAccentBrush}" />
                    </Grid>
                    <Slider
                        Minimum="1"
                        Maximum="100"
                        StepFrequency="1"
                        Value="{Binding Settings.RdCompressionLevelDisplay, Mode=TwoWay}" />
                </StackPanel>

                <!-- 全屏模式 toggle → RdFullScreenMode -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="全屏模式"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.RdFullScreenMode, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================================================================
             SECTION 3 — 交互 (Interaction)
             =================================================================== -->
        <TextBlock
            Text="交互"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="16">

                <!-- 启用剪贴板同步 toggle REAL-FULL → EnableClipboardSync -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="启用剪贴板同步"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.EnableClipboardSync, Mode=TwoWay}" />
                </Grid>

                <!-- 音频重定向 — LOCKED/unavailable ("暂不可用", Mac itself sanitizes off) -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="音频重定向"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        <TextBlock
                            Text="暂不可用"
                            FontSize="11"
                            Foreground="{StaticResource SkyBridgeWarningBrush}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="False"
                        IsEnabled="False" />
                </Grid>

                <!-- 启用文件传输 toggle → EnableRemoteFileTransfer -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="启用文件传输"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.EnableRemoteFileTransfer, Mode=TwoWay}" />
                </Grid>

                <!-- 触控板手势 — OMIT-APPLE-ONLY (no trackpad-gesture remoting on Windows) -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="触控板手势"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        <TextBlock
                            Text="macOS 专属"
                            FontSize="11"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="False"
                        IsEnabled="False" />
                </Grid>

                <!-- 鼠标灵敏度 slider 0.1…3.0 step 0.1 → MouseSensitivity -->
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="鼠标灵敏度"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Settings.MouseSensitivity, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeAccentBrush}" />
                    </Grid>
                    <Slider
                        Minimum="0.1"
                        Maximum="3.0"
                        StepFrequency="0.1"
                        Value="{Binding Settings.MouseSensitivity, Mode=TwoWay}" />
                </StackPanel>

                <!-- 双击间隔 slider 200…1000 step 50 (ms) → DoubleClickInterval -->
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="双击间隔"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Settings.DoubleClickInterval, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeAccentBrush}" />
                    </Grid>
                    <Slider
                        Minimum="200"
                        Maximum="1000"
                        StepFrequency="50"
                        Value="{Binding Settings.DoubleClickInterval, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===================================================================
             SECTION 4 — 网络优化 (Network optimization)
             =================================================================== -->
        <TextBlock
            Text="网络优化"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="16">

                <!-- 启用带宽自适应 toggle → RdEnableAdaptiveQuality -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="启用带宽自适应"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.RdEnableAdaptiveQuality, Mode=TwoWay}" />
                </Grid>

                <!-- 启用UDP传输 toggle → RdEnableUDPTransport -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="启用UDP传输"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.RdEnableUDPTransport, Mode=TwoWay}" />
                </Grid>

                <!-- 启用网络加密 — LOCKED-STATUS (Strict-PQC / TLS 1.3, force-on, read-only) -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="启用网络加密"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Strict-PQC / TLS 1.3"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SkyBridgeAccentSecondaryBrush}" />
                </Grid>

                <!-- 启用数据压缩 — 网络压缩级别 slider 0…9 step 1 → RdNetworkCompressionLevel -->
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Text="启用数据压缩"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            <TextBlock
                                Text="网络压缩级别　0=关闭　9=最大"
                                FontSize="11"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Settings.RdNetworkCompressionLevel, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeAccentBrush}" />
                    </Grid>
                    <Slider
                        Minimum="0"
                        Maximum="9"
                        StepFrequency="1"
                        Value="{Binding Settings.RdNetworkCompressionLevel, Mode=TwoWay}" />
                </StackPanel>

                <!-- 带宽限制 slider 0…1000 Mbps step 10 (0=不限) → RdBandwidthLimit -->
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="带宽限制 (Mbps)"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Settings.RdBandwidthLimit, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeAccentBrush}" />
                    </Grid>
                    <Slider
                        Minimum="0"
                        Maximum="1000"
                        StepFrequency="10"
                        Value="{Binding Settings.RdBandwidthLimit, Mode=TwoWay}" />
                </StackPanel>

                <!-- 缓冲区大小 dropdown → RdBufferSize (KB: 512/1024/2048/4096) -->
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="缓冲区大小"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="160"
                        SelectedValue="{Binding Settings.RdBufferSize, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="512 KB">
                            <ComboBoxItem.Tag>
                                <x:Int32>512</x:Int32>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="1 MB">
                            <ComboBoxItem.Tag>
                                <x:Int32>1024</x:Int32>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="2 MB">
                            <ComboBoxItem.Tag>
                                <x:Int32>2048</x:Int32>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="4 MB">
                            <ComboBoxItem.Tag>
                                <x:Int32>4096</x:Int32>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
