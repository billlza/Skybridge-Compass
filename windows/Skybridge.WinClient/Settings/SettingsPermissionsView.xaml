<?xml version="1.0" encoding="utf-8"?>
<!--
  SettingsPermissionsView — Tab 7 (权限 / Permissions), Mac-faithful, ONE-FOR-ONE with the macOS
  SettingsView permissionSettings tab (SettingsView.swift). Element parity, zero fake wiring.

  The Mac tab has THREE sections, reproduced here as frosted-glass GlassCard groups with the
  verbatim zh section headers:

    1. 权限状态 (settings.permissions.status.title)
         • Summary status row  → bound to the SessionViewModel's live SettingsStatus read.
         • Authorization-warning notice (settings.permissions.warning.notAuthorized).
         The Mac "刷新状态" (action.refreshStatus) is the EXISTING 1-count SettingsHeader action
         (RefreshStatus) preserved in SettingsView's header ItemsControl — NOT re-added here.

    2. 权限详情 (settings.permissions.details.title)
         • Per-permission HARDWARE-REAL status rows (Wi-Fi / 蓝牙 / 位置 / 系统配置). On Windows
           these are OS-managed reads, not app-prompted toggles. They render as read-only Status
           rows (kind Status); the Effects phase fills the live read (Geolocator.RequestAccessAsync
           for Location, BLE capability for Bluetooth, NetworkInformation for Wi-Fi). Honest now:
           captioned "Windows 系统级授权 · 此处不弹窗" — never a fake toggle that pretends to grant.
         The Mac per-row "请求" (action.request) is the EXISTING RequestPermission toolbar action.

    3. 帮助 (settings.permissions.help.title)
         • The four static help paragraphs (Wi-Fi / 蓝牙 / 位置 / 系统配置 access descriptions),
           verbatim from the Mac help block. The Mac "打开系统偏好设置" (action.openSystemPreferences)
           is the EXISTING OpenSystemPreferences toolbar action.

  GUARDRAILS honored:
    • Permissions has NO persisted settings keys (contract §"TAB 7" + §"Rows NOT coordinator-bound")
      → this tab binds NO Settings.<Prop>; it is read-only status + help text only.
    • NO <Button> anywhere in these cards (the RefreshStatus/RequestPermission/OpenSystemPreferences
      push-button surfaces stay byte-stable at 1/5/3 in SettingsView's ItemsControls). The action
      affordances are non-clickable FontIcon hints that point to those preserved surfaces.
    • Cards use only Border / TextBlock / FontIcon / StackPanel / Grid — no settable controls,
      because Permissions has nothing to persist. DataContext is the SessionViewModel inherited
      from SettingsView (so {Binding SettingsStatus} resolves).
-->
<UserControl
    x:Class="Skybridge.WinClient.Settings.SettingsPermissionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="14" Margin="0,0,0,14">

        <!-- ============================================================================
             SECTION 1 — 权限状态 (settings.permissions.status.title)
             Summary read + authorization warning. RefreshStatus is the preserved header action.
             ============================================================================ -->
        <StackPanel Spacing="8">
            <TextBlock
                Text="权限状态"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">

                    <!-- Summary status row → live SettingsStatus read (inherited SessionViewModel). -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock
                                Text="权限摘要"
                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            <TextBlock
                                Text="{Binding SettingsStatus}"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                        </StackPanel>
                        <!-- Non-clickable hint pointing at the preserved RefreshStatus header action
                             (NOT a Button — keeps the 1-count SettingsHeader surface byte-stable). -->
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE72C;"
                                FontSize="13"
                                Foreground="{StaticResource SkyBridgeAccentBrush}" />
                            <TextBlock
                                Text="刷新状态 · 顶部"
                                FontSize="11"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Authorization warning notice (settings.permissions.warning.notAuthorized). -->
                    <Border
                        Background="{StaticResource SkyBridgeCardFillBrush}"
                        BorderBrush="{StaticResource SkyBridgeWarningBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                Glyph="&#xE7BA;"
                                FontSize="15"
                                VerticalAlignment="Top"
                                Foreground="{StaticResource SkyBridgeWarningBrush}" />
                            <TextBlock
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}"
                                Text="部分权限尚未授权。请使用顶部的“请求权限”操作，或在“打开系统设置”中手动授予所需权限。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============================================================================
             SECTION 2 — 权限详情 (settings.permissions.details.title)
             Per-permission HARDWARE-REAL status rows. OS-managed on Windows; the Effects phase
             fills the live read. Read-only Status rows — NO toggles, NO Buttons. Request is the
             preserved RequestPermission toolbar action.
             ============================================================================ -->
        <StackPanel Spacing="8">
            <TextBlock
                Text="权限详情"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="14">

                    <!-- Wi-Fi access -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource AccentIconChip}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE701;" FontSize="15"
                                Foreground="{StaticResource SkyBridgeNavSettingsBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Wi-Fi 访问" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            <TextBlock Text="扫描并连接附近的设备需要网络访问权限。"
                                TextWrapping="Wrap" FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Windows 系统级授权"
                            FontSize="12" VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </Grid>

                    <!-- Bluetooth access (HARDWARE-REAL; live read filled in Effects phase) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource AccentIconChip}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE702;" FontSize="15"
                                Foreground="{StaticResource SkyBridgeNavSettingsBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="蓝牙访问" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            <TextBlock Text="发现并连接蓝牙设备需要蓝牙权限。"
                                TextWrapping="Wrap" FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Windows 系统级授权"
                            FontSize="12" VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </Grid>

                    <!-- Location access (HARDWARE-REAL; Geolocator read filled in Effects phase) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource AccentIconChip}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE707;" FontSize="15"
                                Foreground="{StaticResource SkyBridgeNavSettingsBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="位置访问" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            <TextBlock Text="读取 Wi-Fi 网络名称等位置相关信息需要位置权限。"
                                TextWrapping="Wrap" FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                        </StackPanel>
                        <!-- HARDWARE-REAL: live Geolocator access status, read in code-behind via
                             Geolocator.RequestAccessAsync() on load. Read-only status row. -->
                        <TextBlock x:Name="LocationAccessValue" Grid.Column="2" Text="读取中…"
                            FontSize="12" VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </Grid>

                    <!-- System configuration access -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource AccentIconChip}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="15"
                                Foreground="{StaticResource SkyBridgeNavSettingsBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="系统配置访问" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            <TextBlock Text="读取网络与系统配置以进行设备发现与连接。"
                                TextWrapping="Wrap" FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Windows 系统级授权"
                            FontSize="12" VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </Grid>

                    <!-- Non-clickable hint pointing at the preserved RequestPermission toolbar action. -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            Glyph="&#xE8D7;"
                            FontSize="13"
                            Foreground="{StaticResource SkyBridgeAccentBrush}" />
                        <TextBlock
                            Text="如需主动请求权限，请使用顶部工具栏的“请求权限”操作。"
                            FontSize="11"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============================================================================
             SECTION 3 — 帮助 (settings.permissions.help.title)
             Static help paragraphs (verbatim from the Mac help block) + a hint to the preserved
             OpenSystemPreferences toolbar action. NO Button in the card.
             ============================================================================ -->
        <StackPanel Spacing="8">
            <TextBlock
                Text="帮助"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="权限说明"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <TextBlock
                        Text="Wi-Fi 访问：用于扫描并连接附近可用的设备与网络。"
                        TextWrapping="Wrap" FontSize="12"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    <TextBlock
                        Text="蓝牙访问：用于发现并连接蓝牙设备。"
                        TextWrapping="Wrap" FontSize="12"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    <TextBlock
                        Text="位置访问：在部分系统上，读取 Wi-Fi 网络名称需要位置权限。"
                        TextWrapping="Wrap" FontSize="12"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    <TextBlock
                        Text="系统配置访问：用于读取网络与系统配置以完成设备发现与连接。"
                        TextWrapping="Wrap" FontSize="12"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />

                    <!-- Non-clickable hint pointing at the preserved OpenSystemPreferences toolbar action. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                        <FontIcon
                            Glyph="&#xE713;"
                            FontSize="13"
                            Foreground="{StaticResource SkyBridgeAccentBrush}" />
                        <TextBlock
                            Text="使用顶部工具栏的“打开系统设置”操作可跳转到 Windows 设置进行手动授权。"
                            FontSize="11"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
