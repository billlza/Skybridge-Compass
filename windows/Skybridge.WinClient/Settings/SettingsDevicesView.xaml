<?xml version="1.0" encoding="utf-8"?>
<!--
  SettingsDevicesView — Tab 3 (设备 / Devices), Mac-faithful ONE-FOR-ONE build.

  Element-matches the Mac SettingsView `deviceSettings` (Sources/SkyBridgeCore/Views/SettingsView.swift):
    • 蓝牙 (Bluetooth)        — HARDWARE-REAL status + count (Effects phase fills the live read),
                                a "扫描" ToggleSwitch (settable, NOT a button — surface-count safe),
                                自动连接已配对设备 / 显示设备RSSI / 仅显示可连接设备 toggles.
    • AirPlay                  — OMIT-APPLE-ONLY: every row DISABLED + captioned "macOS 专属",
                                never faked (Windows has no AirPlay).
    • 设备过滤与排序            — 隐藏离线设备 / 按信号强度排序 / 显示设备图标 toggles +
                                最小信号强度 slider (-100…-30 dBm).

  Wiring classes (per /tmp/sb-settings/plan.md §3 row '设备' + contract.md TAB 3):
    REAL-PERSIST  自动连接已配对设备           → Settings.AutoConnectPairedDevices
    REAL-FULL     显示设备RSSI                 → Settings.ShowDeviceRSSI
    REAL-FULL     仅显示可连接设备             → Settings.ShowConnectableDevicesOnly
    REAL-FULL     隐藏离线设备                 → Settings.HideOfflineDevices
    REAL-FULL     按信号强度排序               → Settings.SortBySignalStrength
    REAL-FULL     显示设备图标                 → Settings.ShowDeviceIcons
    REAL-FULL     最小信号强度 (-100…-30)      → Settings.MinimumSignalStrength
    HARDWARE-REAL 蓝牙状态 / 已发现数          → read-only Status rows (BluetoothLEAdvertisementWatcher;
                                                the Effects phase fills the live read — NOT a stored toggle,
                                                NOT coordinator-bound per contract).
    OMIT-APPLE-ONLY AirPlay 全部行             → disabled + "macOS 专属" caption.

  GUARDRAILS honored: cards contain ONLY ToggleSwitch / Slider / FontIcon / TextBlock / Border —
  NEVER a <Button> (the gated push-button surface counts stay 1/5/3). Bluetooth Start/Stop is a
  "扫描" ToggleSwitch (settable), not a button. DataContext is the SessionViewModel inherited from
  SettingsView, so {Binding Settings.<Prop>, Mode=TwoWay} resolves. The GlassCard style + SkyBridge*
  brushes come from the app-merged Themes dictionaries.
-->
<UserControl
    x:Class="Skybridge.WinClient.Settings.SettingsDevicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="14" Margin="0,0,0,14">

        <!-- =====================================================================
             蓝牙 (Bluetooth)
             ===================================================================== -->
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="14">
                <TextBlock
                    x:Uid="SettingsDevicesBluetoothHeader"
                    Text="蓝牙"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />

                <!-- HARDWARE-REAL status row — read-only. The live BluetoothLEAdvertisementWatcher
                     status is set in code-behind (Created / Started / Stopped / Aborted, or
                     "蓝牙不可用" when the radio/stack is absent). Never fakes a connection. -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Uid="SettingsDevicesBluetoothStatusLabel" Text="蓝牙状态" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            x:Uid="SettingsDevicesBluetoothStatusCaption"
                            Text="经 BluetoothLEAdvertisementWatcher 读取实时状态"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="BluetoothStatusValue"
                        x:Uid="SettingsDevicesBluetoothStatusValue"
                        Grid.Column="1"
                        Text="未扫描"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeWarningBrush}" />
                </Grid>

                <!-- HARDWARE-REAL discovered-count row — read-only. Live count of distinct BLE
                     advertisers seen since the scan started (set in code-behind). The trailing
                     value renders the Mac-faithful "已发现: <n> 设备" string
                     (settings.devices.bluetooth.discoveredCount = "已发现: %d 设备"). -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsDevicesBluetoothDiscoveredLabel"
                        Grid.Column="0"
                        Text="已发现设备数"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <TextBlock
                        x:Name="BluetoothDiscoveredCount"
                        x:Uid="SettingsDevicesBluetoothDiscoveredValue"
                        Grid.Column="1"
                        Text="已发现: 0 设备"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                </Grid>

                <!-- Start/Stop scan as a settable ToggleSwitch (NOT a button — surface-count safe).
                     Toggling it starts/stops a real BluetoothLEAdvertisementWatcher in code-behind;
                     the status + count rows above update live. -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Uid="SettingsDevicesScanLabel" Text="扫描蓝牙设备" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            x:Uid="SettingsDevicesScanCaption"
                            Text="开启后持续广播扫描（实时 BLE 广播扫描）"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="BluetoothScanToggle"
                        x:Uid="SettingsDevicesScanToggle"
                        Grid.Column="1"
                        Toggled="OnBluetoothScanToggled"
                        OnContent="扫描中"
                        OffContent="已停止"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- 自动连接已配对设备 → Settings.AutoConnectPairedDevices (REAL-PERSIST, default true) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsDevicesAutoConnectPaired"
                        Grid.Column="0"
                        Text="自动连接已配对设备"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.AutoConnectPairedDevices, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- 显示设备RSSI → Settings.ShowDeviceRSSI (REAL-FULL, default true) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsDevicesShowRSSI"
                        Grid.Column="0"
                        Text="显示设备RSSI"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.ShowDeviceRSSI, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- 仅显示可连接设备 → Settings.ShowConnectableDevicesOnly (REAL-FULL, default false) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsDevicesShowConnectableOnly"
                        Grid.Column="0"
                        Text="仅显示可连接设备"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.ShowConnectableDevicesOnly, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- =====================================================================
             AirPlay — OMIT-APPLE-ONLY: disabled rows, captioned "macOS 专属". Never faked.
             ===================================================================== -->
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="AirPlay"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    <Border
                        Grid.Column="1"
                        Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                        BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,3"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Uid="SettingsCommonMacOnly"
                            Text="macOS 专属"
                            FontSize="11"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </Border>
                </Grid>

                <TextBlock
                    x:Uid="SettingsDevicesAirPlayDescription"
                    Text="AirPlay 由 Apple 平台提供，Windows 端不可用，因此以下选项不予仿造。"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SkyBridgeTextMutedBrush}" />

                <!-- AirPlay 状态 — disabled status -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsDevicesAirPlayStatusLabel"
                        Grid.Column="0"
                        Text="AirPlay 状态"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    <TextBlock
                        x:Uid="SettingsCommonMacOnly"
                        Grid.Column="1"
                        Text="macOS 专属"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                </Grid>

                <!-- 自动发现Apple TV — disabled toggle -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsDevicesAirPlayAutoDiscover"
                        Grid.Column="0"
                        Text="自动发现Apple TV"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="False"
                        IsEnabled="False"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- 显示HomePod设备 — disabled toggle -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsDevicesAirPlayShowHomePod"
                        Grid.Column="0"
                        Text="显示HomePod设备"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="False"
                        IsEnabled="False"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- 显示第三方AirPlay设备 — disabled toggle -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsDevicesAirPlayShowThirdParty"
                        Grid.Column="0"
                        Text="显示第三方AirPlay设备"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="False"
                        IsEnabled="False"
                        VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- =====================================================================
             设备过滤与排序 (Device filters & sorting)
             ===================================================================== -->
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="14">
                <TextBlock
                    x:Uid="SettingsDevicesFiltersHeader"
                    Text="设备过滤与排序"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />

                <!-- 隐藏离线设备 → Settings.HideOfflineDevices (REAL-FULL, default false) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsDevicesHideOffline"
                        Grid.Column="0"
                        Text="隐藏离线设备"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.HideOfflineDevices, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- 按信号强度排序 → Settings.SortBySignalStrength (REAL-FULL, default true) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsDevicesSortBySignal"
                        Grid.Column="0"
                        Text="按信号强度排序"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.SortBySignalStrength, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- 显示设备图标 → Settings.ShowDeviceIcons (REAL-FULL, default true) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsDevicesShowIcons"
                        Grid.Column="0"
                        Text="显示设备图标"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        IsOn="{Binding Settings.ShowDeviceIcons, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- 最小信号强度 slider (-100…-30 dBm) → Settings.MinimumSignalStrength
                     (REAL-FULL, default -80.0). Value label + unit render the live dBm. -->
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="SettingsDevicesMinSignalStrength"
                            Grid.Column="0"
                            Text="最小信号强度"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding Settings.MinimumSignalStrength, Mode=OneWay}"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            <TextBlock
                                Text=" dBm"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Slider
                        Minimum="-100"
                        Maximum="-30"
                        StepFrequency="1"
                        Value="{Binding Settings.MinimumSignalStrength, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
