<?xml version="1.0" encoding="utf-8"?>
<!--
  SettingsFileTransferView — Tab 4 (文件传输 / File Transfer).

  Mac-faithful, one-for-one with the macOS SettingsView `fileTransferSettings` tab
  (Sources/SkyBridgeCore/Views/SettingsView.swift). Three frosted-glass section cards
  reusing the GlassCard style, with the verbatim zh section headers:

    • 传输配置  — 默认接收路径 (TextBox + inline folder-picker FontIcon, code-behind,
                  NOT a gated push-button) · 最大并发传输数 (Slider) · 分片大小 (ComboBox
                  64KB…1MB) · 传输速率限制 (Slider 0…500 step 5, value label).
    • 传输选项  — 显示传输通知 · 断点续传 · 保留传输历史 · 传输时保持唤醒 (Toggles) ·
                  重试次数 (TextBox numeric).
    • 安全      — 加密 (LOCKED-STATUS, 始终开启 read-only) · 证书校验 (LOCKED-STATUS,
                  始终开启 read-only) · 传输前病毒扫描 (Toggle) · 扫描级别 (ComboBox,
                  disabled unless virus-scan on) · 加密算法 AES-256-GCM (LOCKED-STATUS,
                  read-only).

  Every interactive control is two-way bound to Settings.<Prop> on the SessionViewModel's
  SettingsCoordinator (DataContext inherited from SettingsView). Cards contain ONLY
  ToggleSwitch / ComboBox / Slider / TextBox / FontIcon / TextBlock / Border — never a
  <Button> (the frozen 1/5/3 push-button surface lives in SettingsView's action ItemsControls).
  The "Apply" action on the Mac maps to the existing ApplySettings maintenance action in
  SettingsView, not a button here.

  Honest handling: the Mac "启用传输加密" toggle + "证书校验恒为开" notice + "加密算法
  (AES-256-GCM)" row are all force-locked on macOS (verifyCertificates reverts to true,
  only AES-256-GCM is constructible). There is NO settable EnableConnectionEncryption /
  certificate / algorithm key in the Windows contract — they render as read-only
  LOCKED-STATUS rows here, never a dead toggle.
-->
<UserControl
    x:Class="Skybridge.WinClient.Settings.SettingsFileTransferView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Skybridge.WinClient.Settings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Slider value-label formatters (declared here so this view stays self-contained;
             every converter resolves to a real class in SettingsFileTransferView.xaml.cs). -->
        <local:CountLabelConverter x:Key="CountLabelConverter" />
        <local:RateLimitLabelConverter x:Key="RateLimitLabelConverter" />
    </UserControl.Resources>

    <StackPanel Spacing="14" Margin="0,0,0,14">

        <!-- Tab title -->
        <TextBlock
            x:Uid="SettingsFileTransferTabTitle"
            Text="文件传输 File Transfer"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />

        <!-- ============================ 传输配置 (config) ============================ -->
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="14">
                <TextBlock
                    x:Uid="SettingsFileTransferConfigHeader"
                    Text="传输配置"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />

                <!-- 默认接收路径 → Settings.DefaultTransferPath (REAL-FULL). TextBox + inline
                     clickable folder-picker FontIcon (code-behind), NOT a <Button>. -->
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Uid="SettingsFileTransferDefaultPathLabel"
                        Text="默认接收路径"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            x:Uid="SettingsFileTransferDefaultPathBox"
                            Text="{Binding Settings.DefaultTransferPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="路径"
                            VerticalAlignment="Center" />
                        <!-- Inline folder-picker affordance: a tappable Border+FontIcon (not a
                             push-button). Tapped handler opens a FolderPicker in code-behind and
                             writes Settings.DefaultTransferPath. -->
                        <Border
                            Grid.Column="1"
                            x:Name="SelectFolderAffordance"
                            x:Uid="SettingsFileTransferSelectFolderAffordance"
                            Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                            BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                            Width="40"
                            Height="34"
                            Tapped="OnSelectFolderTapped"
                            ToolTipService.ToolTip="选择文件夹">
                            <FontIcon
                                Glyph="&#xE838;"
                                FontSize="15"
                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock
                        x:Uid="SettingsFileTransferDefaultPathCaption"
                        Text="接收的文件将保存到此位置"
                        FontSize="11"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                </StackPanel>

                <!-- 最大并发传输数 → Settings.MaxConcurrentConnections (REAL-PERSIST, 1…20). -->
                <StackPanel Spacing="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="SettingsFileTransferMaxConcurrentLabel"
                            Text="最大并发传输数"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Settings.MaxConcurrentConnections, Converter={StaticResource CountLabelConverter}}"
                            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    </Grid>
                    <Slider
                        Minimum="1"
                        Maximum="20"
                        StepFrequency="1"
                        Value="{Binding Settings.MaxConcurrentConnections, Mode=TwoWay}" />
                </StackPanel>

                <!-- 分片大小 → Settings.TransferBufferSize (REAL-PERSIST). 64KB…1MB, int byte
                     values as tags (65536…1048576). -->
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Uid="SettingsFileTransferChunkSizeLabel"
                        Text="分片大小"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        SelectedValuePath="Tag"
                        SelectedValue="{Binding Settings.TransferBufferSize, Mode=TwoWay}">
                        <ComboBoxItem Content="64 KB">
                            <ComboBoxItem.Tag>
                                <x:Int32>65536</x:Int32>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="128 KB">
                            <ComboBoxItem.Tag>
                                <x:Int32>131072</x:Int32>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="256 KB">
                            <ComboBoxItem.Tag>
                                <x:Int32>262144</x:Int32>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="512 KB">
                            <ComboBoxItem.Tag>
                                <x:Int32>524288</x:Int32>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="1 MB">
                            <ComboBoxItem.Tag>
                                <x:Int32>1048576</x:Int32>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- 传输速率限制 → Settings.TransferSpeedLimitMBps (REAL-PERSIST, 0…500 step 5).
                     0 shows as 不限速, else "%.0f MB/s". -->
                <StackPanel Spacing="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="SettingsFileTransferRateLimitLabel"
                            Text="传输速率限制"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Settings.TransferSpeedLimitMBps, Converter={StaticResource RateLimitLabelConverter}}"
                            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    </Grid>
                    <Slider
                        Minimum="0"
                        Maximum="500"
                        StepFrequency="5"
                        Value="{Binding Settings.TransferSpeedLimitMBps, Mode=TwoWay}" />
                </StackPanel>

                <!-- 预计吞吐 — REAL computed read-only status row. The value is derived in code-behind
                     from the ACTUAL selected 传输速率限制 (TransferSpeedLimitMBps), 最大并发传输数
                     (MaxConcurrentConnections), and 分片大小 (TransferBufferSize) — no fabricated
                     numbers. It recomputes whenever any of those three coordinator props change. When
                     the rate limit is 0 (unlimited) it honestly reports "受网络与磁盘限制" instead of
                     inventing a throughput figure. NOT a stored setting — pure computed display. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            x:Uid="SettingsFileTransferEstimatedThroughputLabel"
                            Text="预计吞吐"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            x:Uid="SettingsFileTransferEstimatedThroughputCaption"
                            Text="按当前速率限制 · 并发数 · 分片大小估算"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        x:Name="EstimatedRateValue"
                        x:Uid="SettingsFileTransferEstimatedRateValue"
                        Text="受网络与磁盘限制"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================ 传输选项 (options) ============================ -->
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Uid="SettingsFileTransferOptionsHeader"
                    Text="传输选项"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />

                <!-- 传输完成后显示通知 → Settings.ShowFileTransferNotifications (REAL-PERSIST) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsFileTransferShowNotificationsLabel"
                        Text="传输完成后显示通知"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.ShowFileTransferNotifications, Mode=TwoWay}" />
                </Grid>

                <!-- 启用断点续传（失败自动重试）→ Settings.AutoRetryFailedTransfers (REAL-PERSIST) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsFileTransferAutoRetryLabel"
                        Text="启用断点续传（失败自动重试）"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.AutoRetryFailedTransfers, Mode=TwoWay}" />
                </Grid>

                <!-- 保持传输历史记录 → Settings.KeepTransferHistory (REAL-PERSIST) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsFileTransferKeepHistoryLabel"
                        Text="保持传输历史记录"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.KeepTransferHistory, Mode=TwoWay}" />
                </Grid>

                <!-- 清除传输历史记录 — REAL action affordance (tappable Border + FontIcon, NOT a
                     <Button>, preserving the frozen 1/5/3 push-button surfaces). On tap it clears the
                     REAL in-memory FileTransferHistory ObservableCollection on the SessionViewModel
                     (via coordinator.ClearTransferHistory()) and reports the cleared count back into
                     ClearHistoryStatusText. No fabricated data — it empties the live history buffer
                     the 文件传输 history list binds to. Disabled-looking dim state when nothing to clear. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            x:Uid="SettingsCommonClearTransferHistory"
                            Text="清除传输历史记录"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            x:Name="ClearHistoryStatusText"
                            x:Uid="SettingsFileTransferClearHistoryStatus"
                            Text="清空当前会话已记录的传输条目"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        x:Name="ClearHistoryAffordance"
                        x:Uid="SettingsFileTransferClearHistoryAffordance"
                        Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                        BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Tapped="OnClearTransferHistoryTapped"
                        ToolTipService.ToolTip="清除传输历史记录">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                Glyph="&#xE74D;"
                                FontSize="13"
                                Foreground="{StaticResource SkyBridgeAccentBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Uid="SettingsFileTransferClearHistoryButtonText"
                                Text="清除"
                                FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 传输时保持唤醒 → Settings.KeepSystemAwakeDuringTransfer. The preference flips a
                     real keep-awake gate (WindowsPowerKeepAwake / SetThreadExecutionState) that an
                     active transfer wraps itself in. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            x:Uid="SettingsFileTransferKeepAwakeLabel"
                            Text="传输时保持系统唤醒"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            x:Uid="SettingsFileTransferKeepAwakeCaption"
                            Text="仅在文件传输进行时阻止系统休眠"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.KeepSystemAwakeDuringTransfer, Mode=TwoWay}" />
                </Grid>

                <!-- 重试次数 → Settings.RetryCount (REAL-PERSIST, shared key; numeric TextBox) -->
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Uid="SettingsCommonRetryCount"
                        Text="重试次数"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <TextBox
                        x:Uid="SettingsFileTransferRetryCountBox"
                        Text="{Binding Settings.RetryCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="次"
                        InputScope="Number"
                        MaxLength="2"
                        HorizontalAlignment="Left"
                        Width="120" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============================ 安全 (security) ============================ -->
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Uid="SettingsFileTransferSecurityHeader"
                    Text="安全"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />

                <!-- 传输加密 → LOCKED-STATUS. Force-on on macOS (no settable key in the Windows
                     contract). Read-only status row, never a dead toggle. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="SettingsFileTransferEncryptionLabel"
                            Text="启用传输加密"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            x:Uid="SettingsFileTransferEncryptionCaption"
                            Text="始终开启（不可关闭）"
                            FontSize="11"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                        BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                Glyph="&#xE72E;"
                                FontSize="12"
                                Foreground="{StaticResource SkyBridgeAccentBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Uid="SettingsCommonAlwaysOn"
                                Text="始终开启"
                                FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 证书校验 → LOCKED-STATUS. verifyCertificates force-locked true on macOS. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="SettingsFileTransferCertVerifyLabel"
                            Text="证书校验"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            x:Uid="SettingsFileTransferCertVerifyCaption"
                            Text="始终校验服务器证书以防中间人攻击"
                            FontSize="11"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                        BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                Glyph="&#xE72E;"
                                FontSize="12"
                                Foreground="{StaticResource SkyBridgeAccentBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Uid="SettingsCommonAlwaysOn"
                                Text="始终开启"
                                FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 传输前病毒扫描 → Settings.ScanTransferFilesForVirus. PERSIST-ONLY: this build
                     bundles no antivirus engine; the preference persists and a scan would route to
                     Windows Defender (MpCmdRun) where present. Honest caption discloses this. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            x:Uid="SettingsFileTransferVirusScanLabel"
                            Text="扫描传输文件病毒"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            x:Uid="SettingsFileTransferVirusScanCaption"
                            Text="需要 Windows Defender — 本应用未内置杀毒引擎，偏好已保存"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.ScanTransferFilesForVirus, Mode=TwoWay}" />
                </Grid>

                <!-- 扫描级别 → Settings.ScanLevel (REAL-PERSIST). Disabled unless virus-scan on,
                     mirroring the Mac .disabled gate. quick / standard / deep. -->
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Uid="SettingsFileTransferScanLevelLabel"
                        Text="扫描级别"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding Settings.ScanTransferFilesForVirus}"
                        SelectedValuePath="Tag"
                        SelectedValue="{Binding Settings.ScanLevel, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="SettingsFileTransferScanLevelQuick" Content="快速" Tag="quick" />
                        <ComboBoxItem x:Uid="SettingsFileTransferScanLevelStandard" Content="标准" Tag="standard" />
                        <ComboBoxItem x:Uid="SettingsFileTransferScanLevelDeep" Content="深度" Tag="deep" />
                    </ComboBox>
                </StackPanel>

                <!-- 加密算法 → LOCKED-STATUS. Only AES-256-GCM is constructible on macOS. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="SettingsFileTransferEncryptionAlgorithmLabel"
                            Text="加密算法"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            x:Uid="SettingsFileTransferEncryptionAlgorithmCaption"
                            Text="对称加密套件（固定）"
                            FontSize="11"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Text="AES-256-GCM"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
