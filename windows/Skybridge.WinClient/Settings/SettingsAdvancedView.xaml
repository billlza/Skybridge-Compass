<?xml version="1.0" encoding="utf-8"?>
<!--
  SettingsAdvancedView — Tab 8 (高级 / Advanced).

  Element-for-element parity with the Mac SettingsView `advancedSettings` tab
  (Sources/SkyBridgeCore/Views/SettingsView.swift). Every control the Mac tab has is built here
  ONE FOR ONE inside frosted-glass section cards (GlassCard) with the verbatim zh section headers.

  Sections (Mac order):
    • 调试 Debug         — 详细日志 (Toggle, REAL-FULL) / 显示调试信息 (Toggle, REAL-PERSIST) /
                           保存网络日志 (Toggle, REAL-FULL) / 日志级别 (ComboBox, REAL-FULL).
    • 性能 Performance    — 性能模式 (ComboBox, REAL-PERSIST) / 启用实时天气 (Toggle, REAL-FULL) +
                           status text / 显示实时FPS (Toggle) / 硬件加速 (Toggle) / 优化内存 (Toggle) /
                           后台扫描 (Toggle) / 最大并发连接 (TextBox numeric). Metal HUD sub-block is
                           OMIT-APPLE-ONLY (disabled, "macOS 专属").
    • 实验性功能 Experimental — IPv6 (Toggle) / 新发现算法 (Toggle) / P2P直连 (Toggle) + warning text.
    • 后量子密码 PQC      — 启用应用层PQC (LOCKED-STATUS) / 混合TLS (LOCKED-STATUS) /
                           优先X-Wing混合 (Toggle, REAL-PERSIST) / 签名算法 (ComboBox ML-DSA-65/87,
                           REAL-PERSIST) / Secure Enclave ML-DSA (OMIT-APPLE-ONLY) /
                           ML-KEM 密钥协商 (LOCKED-STATUS) + note.
    • 信号平滑 Signal Smoothing — EMA系数 alpha (Slider 0.10…0.95 step 0.05, REAL-FULL).
    • 重置 Reset          — guidance text pointing at the existing Settings maintenance/toolbar
                           actions (重置全部/重置 → RestoreDefaults). NO <Button> in a card surface
                           (the gated 1/5/3 push-button counts stay frozen).

  Controls in this card surface are ONLY ToggleSwitch / ComboBox / Slider / TextBox / FontIcon /
  TextBlock / Border — never a <Button> (verify-windows-ui-action-order.ps1:170-172). Interactive
  rows are two-way bound to {Binding Settings.<Prop>, Mode=TwoWay} on the SettingsCoordinator
  (exposed as SessionViewModel.Settings). LOCKED-STATUS rows render read-only status text; the
  OMIT-APPLE-ONLY rows render DISABLED with a "macOS 专属" caption — never faked.

  DataContext inherits the SessionViewModel from SettingsView (which inherits it from MainWindow's
  RootShell), so every {Binding Settings.<Prop>} resolves to a real SettingsCoordinator property.
-->
<UserControl
    x:Class="Skybridge.WinClient.Settings.SettingsAdvancedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="14" Margin="0,0,0,14">

        <TextBlock
            x:Uid="SettingsAdvancedPageHeader"
            Text="高级 Advanced"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />

        <!-- ============================ 调试 Debug ============================ -->
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="14">
                <TextBlock
                    x:Uid="SettingsAdvancedDebugHeader"
                    Text="调试"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />

                <!-- 启用详细日志 — REAL-FULL → SkyBridgeLogger.minimumLogLevel -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedVerboseLoggingLabel"
                        Text="启用详细日志"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.EnableVerboseLogging, Mode=TwoWay}"
                        HorizontalAlignment="Right" />
                </Grid>

                <!-- 显示调试信息 — REAL-PERSIST -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedShowDebugInfoLabel"
                        Text="显示调试信息"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.ShowDebugInfo, Mode=TwoWay}"
                        HorizontalAlignment="Right" />
                </Grid>

                <!-- 保存网络日志 — REAL-FULL → NetworkActivityLogStore.setEnabled -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedSaveNetworkLogsLabel"
                        Text="保存网络日志"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.SaveNetworkLogs, Mode=TwoWay}"
                        HorizontalAlignment="Right" />
                </Grid>

                <!-- 日志级别 — REAL-FULL → applyLoggingRuntimeSettings. Options literal Error/Warning/Info/Debug -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedLogLevelLabel"
                        Text="日志级别"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="160"
                        HorizontalAlignment="Right"
                        SelectedValue="{Binding Settings.LogLevel, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Tag="Error" Content="Error" />
                        <ComboBoxItem Tag="Warning" Content="Warning" />
                        <ComboBoxItem Tag="Info" Content="Info" />
                        <ComboBoxItem Tag="Debug" Content="Debug" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================ 性能 Performance ============================ -->
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="14">
                <TextBlock
                    x:Uid="SettingsAdvancedPerformanceHeader"
                    Text="性能"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />

                <!-- 渲染性能模式 — REAL-PERSIST → SystemOrchestrator.reloadProfile. Mac enum 极致/平衡/节能.
                     Mac label was "性能模式 (MetalFX)"; MetalFX is an Apple-only upscaler so the
                     parenthetical is dropped on Windows — the render-mode control itself is kept. -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedRenderModeLabel"
                        Text="渲染性能模式"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="160"
                        HorizontalAlignment="Right"
                        SelectedValue="{Binding Settings.PerformanceMode, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem x:Uid="SettingsAdvancedRenderModeExtreme" Tag="extreme" Content="极致" />
                        <ComboBoxItem x:Uid="SettingsCommonBalanced" Tag="balanced" Content="平衡" />
                        <ComboBoxItem x:Uid="SettingsAdvancedRenderModePowerSaving" Tag="powerSaving" Content="节能" />
                    </ComboBox>
                </Grid>

                <!-- 启用实时天气 — REAL-FULL → WeatherStateCoordinator gate -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="SettingsAdvancedRealTimeWeatherLabel"
                            Text="启用实时天气"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            x:Uid="SettingsAdvancedRealTimeWeatherCaption"
                            Text="启用后顶部栏与仪表盘显示实时天气数据"
                            FontSize="11"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.EnableRealTimeWeather, Mode=TwoWay}"
                        HorizontalAlignment="Right" />
                </Grid>

                <!-- 显示实时FPS — REAL-PERSIST → top-bar FPS pill -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedShowRealtimeFpsLabel"
                        Text="显示实时FPS"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.ShowRealtimeFPS, Mode=TwoWay}"
                        HorizontalAlignment="Right" />
                </Grid>

                <!-- 硬件加速 — REAL-PERSIST → RemoteDesktopSettings hardware acceleration -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedHardwareAccelLabel"
                        Text="硬件加速"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.EnableHardwareAccelerationGlobal, Mode=TwoWay}"
                        HorizontalAlignment="Right" />
                </Grid>

                <!-- 优化内存 — REAL-PERSIST -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedOptimizeMemoryLabel"
                        Text="优化内存使用"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.OptimizeMemoryUsage, Mode=TwoWay}"
                        HorizontalAlignment="Right" />
                </Grid>

                <!-- 后台扫描 — REAL-PERSIST -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedBackgroundScanLabel"
                        Text="后台扫描"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.EnableBackgroundScanning, Mode=TwoWay}"
                        HorizontalAlignment="Right" />
                </Grid>

                <!-- 最大并发连接 — REAL-PERSIST (shared key). Numeric TextBox -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedMaxConcurrentLabel"
                        Text="最大并发连接"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <TextBox
                        x:Uid="SettingsAdvancedMaxConcurrentInput"
                        Grid.Column="1"
                        MinWidth="120"
                        HorizontalAlignment="Right"
                        InputScope="Number"
                        PlaceholderText="个"
                        Text="{Binding Settings.MaxConcurrentConnections, Mode=TwoWay}" />
                </Grid>

                <!-- Metal Performance HUD — OMIT-APPLE-ONLY (Metal is Apple) -->
                <Border
                    Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                    BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE950;"
                            FontSize="16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                x:Uid="SettingsAdvancedMetalHudLabel"
                                Text="Metal 性能 HUD"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            <TextBlock
                                x:Uid="SettingsAdvancedMetalHudCaption"
                                Text="macOS 专属 · Metal 为 Apple 平台技术"
                                FontSize="11"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            IsEnabled="False"
                            IsOn="False"
                            HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============================ 实验性功能 Experimental ============================ -->
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="14">
                <TextBlock
                    x:Uid="SettingsAdvancedExperimentalHeader"
                    Text="实验性功能"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />

                <!-- IPv6 — REAL-PERSIST → discovery reapply -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedIPv6Label"
                        Text="启用 IPv6 支持"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.EnableIPv6Support, Mode=TwoWay}"
                        HorizontalAlignment="Right" />
                </Grid>

                <!-- 新发现算法 — REAL-PERSIST → discovery restart -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedNewDiscoveryLabel"
                        Text="使用新的发现算法"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.UseNewDiscoveryAlgorithm, Mode=TwoWay}"
                        HorizontalAlignment="Right" />
                </Grid>

                <!-- P2P直连 — REAL-PERSIST -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedP2PDirectLabel"
                        Text="启用P2P直连"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.EnableP2PDirectConnection, Mode=TwoWay}"
                        HorizontalAlignment="Right" />
                </Grid>

                <!-- Warning -->
                <Border
                    Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                    BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE7BA;"
                            FontSize="14"
                            VerticalAlignment="Top"
                            Foreground="{StaticResource SkyBridgeWarningBrush}" />
                        <TextBlock
                            x:Uid="SettingsAdvancedExperimentalWarning"
                            Grid.Column="1"
                            Text="实验性功能可能不稳定，启用后如遇异常请关闭。"
                            TextWrapping="Wrap"
                            FontSize="11"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============================ 后量子密码 PQC ============================ -->
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="14">
                <TextBlock
                    x:Uid="SettingsAdvancedPqcHeader"
                    Text="后量子密码 PQC"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />

                <!-- 启用应用层PQC — LOCKED-STATUS (force-on, read-only) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="SettingsAdvancedAppPqcLabel"
                            Text="启用后量子密码（应用层）"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            x:Uid="SettingsAdvancedAppPqcCaption"
                            Text="策略强制启用"
                            FontSize="11"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="SettingsAdvancedAppPqcStatus"
                        Grid.Column="1"
                        Text="已启用"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SkyBridgeSuccessBrush}" />
                </Grid>

                <!-- 混合TLS — LOCKED-STATUS (honest status text) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedHybridTlsLabel"
                        Text="启用TLS混合协商（系统支持时）"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <TextBlock
                        x:Uid="SettingsAdvancedHybridTlsStatus"
                        Grid.Column="1"
                        Text="由系统自动协商"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                </Grid>

                <!-- 优先X-Wing混合 — REAL-PERSIST → crypto suite negotiation priority -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="SettingsAdvancedPreferXWingLabel"
                            Text="优先 X-Wing 混合套件"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            x:Uid="SettingsAdvancedPreferXWingCaption"
                            Text="影响后量子密钥协商套件的优先级"
                            FontSize="11"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        IsOn="{Binding Settings.PreferXWingHybrid, Mode=TwoWay}"
                        HorizontalAlignment="Right" />
                </Grid>

                <!-- 签名算法 — REAL-PERSIST. Options literal ML-DSA-65 / ML-DSA-87 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedSignatureAlgorithmLabel"
                        Text="签名算法"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="160"
                        HorizontalAlignment="Right"
                        SelectedValue="{Binding Settings.PqcSignatureAlgorithm, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Tag="ML-DSA-65" Content="ML-DSA-65" />
                        <ComboBoxItem Tag="ML-DSA-87" Content="ML-DSA-87" />
                    </ComboBox>
                </Grid>

                <!-- Secure Enclave ML-DSA — OMIT-APPLE-ONLY (no Secure Enclave on Windows) -->
                <Border
                    Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                    BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE72E;"
                            FontSize="16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                Text="Secure Enclave ML-DSA"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            <TextBlock
                                x:Uid="SettingsAdvancedSecureEnclaveCaption"
                                Text="macOS 专属 · Windows 无 Secure Enclave"
                                FontSize="11"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            IsEnabled="False"
                            IsOn="False"
                            HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- ML-KEM 密钥协商 — LOCKED-STATUS (read-only) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="SettingsAdvancedMlKemLabel"
                        Text="ML-KEM 密钥协商"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                    <TextBlock
                        x:Uid="SettingsAdvancedMlKemStatus"
                        Grid.Column="1"
                        Text="X-Wing 混合 · 软件 · 临时会话密钥"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                </Grid>

                <!-- Note -->
                <TextBlock
                    x:Uid="SettingsAdvancedPqcNote"
                    Text="后量子密码套件由策略强制启用，混合密钥协商在两端均支持 X-Wing 时优先采用。"
                    TextWrapping="Wrap"
                    FontSize="11"
                    Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- ============================ 信号平滑 Signal Smoothing ============================ -->
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="14">
                <TextBlock
                    x:Uid="SettingsAdvancedSmoothingHeader"
                    Text="信号平滑"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />

                <!-- EMA系数 alpha — REAL-FULL → DD signal smoother. Range 0.10…0.95 step 0.05 -->
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="SettingsAdvancedEmaAlphaLabel"
                            Text="强度平滑系数 (EMA)"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Settings.SignalStrengthAlpha, Mode=OneWay}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    </Grid>
                    <Slider
                        Minimum="0.10"
                        Maximum="0.95"
                        StepFrequency="0.05"
                        SmallChange="0.05"
                        LargeChange="0.10"
                        Value="{Binding Settings.SignalStrengthAlpha, Mode=TwoWay}" />
                    <TextBlock
                        x:Uid="SettingsAdvancedEmaAlphaCaption"
                        Text="数值越大对最新采样越敏感，越小越平滑。"
                        FontSize="11"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============================ 重置 Reset ============================ -->
        <!-- The Mac tab has 重置全部设置 / 重置网络设置 push-buttons. On Windows these live in the
             frozen Settings maintenance/toolbar push-button surface (RestoreDefaults / Reset),
             whose 1/5/3 counts are gate-locked — a card MUST NOT contain a <Button>. So this card
             honestly points the user at those existing actions rather than faking a dead button. -->
        <Border Style="{StaticResource GlassCard}">
            <StackPanel Spacing="10">
                <TextBlock
                    x:Uid="SettingsAdvancedResetHeader"
                    Text="重置"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="&#xE777;"
                        FontSize="14"
                        VerticalAlignment="Top"
                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                    <TextBlock
                        x:Uid="SettingsAdvancedResetGuidance"
                        Grid.Column="1"
                        Text="使用上方设置工具栏的“重置 / 恢复默认”按钮可将全部设置恢复为默认值。"
                        TextWrapping="Wrap"
                        FontSize="11"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                </Grid>
                <TextBlock
                    x:Uid="SettingsAdvancedResetWarning"
                    Text="重置操作不可撤销，将清除你的全部自定义设置。"
                    TextWrapping="Wrap"
                    FontSize="11"
                    Foreground="{StaticResource SkyBridgeWarningBrush}" />
            </StackPanel>
        </Border>

