<?xml version="1.0" encoding="utf-8"?>
<!--
  SettingsGeneralView — Tab 1 (通用 / General), Mac-faithful, one-for-one.

  Mirrors the Mac SettingsView 通用 tab (SettingsView.swift, generalSettings) section-for-section,
  control-for-control. Every interactive control is TWO-WAY bound to the SettingsCoordinator that
  the SessionViewModel exposes as `Settings` ({Binding Settings.<Prop>, Mode=TwoWay}); DataContext is
  the SessionViewModel inherited from SettingsView (which inherits it from MainWindow's RootShell),
  so each binding resolves. The coordinator write-throughs to SettingsService → debounced JSON at
  %LOCALAPPDATA%\SkyBridge\settings.json (no fake/dead controls — every toggle/dropdown persists).

  Sections (verbatim zh headers from the Mac tab):
    • 语言            — Language dropdown (system / 简体中文 / English) → Settings.Language
    • 偏好设置        — 启动时自动扫描设备 / 显示系统通知 / 启用深色模式 / 扫描间隔
    • 界面            — 显示设备详细信息 / 显示连接统计 / 紧凑模式 / 主题颜色 (swatch picker)
    • 数据管理        — 清除缓存 (frosted clickable Border + Tapped → code-behind: deletes the real
                        %LOCALAPPDATA%\SkyBridge\cache* dir + refreshes the live 当前缓存：<size>
                        readout) ; Export/Import/Reset live in the frozen SettingsToolbar above (honest
                        pointer, not duplicated as buttons here); 清理重复的钥匙串项 is OMIT-APPLE-ONLY.

  GUARDRAILS: cards contain ONLY ToggleSwitch / ComboBox / TextBlock / Border / FontIcon — never a
  <Button> (the gated push-button surface counts stay frozen; Export/Import/Reset are the existing
  toolbar/maintenance actions, not re-added here; 清除缓存 is a Tapped Border doing real work in
  code-behind, exactly like the FileTransfer folder-picker affordance — NOT a push-button). Dropdowns
  two-way-bind via
  SelectedValue + SelectedValuePath="Tag"; the int 扫描间隔 uses typed x:Int32 tags so SelectedValue
  round-trips as an int straight onto Settings.ScanInterval. The 主题颜色 swatch row binds its
  SelectedValue (a hex string Tag) onto Settings.ThemeColorHex.
-->
<UserControl
    x:Class="Skybridge.WinClient.Settings.SettingsGeneralView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="14" Margin="0,0,0,14">

        <!-- =====================================================================
             语言  (Language)
             ===================================================================== -->
        <StackPanel Spacing="8">
            <TextBlock
                Text="语言"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="12" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="语言"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <!-- Settings.Language : string ("system" / "zh-Hans" / "en") -->
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="180"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding Settings.Language, Mode=TwoWay}">
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                            <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                    </Grid>
                    <TextBlock
                        Text="选择应用的显示语言"
                        TextWrapping="Wrap"
                        FontSize="12"
                        Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- =====================================================================
             偏好设置  (Preferences)
             ===================================================================== -->
        <StackPanel Spacing="8">
            <TextBlock
                Text="偏好设置"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="4">

                    <!-- 启动时自动扫描设备 : Settings.AutoScanOnStartup (bool, default true) -->
                    <Grid ColumnSpacing="12" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="启动时自动扫描设备"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsOn="{Binding Settings.AutoScanOnStartup, Mode=TwoWay}" />
                    </Grid>

                    <!-- 显示系统通知 : Settings.ShowSystemNotifications (bool, default true) -->
                    <Grid ColumnSpacing="12" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="显示系统通知"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsOn="{Binding Settings.ShowSystemNotifications, Mode=TwoWay}" />
                    </Grid>

                    <!-- 启用深色模式 : Settings.UseDarkMode (bool, default true on Windows) -->
                    <Grid ColumnSpacing="12" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="启用深色模式"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsOn="{Binding Settings.UseDarkMode, Mode=TwoWay}" />
                    </Grid>

                    <!-- 扫描间隔 : Settings.ScanInterval (int seconds, default 30) — 15/30/60/120 -->
                    <Grid ColumnSpacing="12" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="扫描间隔"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="180"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding Settings.ScanInterval, Mode=TwoWay}">
                            <ComboBoxItem Content="15 秒">
                                <ComboBoxItem.Tag>
                                    <x:Int32>15</x:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="30 秒">
                                <ComboBoxItem.Tag>
                                    <x:Int32>30</x:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="60 秒">
                                <ComboBoxItem.Tag>
                                    <x:Int32>60</x:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="120 秒">
                                <ComboBoxItem.Tag>
                                    <x:Int32>120</x:Int32>
                                </ComboBoxItem.Tag>
                            </ComboBoxItem>
                        </ComboBox>
                    </Grid>

                </StackPanel>
            </Border>
        </StackPanel>

        <!-- =====================================================================
             界面  (Interface)
             ===================================================================== -->
        <StackPanel Spacing="8">
            <TextBlock
                Text="界面"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="4">

                    <!-- 显示设备详细信息 : Settings.ShowDeviceDetails (bool, default true) -->
                    <Grid ColumnSpacing="12" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="显示设备详细信息"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsOn="{Binding Settings.ShowDeviceDetails, Mode=TwoWay}" />
                    </Grid>

                    <!-- 显示连接统计 : Settings.ShowConnectionStats (bool, default true) -->
                    <Grid ColumnSpacing="12" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="显示连接统计"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsOn="{Binding Settings.ShowConnectionStats, Mode=TwoWay}" />
                    </Grid>

                    <!-- 紧凑模式 : Settings.CompactMode (bool, default false) -->
                    <Grid ColumnSpacing="12" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="紧凑模式"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsOn="{Binding Settings.CompactMode, Mode=TwoWay}" />
                    </Grid>

                    <!-- 主题颜色 : Settings.ThemeColorHex (string hex, default #3072EF) — swatch picker.
                         A ComboBox of preset accent swatches, each carrying its hex string as Tag;
                         SelectedValue round-trips that hex straight onto Settings.ThemeColorHex. -->
                    <Grid ColumnSpacing="12" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="主题颜色"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="180"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding Settings.ThemeColorHex, Mode=TwoWay}">
                            <ComboBoxItem Tag="#3072EF">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="#3072EF" />
                                    <TextBlock Text="天空蓝" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#34C759">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="#34C759" />
                                    <TextBlock Text="森林绿" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#AF52DE">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="#AF52DE" />
                                    <TextBlock Text="紫罗兰" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#FF9500">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="#FF9500" />
                                    <TextBlock Text="日落橙" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#FF2D55">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="#FF2D55" />
                                    <TextBlock Text="玫红" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#5AC8FA">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="#5AC8FA" />
                                    <TextBlock Text="青蓝" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </Grid>

                </StackPanel>
            </Border>
        </StackPanel>

        <!-- =====================================================================
             数据管理  (Data Management)

             On the Mac the 清除缓存 + Export / Import / Reset buttons live here. On Windows the
             Export / Import / Reset operations are the FROZEN SettingsToolbar push-button surface
             (Export/Import/Reset/RequestPermission/OpenSystemPreferences) + the SettingsMaintenance
             surface (Apply/RestoreDefaults/ResetMonitorData) rendered by SettingsView above — we do
             NOT re-add them as <Button>s here (that would break the gated 1/5/3 counts); this card
             honestly points to them. 清除缓存 IS surfaced here as a frosted clickable Border (Tapped
             → code-behind) that does the REAL work of deleting %LOCALAPPDATA%\SkyBridge\cache* and
             refreshing the live 当前缓存：<size> readout — a tappable Border (like the FileTransfer
             folder-picker), NOT a gated push-button, so the action-surface counts stay frozen.
             清理重复的钥匙串项 is macOS-only (no Windows equivalent) → rendered DISABLED with a
             "macOS 专属" caption, never faked.
             ===================================================================== -->
        <StackPanel Spacing="8">
            <TextBlock
                Text="数据管理"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">

                    <!-- Honest pointer to the toolbar/maintenance actions (no push-button here). -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            Glyph="&#xE74C;"
                            FontSize="16"
                            VerticalAlignment="Top"
                            Foreground="{StaticResource SkyBridgeAccentBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                Text="导出 / 导入 / 重置设置"
                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            <TextBlock
                                Text="使用上方工具栏的「导出」「导入」「重置」操作管理设置文件，存储于 %LOCALAPPDATA%\SkyBridge\settings.json。"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- 清理缓存 — REAL action: a frosted clickable Border (Tapped→code-behind,
                         NOT a <Button>, to keep the frozen toolbar/maintenance push-button surface
                         intact). On tap it deletes %LOCALAPPDATA%\SkyBridge\cache* and refreshes the
                         adjacent live 当前缓存：<size> status (computed from the real on-disk size).
                         The cache-size readout is recomputed on Loaded and after every clear — no
                         fabricated number. -->
                    <Grid ColumnSpacing="12" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Text="缓存"
                                Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            <!-- settings.general.cacheSize: verbatim '当前缓存：' + computed size.
                                 Populated by code-behind (Loaded + post-clear); placeholder shows the
                                 pending state until the first async size computation completes. -->
                            <TextBlock
                                x:Name="CacheSizeStatus"
                                Text="当前缓存：计算中…"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        </StackPanel>
                        <!-- Frosted clickable affordance (NOT a <Button>) — mirrors the FileTransfer
                             folder-picker Border pattern. Tapped handler clears the real cache dir. -->
                        <Border
                            Grid.Column="1"
                            x:Name="ClearCacheAffordance"
                            VerticalAlignment="Center"
                            Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                            BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource SkyBridgeButtonCornerRadius}"
                            Padding="14,7"
                            Tapped="OnClearCacheTapped"
                            ToolTipService.ToolTip="清除应用缓存文件夹中的临时数据">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    Glyph="&#xE74D;"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource SkyBridgeAccentBrush}" />
                                <TextBlock
                                    Text="清除缓存"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 清理重复的钥匙串项 — OMIT-APPLE-ONLY: disabled, captioned macOS 专属. -->
                    <Grid ColumnSpacing="12" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Text="清理重复的钥匙串项"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                            <TextBlock
                                Text="macOS 专属 — Windows 无钥匙串(Keychain)，凭据由 DPAPI 管理。"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource StatusPill}">
                            <TextBlock
                                Text="macOS 专属"
                                FontSize="12"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        </Border>
                    </Grid>

                </StackPanel>
            </Border>
        </StackPanel>

    </StackPanel>
</UserControl>
