<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    SkyBridge Compass — 简体中文 (zh-Hans) UI 字符串。
    必须与 Strings/en-US/Resources.resw 的键集 1:1 对应。
    PILOT 范围：USB 管理页。zh 文案取自 Mac 应用 zh-Hans.lproj/Localizable.strings
    (usb.management.title / usb.empty.title / usb.empty.subtitle)；"已连接设备" 为本端补译。
  -->
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- Mac: usb.management.title = "USB 管理" -->
  <data name="UsbManagementTitle.Text" xml:space="preserve">
    <value>USB 管理</value>
    <comment>USB page header title. Mac key: usb.management.title.</comment>
  </data>

  <!-- "Connected Devices" — 本端补译 -->
  <data name="UsbConnectedDevices.Text" xml:space="preserve">
    <value>已连接设备</value>
    <comment>Section header over the connected-USB-device list.</comment>
  </data>

  <!-- Mac: usb.empty.title = "未检测到 USB 设备" -->
  <data name="UsbEmptyTitle.Text" xml:space="preserve">
    <value>未检测到 USB 设备</value>
    <comment>Shown when zero USB devices are enumerated. Mac key: usb.empty.title.</comment>
  </data>

  <!-- Mac: usb.empty.subtitle = "请连接设备后刷新，或检查数据线与端口" -->
  <data name="UsbEmptySubtitle.Text" xml:space="preserve">
    <value>请连接设备后刷新，或检查数据线与端口。</value>
    <comment>Guidance under the empty-state title. Mac key: usb.empty.subtitle.</comment>
  </data>
</root>
