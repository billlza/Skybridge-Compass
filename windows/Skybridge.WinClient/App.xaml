<Application
    x:Class="Skybridge.WinClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Skybridge.WinClient"
    xmlns:vm="using:Skybridge.WinClient.ViewModels"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///VisualParity/GeneratedVisualParity.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/SkyBridgeTheme.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/SkyBridgeControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Device-Discovery peer-card display gates (显示设备详情 / 紧凑模式 / 显示设备图标).
                 ONE shared instance so the per-item DiscoveredPeerItemTemplate (its own namescope)
                 and the SessionViewModel's SettingsCoordinator effect sinks read/write the SAME
                 object. The cards bind {Binding ShowDetails/ShowIcons/CardPadding/IconSize,
                 Source={StaticResource DeviceDisplayPrefs}}; the sinks resolve it from
                 Application.Current.Resources and push the live settings into it. -->
            <vm:DeviceDisplayPrefs x:Key="DeviceDisplayPrefs" />

            <!-- System-Monitor metric tile show-flags (系统监控 > 显示项 CPU/内存/磁盘/网络/温度/
                 风扇转速). ONE shared instance: the SettingsCoordinator monitor-gate sink pushes the
                 six flags in (via the SessionViewModel) and the per-tile MonitorTileVisibilityConverter
                 reads them to show/hide each tile. -->
            <vm:MonitorDisplayPrefs x:Key="MonitorDisplayPrefs" />

            <!-- ===================================================================
                 NavigationView theme-resource overrides = the Mac GlassSidebar.
                 The stock NavigationViewItemPresenter keeps selection, hover, keyboard
                 and UI Automation; these keys only restyle what it paints. Values are
                 transcribed from GlassSidebar.swift (SidebarTabButton) so the two
                 sidebars read as one design. Per-row colour (the selected pill in the
                 feature's own hue, the glyph in that hue at rest) is stamped into each
                 container by SidebarItemStyleSelector; the keys here are the base.
                 =================================================================== -->

            <!-- Rows are prepared through this selector (MenuItemContainerStyleSelector on
                 the NavigationView in MainWindow): it colours each row after its feature. -->
            <vm:SidebarItemStyleSelector x:Key="SidebarItemStyleSelector" />

            <!-- Pill radius (Mac RoundedRectangle cornerRadius: 10). NavigationViewItem.CornerRadius
                 is template-bound into the presenter's LayoutRoot and the built-in style sets it
                 from ControlCornerRadius (4); the selector applies this token to each row. (A
                 NavigationViewItemPresenterCornerRadius key used to be set here; no such key
                 exists in WinUI, so the pill was 4 all along.) -->
            <CornerRadius x:Key="SkyBridgeSidebarPillCornerRadius">10</CornerRadius>

            <!-- The Mac marks the selected tab with a filled rounded pill, not a left
                 rail, so the rail indicator is hidden. -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />

            <!-- Selected pill base = the accent blue gradient (SwiftUI color.gradient:
                 lighter at the top, darker at the bottom). Every prepared row overrides
                 these three keys with its own feature colour; this base only shows for a
                 row the selector never saw, which does not happen with the feature list. -->
            <LinearGradientBrush x:Key="NavigationViewItemBackgroundSelected" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF4983F1" Offset="0.0" />
                <GradientStop Color="#FF2A64D2" Offset="1.0" />
            </LinearGradientBrush>
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="NavigationViewItemBackgroundSelected" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="NavigationViewItemBackgroundSelected" />

            <!-- Hover on an unselected row is a frosted patch (Mac: RoundedRectangle r10
                 filled with .ultraThinMaterial); an achromatic white wash over the pane's
                 frost (painted by the weather renderer) reads the same and never stacks a
                 second material. -->
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#29FFFFFF" />

            <!-- Foregrounds: the glyph inherits these through the presenter (its rest and
                 hover colour is the feature accent, stamped per row); white when selected,
                 like the Mac. The label carries its own brush in the row template. -->
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#D9F7FAFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#D9F7FAFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#D9F7FAFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFFFF" />

            <!-- Pane = the Mac sidebar material (.ultraThinMaterial). The frost itself is
                 painted by the weather renderer under the pane rect (SkyBridgeTheme explains
                 why XAML acrylic cannot do it here), so the pane fill is transparent. In the
                 Left pane mode the live key is the Expanded one; both are set. Content
                 stays transparent so the backdrop shows through. -->
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SkyBridgeSidebarFillBrush" />
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="SkyBridgeSidebarFillBrush" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />

            <!-- Pane/content divider = the Mac sidebar's trailing 1px white@0.10 rule,
                 drawn by the content grid's left border (its default rounded corner is
                 zeroed so the rule runs straight from the top). -->
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#1AFFFFFF" />
            <Thickness x:Key="NavigationViewContentGridBorderThickness">1,0,0,0</Thickness>
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>

            <!-- Row geometry (Mac: rows inset 12 from the pane edge, 4pt apart, 44pt tall).
                 The presenter's LayoutRoot margin is this button margin; the pane content
                 grid sits at -1, so 13 renders as 12. The content presenter's stock
                 4,-1,8,-1 margin bleeds 1px out of the 44pt row template on each side;
                 zeroing the vertical bleed makes the pill exactly 44 and the pitch 48.
                 (NavigationViewItemButtonMargin also pads the pane toggle button, hidden here.) -->
            <Thickness x:Key="NavigationViewItemButtonMargin">13,2</Thickness>
            <Thickness x:Key="NavigationViewItemContentPresenterMargin">4,0,8,0</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
