<UserControl x:Class="Skybridge.WinClient.AccountDevicesEntry"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
 <Border x:Name="GlassSurface" Style="{StaticResource GlassPanel}" CornerRadius="20" Visibility="Collapsed" IsHitTestVisible="False" />
 <Button x:Name="OpenButton" x:Uid="AccountDevicesOpen" Click="OnOpen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="{StaticResource SkyBridgePanelFillBrush}" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" Padding="8,6">
  <StackPanel Spacing="3">
   <StackPanel Orientation="Horizontal" Spacing="8">
    <FontIcon Glyph="&#xE772;" FontSize="17" />
    <TextBlock x:Uid="AccountDevicesTitle" Text="Account devices" FontWeight="SemiBold" />
   </StackPanel>
   <TextBlock x:Name="SummaryText" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
  </StackPanel>
 </Button>
 </Grid>
</UserControl>
