<UserControl x:Class="Skybridge.WinClient.AccountDevicesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 KeyDown="OnKeyDown" AutomationProperties.AutomationId="AccountDevices.Overlay">
 <Grid x:Name="Backdrop" Background="#B3000000" Padding="24" Tapped="OnBackdropTapped" TabFocusNavigation="Cycle">
  <Border x:Name="Card" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20"
          MaxWidth="720" MaxHeight="760" Padding="24" Tapped="OnCardTapped">
   <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Uid="AccountDevicesTitle" Text="Account devices" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
     <Button x:Name="RefreshButton" Grid.Column="1" x:Uid="AccountDevicesRefresh" Content="Refresh" Click="OnRefresh" AutomationProperties.AutomationId="AccountDevices.Refresh"/>
     <Button x:Name="CloseButton" Grid.Column="2" x:Uid="AccountDevicesClose" Content="Close" Click="OnClose" AutomationProperties.AutomationId="AccountDevices.Close"/>
    </Grid>
    <TextBlock Grid.Row="1" x:Uid="AccountDevicesHint" Text="Devices signed in to this account. Online status expires after 90 seconds without a heartbeat." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <StackPanel Grid.Row="2" Spacing="6">
     <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="AccountDevices.Status" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
     <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" Height="3" Visibility="Collapsed" />
    </StackPanel>
    <ListView x:Name="DeviceList" Grid.Row="3" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="AccountDevices.List">
     <ListView.ItemTemplate><DataTemplate>
      <Grid Padding="0,14" ColumnSpacing="14">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <FontIcon Glyph="{Binding Glyph}" FontSize="26" VerticalAlignment="Top" Margin="0,4,0,0" />
       <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{Binding State}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding LastSeen}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
       </StackPanel>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Grid>
  </Border>
 </Grid>
</UserControl>
