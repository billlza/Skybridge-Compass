<!--
  SkyBridgeControls.xaml — Windows design-language COMPONENT LIBRARY (Wave 1).

  Reusable WinUI 3 styles/templates that give the Windows client the Mac
  "liquid-glass" look. Every brush / radius referenced here is a SkyBridge*
  token defined in SkyBridgeTheme.xaml (merged BEFORE this dictionary in
  App.xaml), so there are no dangling {StaticResource} keys.

  Strictly valid WinUI 3 XAML:
    • no WPF Triggers/DataTriggers — interactive states use VisualStateManager
    • no x:Type — implicit/explicit Style TargetType only
    • StaticResource / ThemeResource only

  This file is globbed as a compiled Page (ResourceDictionary), so it packages
  into resources.pri and is reachable via the merged App resources.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================
         GlassPanel — the reusable replacement for inline glass Borders.
         Fill = SkyBridgePanelFillBrush, 1px SkyBridgePanelStrokeBrush,
         CornerRadius 22 (panel token), Padding 18.
         =================================================================== -->
    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SkyBridgePanelFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgePanelStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SkyBridgePanelCornerRadius}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- A slightly tighter glass surface for nested cards / chips. -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SkyBridgeCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SkyBridgeCardCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ===================================================================
         MetricCard — glass card, r18. Used directly as a Border style and
         consumed by the WorkspaceMetricCardTemplate refinement in MainWindow.
         Layout (accent icon → title 12 → value 30 bold) is expressed in the
         DataTemplate; this style supplies the glass chrome + sizing.
         =================================================================== -->
    <Style x:Key="MetricCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SkyBridgeCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SkyBridgeCardCornerRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Width" Value="220" />
        <Setter Property="Height" Value="132" />
        <Setter Property="Margin" Value="0,0,12,12" />
    </Style>

    <!-- Rounded accent chip that hosts a metric / quick-action FontIcon. -->
    <Style x:Key="AccentIconChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SkyBridgeShellSurfaceFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeShellSurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SkyBridgeButtonCornerRadius}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
    </Style>

    <!-- ===================================================================
         StatusPill — capsule on the shell surface with a color-bindable
         status dot. Style targets Border (the capsule shell); callers place
         a dot Ellipse + icon + caption inside. Dot color via StatusDot style.
         =================================================================== -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SkyBridgeShellSurfaceFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeShellSurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 8px status dot for StatusPill / list rows. Color set inline by caller
         (e.g. Fill="{StaticResource SkyBridgeSuccessBrush}"); default success. -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource SkyBridgeSuccessBrush}" />
    </Style>

    <!-- ===================================================================
         PrimaryButton — height 38, r ~8 (uses card-adjacent radius), accent
         fill, white fg; hover/pressed via VisualStateManager.
         =================================================================== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SkyBridgeTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SkyBridgeAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="38" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource SkyBridgeAccentHoverBrush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{StaticResource SkyBridgeAccentHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource SkyBridgeAccentPressedBrush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{StaticResource SkyBridgeAccentPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource SkyBridgeShellSurfaceFillBrush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{StaticResource SkyBridgeShellSurfaceStrokeBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource SkyBridgeTextMutedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         QuickActionTile — height 80, accent icon in a rounded chip + title +
         detail. Supplied as a Button style; the content (icon/title/detail)
         is provided by the consuming DataTemplate in MainWindow.
         =================================================================== -->
    <Style x:Key="QuickActionTile" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SkyBridgeCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource SkyBridgeTextPrimaryBrush}" />
        <Setter Property="Height" Value="80" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource SkyBridgeCardCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource SkyBridgeShellSurfaceFillBrush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{StaticResource SkyBridgeAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource SkyBridgeSelectedNavFillBrush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="{StaticResource SkyBridgeAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource SkyBridgeTextMutedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         Badge + ConnectionTypeChip — capsule tone styles. Tone is chosen by
         picking the matching style (success / warning / neutral / danger /
         accent). Each is a Border style; caller places a TextBlock inside.
         =================================================================== -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SkyBridgeShellSurfaceFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeShellSurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeSuccess" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeSuccessBrush}" />
    </Style>
    <Style x:Key="BadgeWarning" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeWarningBrush}" />
    </Style>
    <Style x:Key="BadgeDanger" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeDangerBrush}" />
    </Style>
    <Style x:Key="BadgeAccent" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeAccentBrush}" />
    </Style>

    <!-- ConnectionTypeChip: a capsule for transport / connection-type tags. -->
    <Style x:Key="ConnectionTypeChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SkyBridgeShellSurfaceFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================================================================
         GlassInput — TextBox style: height 34, r8, glass fill, theme stroke.
         Full control template so the glass look survives all interaction
         states (WinUI TextBox states are PointerOver / Focused / Disabled).
         =================================================================== -->
    <Style x:Key="GlassInput" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource SkyBridgeTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SkyBridgeShellSurfaceFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SkyBridgePanelStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="SelectionHighlightColor" Value="{StaticResource SkyBridgeAccentBrush}" />
    </Style>

    <!-- ===================================================================
         NavItemContainer — ListViewItem container style for the sidebar nav.
         Gives the selected item an accent pill and a hover surface while
         leaving the ListView's SelectedItem binding (and the bound item
         template) fully intact. Uses VisualStateManager only.
         =================================================================== -->
    <Style x:Key="NavItemContainer" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource SkyBridgeTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="NavItemRoot">
                        <!-- Accent selection pill (gradient), hidden unless selected -->
                        <Border
                            x:Name="SelectionPill"
                            CornerRadius="14"
                            Opacity="0"
                            BorderThickness="1"
                            BorderBrush="{StaticResource SkyBridgeAccentBrush}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource SkyBridgeAccentColor}" Offset="0.0" />
                                    <GradientStop Color="{StaticResource SkyBridgeAccentPressedColor}" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- Hover surface, hidden unless pointer-over -->
                        <Border
                            x:Name="HoverSurface"
                            CornerRadius="14"
                            Opacity="0"
                            Background="{StaticResource SkyBridgeShellSurfaceFillBrush}" />

                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="12,8"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverSurface.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverSurface.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="UnselectedPointerOver" />
                                <VisualState x:Name="UnselectedSwiping" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPill.Opacity" Value="1" />
                                        <Setter Target="HoverSurface.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPill.Opacity" Value="1" />
                                        <Setter Target="HoverSurface.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPill.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPill.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedSwiping">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPill.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionPill.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
