<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Platform SDK bumped 19041->22621: ComputeSharp.WinUI 3.2.0 compiles only against the
         22621 SDK. TargetPlatformMinVersion stays 19041 so the app still RUNS on Windows 10 2004+. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>

    <!-- MSIX toggle. Default OFF => the unpackaged build/run is byte-for-byte identical to
         before. Opt in for a packaged build with: /p:EnableMsixTooling=true -->
    <EnableMsixTooling Condition="'$(EnableMsixTooling)'==''">false</EnableMsixTooling>
    <WindowsPackageType Condition="'$(EnableMsixTooling)'!='true'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(EnableMsixTooling)'=='true'">MSIX</WindowsPackageType>

    <!-- Win2D ships native dlls and cannot be referenced under AnyCPU (WIN2D0001). Pin the
         unpackaged build to win-x64, framework-dependent (the box has the WindowsAppSDK runtime).
         The MSIX build sets its own RuntimeIdentifiers above. -->
    <RuntimeIdentifier Condition="'$(EnableMsixTooling)'!='true'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(EnableMsixTooling)'!='true'">false</SelfContained>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- ===== Single-project MSIX (Microsoft best practice: package identity, so location /
       notifications etc. are granted via the manifest instead of a system-wide desktop-apps
       switch). Inert unless /p:EnableMsixTooling=true, so the default unpackaged path is
       unaffected. SAFE ROLLBACK: restore the single <WindowsPackageType>None</WindowsPackageType>
       line and delete the two groups below. ===== -->
  <PropertyGroup Condition="'$(EnableMsixTooling)'=='true'">
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateTestCertificate>false</GenerateTestCertificate>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableMsixTooling)'=='true'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Content Include="Assets\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" PrivateAssets="all" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- ComputeSharp.WinUI: C#->DX12 GPU compute shaders (the Windows equivalent of Mac's Metal),
         for the procedural cinematic weather backdrop. Win2D was a dead end here —
         CanvasAnimatedControl (the animation-loop control) is unsupported in WinUI 3.
         Requires the win-x64 RID set above (DX12 native). -->
    <PackageReference Include="ComputeSharp.WinUI" Version="3.2.0" />
    <!-- Direct ref + GeneratePathProperty so we can FORCE-load the source generator below. Its dll
         ships in analyzers/dotnet/cs/ (unversioned) and was NOT being passed to csc as an /analyzer
         on this net10/Roslyn 5.3 toolchain, so IComputeShaderDescriptor<T> was never emitted (CS0315). -->
    <PackageReference Include="ComputeSharp" Version="3.2.0" GeneratePathProperty="true" />
    <!-- DPAPI (ProtectedData) for at-rest encryption of the persisted account session
         (Services/SessionStore.cs, DataProtectionScope.CurrentUser). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <!-- Force-load the ComputeSharp source generator: NuGet didn't pass it to csc on net10/Roslyn 5.3
       (see note on the ComputeSharp PackageReference). Decisive test for whether ComputeSharp 3.2.0
       can work on this toolchain at all. -->
  <ItemGroup>
    <Analyzer Include="$(PkgComputeSharp)\analyzers\dotnet\cs\ComputeSharp.SourceGenerators.dll" />
  </ItemGroup>
</Project>
