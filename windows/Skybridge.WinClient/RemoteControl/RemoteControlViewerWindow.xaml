<Window
    x:Class="Skybridge.WinClient.RemoteControl.RemoteControlViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ViewerRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="OnLoaded">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Padding="16" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="PeerPicker" x:Uid="RemoteViewerPeers" DisplayMemberPath="Label" HorizontalAlignment="Stretch"
                      AutomationProperties.AutomationId="Skybridge.RemoteControl.Viewer.Peer" SelectionChanged="OnPeerChanged"/>
            <Button x:Name="RefreshButton" x:Uid="RemoteViewerRefresh" Grid.Column="1" VerticalAlignment="Bottom" Click="OnRefreshClicked"/>
            <Button x:Name="ConnectButton" x:Uid="RemoteViewerConnect" Grid.Column="2" VerticalAlignment="Bottom" IsEnabled="False"
                    AutomationProperties.AutomationId="Skybridge.RemoteControl.Viewer.Connect" Click="OnConnectClicked"/>
            <Button x:Name="DisconnectButton" x:Uid="RemoteViewerDisconnect" Grid.Column="3" VerticalAlignment="Bottom" IsEnabled="False" Click="OnDisconnectClicked"/>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="16,0,16,12" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="Skybridge.RemoteControl.Viewer.Status"/>
        <Grid Grid.Row="2" Background="Black">
            <MediaPlayerElement x:Name="VideoElement" AreTransportControlsEnabled="False" Stretch="Uniform"
                                IsHitTestVisible="False" IsTabStop="False"/>
            <ContentControl x:Name="InputSurface" Background="Transparent" IsTabStop="True" IsEnabled="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="Skybridge.RemoteControl.Viewer.Surface">
                <Grid Background="Transparent"/>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
