<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Skybridge.WinClient.RemoteControl.RemoteControlHostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12" AutomationProperties.AutomationId="Skybridge.RemoteControl.Host">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Uid="RemoteControlHostTitle" Text="Control this PC" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                x:Name="HostToggle"
                x:Uid="RemoteControlHostToggle"
                AutomationProperties.AutomationId="Skybridge.RemoteControl.Host.Toggle"
                IsOn="{Binding IsEnabled, Mode=OneWay}"
                IsEnabled="{Binding CanToggle}"
                Toggled="OnHostToggled"
                VerticalAlignment="Center" />
        </Grid>
        <TextBlock
            x:Uid="RemoteControlHostExplanation"
            Text="Enable access for trusted controllers on your local network. You can stop sharing at any time."
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ComboBox
            x:Uid="RemoteControlHostNetwork"
            Header="Local network"
            PlaceholderText="Choose a network"
            AutomationProperties.AutomationId="Skybridge.RemoteControl.Host.Network"
            ItemsSource="{Binding NetworkInterfaces}"
            DisplayMemberPath="DisplayName"
            SelectedItem="{Binding SelectedNetwork, Mode=TwoWay}"
            IsEnabled="{Binding CanChooseNetwork}"
            HorizontalAlignment="Stretch" />
        <TextBlock Text="{Binding NetworkHint}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
        <TextBlock Text="{Binding TrustedDevicesText}" TextWrapping="Wrap" />
        <CommandBar DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed" Background="Transparent" HorizontalAlignment="Left">
            <AppBarButton x:Uid="RemoteControlHostRefresh" Icon="Refresh" Label="Refresh" Command="{Binding RefreshCommand}" />
            <AppBarButton x:Uid="RemoteControlHostCopyPairing" Icon="Copy" Label="Copy pairing info" Command="{Binding CopyPairingCommand}" />
            <AppBarButton x:Uid="RemoteControlHostImportPairing" Icon="Paste" Label="Paste pairing info" Command="{Binding ImportPairingCommand}" />
        </CommandBar>
        <InfoBar
            x:Uid="RemoteControlHostPendingController"
            Title="Review controller"
            IsOpen="{Binding HasPendingController}"
            IsClosable="False"
            Severity="Informational">
            <InfoBar.Content>
                <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding PendingControllerName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBox
                        x:Uid="RemoteControlHostPendingFingerprint"
                        Header="Identity fingerprint"
                        Text="{Binding PendingControllerFingerprint, Mode=OneWay}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        FontFamily="Consolas"
                        AutomationProperties.AutomationId="Skybridge.RemoteControl.Host.PendingFingerprint" />
                    <TextBlock
                        x:Uid="RemoteControlHostReviewHint"
                        Text="Check the name and fingerprint against the controller you intend to use. When remote access is on, this controller can view and control this PC."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="RemoteControlHostConfirmController"
                            Content="Trust this controller"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="Skybridge.RemoteControl.Host.ConfirmController"
                            Command="{Binding ConfirmControllerCommand}" />
                        <Button
                            x:Uid="RemoteControlHostCancelController"
                            Content="Cancel"
                            Command="{Binding CancelControllerCommand}" />
                    </StackPanel>
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>
        <Expander x:Uid="RemoteControlHostIdentity" Header="This PC's identity" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBox Text="{Binding Fingerprint}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" AutomationProperties.AutomationId="Skybridge.RemoteControl.Host.Fingerprint" />
                <TextBlock x:Uid="RemoteControlHostPairingHint" Text="Exchange pairing information with the controller before enabling access." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Expander>
        <InfoBar IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}" Severity="Error" IsClosable="False" />
        <TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
