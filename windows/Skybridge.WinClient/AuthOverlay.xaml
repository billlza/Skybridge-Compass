<?xml version="1.0" encoding="utf-8"?>
<!--
  AuthOverlay — the full Mac LOGIN screen as an in-window UserControl layer (replaces the
  crashing SignInDialog ContentDialog). Hosted as a full-bleed Grid in MainWindow, its
  Visibility bound to ViewModel.ShowAuthOverlay. Because it is a plain panel in the window's
  visual tree there is NO XamlRoot, NO single-dialog rule, and NO async-void ShowAsync — the
  entire ContentDialog crash class is gone.

  Element parity with the Mac AuthenticationView — FULL-WIDTH spacious layout:
    • starry-night dark background + top-down darkening gradient
    • top ~35%: centered brand header — tagline "跨网无感，安全即达。" + 3 capsule pills +
      logo glass tile + "SkyBridge Compass" (blue→cyan gradient title)
    • bottom ~65%: ONE full-width glass card (r24, ~40px horizontal margin from the window
      edges, generous ~32 internal padding):
        – "选择登录方式" gradient headline
        – a 4-tab radio-like picker spread across the WHOLE card width (each tab Width=*,
          equal, height 68, icon-over-label). Selected tab gets an accent ring + tint
          (Microsoft BLUE, Nebula PURPLE, Phone GREEN, Email BLUE)
        – the selected method's FULL-WIDTH form (Email fully functional; the rest honest)
        – a full-width 游客模式体验 row with a → arrow

  All buttons live HERE (a UserControl), so MainWindow.xaml's gated <Button> count is unchanged.
-->
<UserControl
    x:Class="Skybridge.WinClient.AuthOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Blue→cyan brand gradient (app accent #FF3072EF → secondary #FF00D9FF), used as
             the foreground of the app title + the "选择登录方式" headline so they read as the
             Mac's gradient text. -->
        <LinearGradientBrush x:Key="BrandTitleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource SkyBridgeAccentColor}" Offset="0.0" />
            <GradientStop Color="{StaticResource SkyBridgeAccentSecondaryColor}" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Glass text/password input chrome (element-matches the Mac LiquidGlassTextField:
             frosted fill, r12, focus accent border). Full-width + tall (50) to match the
             airy Mac fields. Defined locally so the whole login is self-contained here. -->
        <Style x:Key="GlassTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource SkyBridgeTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SkyBridgeShellSurfaceFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeShellSurfaceStrokeBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="GlassPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource SkyBridgeTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SkyBridgeShellSurfaceFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeShellSurfaceStrokeBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <!-- Flat text-link button (忘记密码？/ 点击注册) — no fill/border, accent-on-hover. -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="{StaticResource SkyBridgeTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Solid-fill action buttons with a r12 templated body, color set per form. -->
        <Style x:Key="MicrosoftButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF00A4EF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="NebulaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF8A4FE0" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="PhoneButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF36A85B" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Full-width guest row: frosted glass surface, r16. -->
        <Style x:Key="GuestRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SkyBridgeShellSurfaceFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SkyBridgeShellSurfaceStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <!-- Full-bleed starry background (matches the shell window gradient) + a top-down
         darkening mask for form legibility, exactly like the Mac DashboardBackgroundView +
         LinearGradient([black .35, black .15, clear]). -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF0D0D26" Offset="0.0" />
                <GradientStop Color="#FF1A0D33" Offset="0.45" />
                <GradientStop Color="#FF261A40" Offset="0.8" />
                <GradientStop Color="#FF14141F" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Top-down legibility mask over the background. -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#59000000" Offset="0.0" />
                    <GradientStop Color="#26000000" Offset="0.4" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Scrollable content column so the login fits small windows without clipping. The
             inner Grid STRETCHES to the full window width (no MaxWidth clamp) and is split
             into a centered header band (top) + a full-width login card (bottom), matching
             the Mac's "header above, full-bleed card below" composition. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Stretch" Padding="40,40,40,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ============================ BRAND HEADER ============================ -->
                <StackPanel Grid.Row="0" Spacing="16" Margin="0,16,0,28" HorizontalAlignment="Center">
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <!-- Tagline -->
                        <TextBlock
                            Text="跨网无感，安全即达。"
                            FontSize="27"
                            FontWeight="Bold"
                            TextAlignment="Center"
                            Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />

                        <!-- 3 capsule pills: 跨网直达 / 端到端可信 / 零配置协作 -->
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="12,7">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE968;" FontSize="13" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                    <TextBlock Text="跨网直达" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="12,7">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                    <TextBlock Text="端到端可信" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCard}" CornerRadius="10" Padding="12,7">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                    <TextBlock Text="零配置协作" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Logo glass tile (44x44, r12) + app title. No real brand image asset
                         exists in the Windows project (no Assets/*.png, no <ApplicationIcon>,
                         no appxmanifest logos), so a tasteful styled glyph is used in an
                         accent glass frame — no logo is fabricated. -->
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="12"
                            Background="{StaticResource SkyBridgeAccentBrush}"
                            HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE80F;" FontSize="22" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            Text="SkyBridge Compass"
                            FontSize="20"
                            FontWeight="Bold"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource BrandTitleGradient}" />
                    </StackPanel>
                </StackPanel>

                <!-- ============================= LOGIN CARD ============================= -->
                <!-- FULL-WIDTH glass card: stretches edge-to-edge inside the 40px page inset
                     (so ~40px margin from the window). r24, generous 32 internal padding. -->
                <Border
                    Grid.Row="1"
                    Style="{StaticResource GlassPanel}"
                    HorizontalAlignment="Stretch"
                    CornerRadius="24"
                    Padding="32">
                    <StackPanel Spacing="20" HorizontalAlignment="Stretch">

                        <!-- Method picker -->
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                            <TextBlock
                                Text="选择登录方式"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{StaticResource BrandTitleGradient}" />

                            <!-- 4 radio-like tabs spread across the FULL card width — every
                                 column Width=* (equal), so each tab is big and fills its share.
                                 They are Border (not Button) elements driven by Tapped + a
                                 code-behind selection model (SelectedAuthMethod), so the
                                 selected ring/accent is trivial to paint and they add no
                                 <Button> anywhere. Each carries a Tag = its method key. -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Microsoft tab (was Apple). Microsoft 4-square logo rendered
                                     as a 2x2 Grid of colored squares (Segoe has no MS logo). -->
                                <Border
                                    x:Name="MicrosoftTab"
                                    Grid.Column="0"
                                    Tag="microsoft"
                                    Tapped="OnTabTapped"
                                    Height="68"
                                    CornerRadius="12"
                                    Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                                    BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Microsoft 4-square: red TL, green TR, blue BL, yellow BR -->
                                        <Grid Width="20" Height="20" ColumnSpacing="2" RowSpacing="2" HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#FFF25022" />
                                            <Rectangle Grid.Row="0" Grid.Column="1" Fill="#FF7FBA00" />
                                            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#FF00A4EF" />
                                            <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFFFB900" />
                                        </Grid>
                                        <TextBlock Text="Microsoft 账号" FontSize="12" FontWeight="Medium" TextAlignment="Center" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Nebula tab -->
                                <Border
                                    x:Name="NebulaTab"
                                    Grid.Column="1"
                                    Tag="nebula"
                                    Tapped="OnTabTapped"
                                    Height="68"
                                    CornerRadius="12"
                                    Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                                    BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE753;" FontSize="22" Foreground="#FFB07CF5" />
                                        <TextBlock Text="星云账号" FontSize="12" FontWeight="Medium" TextAlignment="Center" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Phone tab -->
                                <Border
                                    x:Name="PhoneTab"
                                    Grid.Column="2"
                                    Tag="phone"
                                    Tapped="OnTabTapped"
                                    Height="68"
                                    CornerRadius="12"
                                    Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                                    BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE717;" FontSize="22" Foreground="#FF4DC770" />
                                        <TextBlock Text="手机号码" FontSize="12" FontWeight="Medium" TextAlignment="Center" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Email tab -->
                                <Border
                                    x:Name="EmailTab"
                                    Grid.Column="3"
                                    Tag="email"
                                    Tapped="OnTabTapped"
                                    Height="68"
                                    CornerRadius="12"
                                    Background="{StaticResource SkyBridgeShellSurfaceFillBrush}"
                                    BorderBrush="{StaticResource SkyBridgeShellSurfaceStrokeBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE715;" FontSize="22" Foreground="{StaticResource SkyBridgeAccentBrush}" />
                                        <TextBlock Text="电子邮箱" FontSize="12" FontWeight="Medium" TextAlignment="Center" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ===================== FORMS (one visible at a time) ===================== -->
                        <!-- Forms are FULL-WIDTH: they stretch inside the card and rely on the
                             card's 32 padding (no inner left/right padding), so fields run the
                             whole card width like the Mac. -->

                        <!-- EMAIL form (fully functional) -->
                        <StackPanel
                            x:Name="EmailForm"
                            Spacing="16"
                            HorizontalAlignment="Stretch">

                            <!-- 没有账号？点击注册 (hint link; registration is hosted, inert for now) -->
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="没有账号？" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                <Button
                                    Click="OnRegisterHint"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Foreground="{StaticResource SkyBridgeAccentBrush}"
                                    Content="点击注册" />
                            </StackPanel>

                            <TextBox
                                x:Name="EmailInput"
                                PlaceholderText="邮箱地址"
                                Style="{StaticResource GlassTextBoxStyle}" />
                            <PasswordBox
                                x:Name="PasswordInput"
                                PlaceholderText="密码"
                                Style="{StaticResource GlassPasswordBoxStyle}" />

                            <!-- 记住账号密码 (Mac stores email pref only, never the raw password) -->
                            <CheckBox
                                x:Name="RememberCredentials"
                                Content="记住账号密码"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />

                            <!-- Inline error (collapsed until a sign-in attempt fails) -->
                            <Border
                                x:Name="ErrorBanner"
                                Visibility="Collapsed"
                                Background="#26FF5C5C"
                                BorderBrush="#4DFF5C5C"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{StaticResource SkyBridgeDangerBrush}" />
                                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource SkyBridgeDangerBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- 邮箱登录 button (BLUE) — wired to the SAME working handler -->
                            <Button
                                x:Name="EmailSignInButton"
                                Click="OnEmailSignIn"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PrimaryButton}"
                                Height="50"
                                MinHeight="50">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ProgressRing x:Name="SignInSpinner" Width="18" Height="18" IsActive="False" Visibility="Collapsed" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                                    <FontIcon x:Name="SignInGlyph" Glyph="&#xE715;" FontSize="16" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                                    <TextBlock Text="邮箱登录" FontWeight="SemiBold" Foreground="{StaticResource SkyBridgeTextPrimaryBrush}" />
                                </StackPanel>
                            </Button>

                            <!-- 忘记密码？ (renders as a flat text link; opens the Supabase reset in browser) -->
                            <Button
                                Click="OnForgotPassword"
                                HorizontalAlignment="Center"
                                Style="{StaticResource LinkButtonStyle}"
                                Content="忘记密码？" />
                        </StackPanel>

                        <!-- MICROSOFT form -->
                        <StackPanel
                            x:Name="MicrosoftForm"
                            Visibility="Collapsed"
                            Spacing="14"
                            HorizontalAlignment="Stretch">
                            <TextBlock
                                Text="使用 Microsoft 账号登录 SkyBridge Compass。"
                                FontSize="13"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            <!-- BLUE "使用 Microsoft 登录" button. Microsoft OAuth requires the
                                 Supabase azure provider, which is NOT enabled on this project yet,
                                 so the button is HONEST: clicking it surfaces an inline message
                                 rather than faking success or opening a broken flow. -->
                            <Button
                                Click="OnMicrosoftContinue"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource MicrosoftButtonStyle}"
                                Height="50"
                                MinHeight="50">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Width="18" Height="18" ColumnSpacing="2" RowSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.Row="0" Grid.Column="0" Fill="#FFF25022" />
                                        <Rectangle Grid.Row="0" Grid.Column="1" Fill="#FF7FBA00" />
                                        <Rectangle Grid.Row="1" Grid.Column="0" Fill="#FF00A4EF" />
                                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFFFB900" />
                                    </Grid>
                                    <TextBlock Text="使用 Microsoft 登录" FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                x:Name="MicrosoftHint"
                                Text="Microsoft 账号登录需要在 Supabase 启用 Azure 登录后才能使用。"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource SkyBridgeTextMutedBrush}" />
                        </StackPanel>

                        <!-- NEBULA form -->
                        <StackPanel
                            x:Name="NebulaForm"
                            Visibility="Collapsed"
                            Spacing="14"
                            HorizontalAlignment="Stretch">
                            <Border Style="{StaticResource GlassCard}" CornerRadius="18" Padding="18">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#FFB07CF5" />
                                        <TextBlock Text="推荐使用安全浏览器登录" FontWeight="SemiBold" Foreground="#FFB07CF5" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="Nebula 登录会在系统浏览器中完成，授权与二次验证都会留在浏览器授权会话里。"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{StaticResource SkyBridgeSuccessBrush}" />
                                        <TextBlock Text="支持 PKCE 与浏览器内 MFA" FontSize="12" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 在安全浏览器中登录 (PURPLE) -->
                            <Button
                                Click="OnNebulaBrowserLogin"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource NebulaButtonStyle}"
                                Height="50"
                                MinHeight="50">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="White" />
                                    <TextBlock Text="在安全浏览器中登录" FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- PHONE form -->
                        <StackPanel
                            x:Name="PhoneForm"
                            Visibility="Collapsed"
                            Spacing="14"
                            HorizontalAlignment="Stretch">
                            <!-- Phone number + a 获取验证码 row, then the OTP field. The OTP
                                 backend is not wired in the Windows client (the Mac uses Supabase
                                 phone OTP), so the 手机登录 button is HONEST and routes to email
                                 rather than faking a code send / signed-in success. -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    PlaceholderText="手机号码"
                                    Style="{StaticResource GlassTextBoxStyle}" />
                                <Button
                                    Grid.Column="1"
                                    Click="OnPhoneGetCode"
                                    VerticalAlignment="Stretch"
                                    MinWidth="112"
                                    Style="{StaticResource PhoneButtonStyle}"
                                    Content="获取验证码" />
                            </Grid>
                            <TextBox
                                PlaceholderText="验证码"
                                Style="{StaticResource GlassTextBoxStyle}" />
                            <Border x:Name="PhoneHintCard" Style="{StaticResource GlassCard}" CornerRadius="12" Padding="12,8">
                                <TextBlock
                                    x:Name="PhoneHint"
                                    Text="手机号登录暂未在 Windows 端开放，请暂用邮箱登录。"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                            </Border>
                            <Button
                                Click="OnSelectEmail"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PhoneButtonStyle}"
                                Height="50"
                                MinHeight="50">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE715;" FontSize="16" Foreground="White" />
                                    <TextBlock Text="手机登录（暂用邮箱登录）" FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- ===================== GUEST MODE ===================== -->
                        <Button
                            Click="OnGuestMode"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource GuestRowButtonStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="20" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="游客模式体验" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" />
                                <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="18" Foreground="{StaticResource SkyBridgeTextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
