# Fastlane 自动化脚本
# SkyBridge Compass

require "shellwords"

default_platform(:mac)

platform :mac do

  def current_signing_identity
    sh("security find-identity -v -p codesigning | grep 'Developer ID Application' | head -1 | awk -F'\"' '{print $2}'").strip
  end
  
  desc "获取或创建 Developer ID 证书"
  lane :setup_certificates do
    # 创建 Developer ID Application 证书
    cert(
      development: false,
      type: "developer_id_application",
      generate_apple_certs: true,
      keychain_path: "~/Library/Keychains/login.keychain-db"
    )
    
    UI.success("✅ Developer ID 证书已配置完成！")
  end
  
  desc "低层步骤：构建并签名带 Widget 的 Developer ID .app（Apple 登录采用 web_session，不生成最终 DMG）"
  lane :build_signed do
    # 确保证书存在
    setup_certificates
    
    # 获取签名身份
    signing_identity = current_signing_identity
    
    if signing_identity.empty?
      UI.user_error!("未找到 Developer ID Application 证书")
    end
    
    UI.message("使用签名身份: #{signing_identity}")
    
    # 低层步骤：生成带 Widget 的正式签名 .app，供单独排查签名/公证问题使用。
    sh("cd .. && SKYBRIDGE_REQUIRE_APPLE_SIGN_IN_MODE=web_session SKYBRIDGE_REQUIRE_APP_GROUPS=1 SKYBRIDGE_REQUIRE_WIDGET_EXTENSION=1 IDENTITY='#{signing_identity}' ./Scripts/package_app.sh")
    sh("cd .. && SKYBRIDGE_REQUIRE_APPLE_SIGN_IN_MODE=web_session SKYBRIDGE_REQUIRE_APP_GROUPS=1 SKYBRIDGE_REQUIRE_WIDGET_EXTENSION=1 APP_PATH='dist/SkyBridge Compass Pro.app' IDENTITY='#{signing_identity}' ./Scripts/sign_app.sh")
    
    UI.success("✅ 应用构建并签名完成！")
  end
  
  desc "低层步骤：仅公证现有 .app（不生成最终 DMG）"
  lane :notarize_app do
    sh("cd .. && ./Scripts/ensure_notarytool_credentials.sh")

    notarize(
      package: "dist/SkyBridge Compass Pro.app",
      bundle_id: "com.skybridge.compass.pro",
      print_log: true,
      verbose: true
    )
    
    UI.success("✅ 应用公证完成！")
  end
  
  desc "本地 Developer ID 候选打包链：构建、签名、公证并执行 package-integrity-only 校验；不生成发布就绪结论"
  lane :release do
    signing_identity = current_signing_identity
    if signing_identity.empty?
      UI.user_error!("未找到 Developer ID Application 证书")
    end

    sh("cd .. && ./Scripts/ensure_notarytool_credentials.sh")

    release_build_id = ENV["SKYBRIDGE_RELEASE_BUILD_ID"]
    unless release_build_id.to_s.match?(/\A[1-9][0-9]*\z/)
      UI.user_error!("正式 macOS 构建必须显式设置正整数 SKYBRIDGE_RELEASE_BUILD_ID")
    end

    release_args = [
      "--build-id #{Shellwords.escape(release_build_id)}",
      "--identity #{Shellwords.escape(signing_identity)}",
      "--notarize-app",
      "--notarize-dmg",
      "--require-notarization"
    ]
    if ENV["SKYBRIDGE_RELEASE_REUSE_ARTIFACTS"] == "1"
      release_args << "--skip-build"
      release_args << "--use-existing-app"
    end

    sh("cd .. && SKYBRIDGE_REQUIRE_APPLE_SIGN_IN_MODE=web_session SKYBRIDGE_REQUIRE_APP_GROUPS=1 SKYBRIDGE_REQUIRE_WIDGET_EXTENSION=1 ./Scripts/build_dmg.sh #{release_args.join(' ')}")
    readiness_args = ["--require-notarization", "--package-integrity-only"]
    sh("cd .. && SKYBRIDGE_RELEASE_GATE_REQUIRE_NOTARIZATION=1 ./Scripts/check_macos_release_readiness.sh #{readiness_args.join(' ')}")

    if ENV["SKYBRIDGE_PUBLISH_UPDATE_RELEASE"] == "1"
      UI.user_error!(
        "远程发布只允许由受保护的候选→物理证据→发布 GitHub Actions 事务执行；Fastlane 仅构建、签名、公证并校验本地候选物。"
      )
    end

    UI.success("✅ 本地候选物已完成签名、公证与 package-integrity-only 校验；尚未形成发布就绪结论。")
  end
  
end
