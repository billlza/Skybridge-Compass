# Fastlane 自动化脚本
# SkyBridge Compass

require "shellwords"

default_platform(:mac)

platform :mac do

  def current_signing_identity
    sh("security find-identity -v -p codesigning | grep 'Developer ID Application' | head -1 | awk -F'\"' '{print $2}'").strip
  end
  
  desc "获取或创建 Developer ID 证书"
  lane :setup_certificates do
    # 创建 Developer ID Application 证书
    cert(
      development: false,
      type: "developer_id_application",
      generate_apple_certs: true,
      keychain_path: "~/Library/Keychains/login.keychain-db"
    )
    
    UI.success("✅ Developer ID 证书已配置完成！")
  end
  
  desc "低层步骤：构建并签名带 Widget 的 Developer ID .app（Apple 登录采用 web_session，不生成最终 DMG）"
  lane :build_signed do
    # 确保证书存在
    setup_certificates
    
    # 获取签名身份
    signing_identity = current_signing_identity
    
    if signing_identity.empty?
      UI.user_error!("未找到 Developer ID Application 证书")
    end
    
    UI.message("使用签名身份: #{signing_identity}")
    
    # 低层步骤：生成带 Widget 的正式签名 .app，供单独排查签名/公证问题使用。
    sh("cd .. && SKYBRIDGE_REQUIRE_APPLE_SIGN_IN_MODE=web_session SKYBRIDGE_REQUIRE_APP_GROUPS=1 SKYBRIDGE_REQUIRE_WIDGET_EXTENSION=1 IDENTITY='#{signing_identity}' ./Scripts/package_app.sh")
    sh("cd .. && SKYBRIDGE_REQUIRE_APPLE_SIGN_IN_MODE=web_session SKYBRIDGE_REQUIRE_APP_GROUPS=1 SKYBRIDGE_REQUIRE_WIDGET_EXTENSION=1 APP_PATH='dist/SkyBridge Compass Pro.app' IDENTITY='#{signing_identity}' ./Scripts/sign_app.sh")
    
    UI.success("✅ 应用构建并签名完成！")
  end
  
  desc "低层步骤：仅公证现有 .app（不生成最终 DMG）"
  lane :notarize_app do
    sh("cd .. && ./Scripts/ensure_notarytool_credentials.sh")

    notarize(
      package: "dist/SkyBridge Compass Pro.app",
      bundle_id: "com.skybridge.compass.pro",
      print_log: true,
      verbose: true
    )
    
    UI.success("✅ 应用公证完成！")
  end
  
  desc "最终 Developer ID 发布链：构建、签名、公证 .app/.dmg，Apple 登录固定走 web_session，并执行严格 release readiness 校验"
  lane :release do
    signing_identity = current_signing_identity
    if signing_identity.empty?
      UI.user_error!("未找到 Developer ID Application 证书")
    end

    sh("cd .. && ./Scripts/ensure_notarytool_credentials.sh")

    connectivity_artifact_dir = ENV["SKYBRIDGE_RELEASE_GATE_CONNECTIVITY_ARTIFACT_DIR"]
    p2p_remote_artifact_dir = ENV["SKYBRIDGE_RELEASE_GATE_P2P_REMOTE_ARTIFACT_DIR"]
    file_transfer_artifact_dir = ENV["SKYBRIDGE_RELEASE_GATE_FILE_TRANSFER_ARTIFACT_DIR"]
    p2p_notice_artifact_dir = ENV["SKYBRIDGE_RELEASE_GATE_P2P_NOTICE_ARTIFACT_DIR"]
    webrtc_notice_artifact_dir = ENV["SKYBRIDGE_RELEASE_GATE_WEBRTC_NOTICE_ARTIFACT_DIR"]
    notice_panel_artifact_dir = ENV["SKYBRIDGE_RELEASE_GATE_NOTICE_PANEL_ARTIFACT_DIR"]
    if connectivity_artifact_dir.to_s.empty? || p2p_remote_artifact_dir.to_s.empty? || file_transfer_artifact_dir.to_s.empty? || p2p_notice_artifact_dir.to_s.empty? || webrtc_notice_artifact_dir.to_s.empty? || notice_panel_artifact_dir.to_s.empty?
      UI.user_error!("最终发布必须显式传入 SKYBRIDGE_RELEASE_GATE_CONNECTIVITY_ARTIFACT_DIR、SKYBRIDGE_RELEASE_GATE_P2P_REMOTE_ARTIFACT_DIR、SKYBRIDGE_RELEASE_GATE_FILE_TRANSFER_ARTIFACT_DIR、SKYBRIDGE_RELEASE_GATE_P2P_NOTICE_ARTIFACT_DIR、SKYBRIDGE_RELEASE_GATE_WEBRTC_NOTICE_ARTIFACT_DIR、SKYBRIDGE_RELEASE_GATE_NOTICE_PANEL_ARTIFACT_DIR")
    end

    release_args = [
      "--identity #{Shellwords.escape(signing_identity)}",
      "--notarize-app",
      "--notarize-dmg",
      "--require-notarization"
    ]
    if ENV["SKYBRIDGE_RELEASE_REUSE_ARTIFACTS"] == "1"
      release_args << "--skip-build"
      release_args << "--use-existing-app"
    end

    sh("cd .. && SKYBRIDGE_REQUIRE_APPLE_SIGN_IN_MODE=web_session SKYBRIDGE_REQUIRE_APP_GROUPS=1 SKYBRIDGE_REQUIRE_WIDGET_EXTENSION=1 ./Scripts/build_dmg.sh #{release_args.join(' ')}")
    readiness_args = [
      "--require-notarization",
      "--connectivity-artifact-dir #{Shellwords.escape(connectivity_artifact_dir)}",
      "--p2p-remote-artifact-dir #{Shellwords.escape(p2p_remote_artifact_dir)}",
      "--file-transfer-artifact-dir #{Shellwords.escape(file_transfer_artifact_dir)}",
      "--p2p-notice-artifact-dir #{Shellwords.escape(p2p_notice_artifact_dir)}",
      "--webrtc-notice-artifact-dir #{Shellwords.escape(webrtc_notice_artifact_dir)}",
      "--notice-panel-artifact-dir #{Shellwords.escape(notice_panel_artifact_dir)}"
    ]
    sh("cd .. && SKYBRIDGE_RELEASE_GATE_REQUIRE_NOTARIZATION=1 ./Scripts/check_macos_release_readiness.sh #{readiness_args.join(' ')}")

    if ENV["SKYBRIDGE_PUBLISH_UPDATE_RELEASE"] == "1"
      update_key_id = ENV["SKYBRIDGE_UPDATE_MANIFEST_KEY_ID"]
      if update_key_id.to_s.empty?
        UI.user_error!("发布 GitHub stable 更新必须设置 SKYBRIDGE_UPDATE_MANIFEST_KEY_ID")
      end
      sh("cd .. && ./Scripts/publish_macos_update_release.sh --key-id #{Shellwords.escape(update_key_id)}")
    end

    UI.success("✅ 最终发布版本已准备好，DMG 已完成严格校验并复制到桌面！")
  end
  
end
