# SkyBridge signaling production environment template.
#
# Deployment convention used by deploy scripts:
#   /opt/skybridge-signaling/shared/config/production.env
#
# Copy this file and fill values before first deployment.

NODE_ENV=production
HOST=127.0.0.1
PORT=8443
TRUST_PROXY=true
ALLOW_INSECURE=false
JSON_LIMIT=1mb
INSTANCE_ID=signaling-a
SIGNALING_STATE_BACKEND=memory
# Optional in-memory sharding prefixes for low-risk multi-instance rollout.
# Example for instance A in a 2-node cluster: ABCDEFGHJKLMNPQ
# Example for instance B in a 2-node cluster: RSTUVWXYZ23456789
INSTANCE_CODE_PREFIXES=
SIGNALING_REDIS_URL=
SIGNALING_REDIS_KEY_PREFIX=skybridge:signaling:
SIGNALING_REDIS_CHANNEL_PREFIX=skybridge:signaling:channel:
SIGNALING_REDIS_CONNECT_TIMEOUT_MS=5000

CODE_LEN=8
CODE_TTL_MS=300000
SWEEP_INTERVAL_MS=10000
ICE_TTL_MS=1800000
ICE_MAX_PER_SESSION=200
ROOM_MEMBERSHIP_TTL_MS=120000
LEGACY_BINDING_TTL_MS=300000

WS_MAX_MSG_BYTES=65536
WS_MAX_MSGS_PER_10S=200
WS_MAX_CLIENTS_PER_ROOM=4

# Optional low-risk affinity hint cookie for multi-instance deployments.
# In memory mode, pair this with deterministic code-prefix sharding at the nginx layer.
# Redis can be added later without changing app payloads.
ENABLE_STICKY_HINT_COOKIE=true
STICKY_HINT_COOKIE_NAME=skybridge_route
STICKY_HINT_COOKIE_MAX_AGE_SECONDS=600
STICKY_HINT_COOKIE_SECURE=true
STICKY_HINT_COOKIE_SAMESITE=Lax

# Comma-separated allow-list for browser origins. Keep empty for native-app only.
CORS_ORIGIN=

# TURN credential endpoint auth and credential generation.
TURN_ENFORCE_API_KEY=true
# Use a deployment-specific random value; do not reuse a repo-wide default.
TURN_CLIENT_API_KEY=
TURN_CRED_TTL_SECONDS=3600
TURN_URIS=turns:54.92.79.99:5349?transport=tcp,turn:54.92.79.99:3478?transport=udp

# Preferred mode: short-lived credentials from shared secret.
# If this is set, TURN_USERNAME/TURN_PASSWORD are ignored.
TURN_SHARED_SECRET=

# Fallback mode: static credentials (disabled by default, only for emergency rollback).
TURN_ALLOW_STATIC_FALLBACK=false
TURN_USERNAME=
TURN_PASSWORD=

# Optional Node HTTPS (normally disabled when using Nginx TLS termination).
TLS_CERT=
TLS_KEY=
TLS_CA=
