{
  "name": "skybridge-signaling",
  "version": "1.0.0",
  "description": "SkyBridge Compass Signaling Server",
  "private": true,
  "main": "server.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "start:media-relay": "node media_relay_standalone.js",
    "check": "node --check server.js && node --check local_compat_server.js && node --check media_relay_standalone.js && find lib test -maxdepth 2 -name '*.js' -print0 | xargs -0 -n1 node --check",
    "smoke": "bash ./deploy/scripts/smoke_local.sh http://127.0.0.1:8443"
  },
  "engines": {
    "node": ">=24.6.0"
  },
  "dependencies": {
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/openapi-client": "^0.4.15",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "redis": "^6.1.0",
    "standardwebhooks": "^1.0.0",
    "ws": "^8.21.1"
  },
  "allowScripts": {
    "@alicloud/openapi-core@1.0.7": true
  }
}
