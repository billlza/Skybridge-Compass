{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skybridge:policy-purpose-bound-session:experiment-evidence:v1",
  "title": "PolicyPurposeBoundSession experiment evidence manifest v1",
  "description": "Structural contract for diagnostic, source-capability, and physical-product interoperability evidence. Cross-field claim eligibility and artifact-byte verification require validate_experiment_evidence.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "evidence_id",
    "evidence_class",
    "product_scope",
    "claim_eligible",
    "bindings",
    "related_claim_ids",
    "claimed_claim_ids",
    "preregistration",
    "timing",
    "artifacts",
    "frozen_source",
    "endpoints",
    "transport",
    "cryptography",
    "file_transfers",
    "trust_state",
    "cleanup",
    "unsupported_product_claims",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "policy-purpose-bound-session/experiment-evidence/v1"},
    "evidence_id": {"$ref": "#/$defs/identifier"},
    "evidence_class": {
      "enum": ["diagnostic", "source_capability", "physical_product_interop"]
    },
    "product_scope": {"const": "bidirectional_file_transfer_v1"},
    "claim_eligible": {"type": "boolean"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "related_claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/claim_id"}
    },
    "claimed_claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/claim_id"}
    },
    "preregistration": {"$ref": "#/$defs/preregistration"},
    "timing": {"$ref": "#/$defs/timing"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "frozen_source": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/frozen_source"}
      ]
    },
    "endpoints": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/endpoint"}
    },
    "transport": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/transport"}
      ]
    },
    "cryptography": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/cryptography"}
      ]
    },
    "file_transfers": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/file_transfer"}
    },
    "trust_state": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/trust_state"}
    },
    "cleanup": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/cleanup"}
      ]
    },
    "unsupported_product_claims": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/unsupported_claim"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safe_text"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "maxLength": 128
    },
    "claim_id": {
      "enum": [
        "BS-APPLE-PHYSICAL-E2E",
        "BS-FILE-DURABLE-RECEIPT",
        "BS-NONAPPLE-INTEROP"
      ]
    },
    "safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_ref_or_null": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/identifier"}
      ]
    },
    "sha256_or_null": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "preregistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_binding_sha256",
        "registered_at",
        "protocol_document_sha256",
        "protocol_artifact_id"
      ],
      "properties": {
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "registered_at": {"$ref": "#/$defs/utc_timestamp"},
        "protocol_document_sha256": {"$ref": "#/$defs/sha256"},
        "protocol_artifact_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_started_at", "run_completed_at"],
      "properties": {
        "run_started_at": {"$ref": "#/$defs/utc_timestamp"},
        "run_completed_at": {"$ref": "#/$defs/utc_timestamp"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256", "size_bytes", "media_type"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {
          "enum": [
            "preregistration",
            "source_freeze",
            "build_record",
            "binary",
            "device_record",
            "selected_ice",
            "pqc_session",
            "file_transfer_record",
            "file_source",
            "file_receiver",
            "durable_commit",
            "durable_ack",
            "trust_snapshot",
            "cleanup_record"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "media_type": {"$ref": "#/$defs/safe_text"}
      }
    },
    "frozen_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "commit", "freeze_artifact_id"],
      "properties": {
        "repository_id": {"$ref": "#/$defs/identifier"},
        "commit": {"$ref": "#/$defs/revision"},
        "freeze_artifact_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_binding_sha256", "session_binding_sha256"],
      "properties": {
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_commit",
        "product_revision",
        "source_tree_state",
        "binary_sha256",
        "binary_artifact_id",
        "build_record_artifact_id"
      ],
      "properties": {
        "frozen_commit": {"$ref": "#/$defs/revision"},
        "product_revision": {"$ref": "#/$defs/revision"},
        "source_tree_state": {"enum": ["clean", "dirty", "unknown"]},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "binary_artifact_id": {"$ref": "#/$defs/identifier"},
        "build_record_artifact_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform",
        "device_class",
        "execution_environment",
        "device_pseudonym_sha256",
        "device_record_artifact_id",
        "build"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "platform": {
          "enum": ["android", "ios", "macos", "windows", "linux"]
        },
        "device_class": {
          "enum": ["phone", "tablet", "computer"]
        },
        "execution_environment": {
          "enum": [
            "physical_device",
            "simulator",
            "emulator",
            "virtual_machine",
            "container"
          ]
        },
        "device_pseudonym_sha256": {"$ref": "#/$defs/sha256_or_null"},
        "device_record_artifact_id": {"$ref": "#/$defs/artifact_ref_or_null"},
        "build": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/build"}
          ]
        }
      }
    },
    "ice_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_binding_sha256",
        "session_binding_sha256",
        "endpoint_id",
        "selected",
        "state",
        "candidate_pair_id",
        "local_candidate_type",
        "remote_candidate_type",
        "network_protocol",
        "artifact_id"
      ],
      "properties": {
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"},
        "endpoint_id": {"$ref": "#/$defs/identifier"},
        "selected": {"type": "boolean"},
        "state": {"enum": ["unknown", "checking", "failed", "succeeded"]},
        "candidate_pair_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/safe_text"}
          ]
        },
        "local_candidate_type": {"enum": ["unknown", "host", "srflx", "prflx", "relay"]},
        "remote_candidate_type": {"enum": ["unknown", "host", "srflx", "prflx", "relay"]},
        "network_protocol": {"enum": ["unknown", "udp", "tcp"]},
        "artifact_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_binding_sha256",
        "session_binding_sha256",
        "protocol",
        "pair_correlation_sha256",
        "reports"
      ],
      "properties": {
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"},
        "protocol": {"enum": ["webrtc_data_channel"]},
        "pair_correlation_sha256": {"$ref": "#/$defs/sha256_or_null"},
        "reports": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "#/$defs/ice_report"}
        }
      }
    },
    "crypto_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_binding_sha256",
        "session_binding_sha256",
        "endpoint_id",
        "authenticated",
        "suite_id",
        "artifact_id"
      ],
      "properties": {
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"},
        "endpoint_id": {"$ref": "#/$defs/identifier"},
        "authenticated": {"type": "boolean"},
        "suite_id": {"type": "integer", "minimum": 1, "maximum": 65535},
        "artifact_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "cryptography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_binding_sha256",
        "session_binding_sha256",
        "protocol_id",
        "suite_id",
        "suite_name",
        "kem_combination",
        "hybrid_profile_id",
        "reports"
      ],
      "properties": {
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"},
        "protocol_id": {"$ref": "#/$defs/safe_text"},
        "suite_id": {"type": "integer", "minimum": 1, "maximum": 65535},
        "suite_name": {"$ref": "#/$defs/safe_text"},
        "kem_combination": {"$ref": "#/$defs/safe_text"},
        "hybrid_profile_id": {"type": "integer", "minimum": 1, "maximum": 65535},
        "reports": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "#/$defs/crypto_report"}
        }
      }
    },
    "file_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256", "artifact_id"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "artifact_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "durable_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_binding_sha256",
        "session_binding_sha256",
        "status",
        "authenticated",
        "ack_protocol",
        "durable_commit_observed",
        "durability_primitive",
        "bytes",
        "sha256",
        "commit_artifact_id",
        "ack_artifact_id"
      ],
      "properties": {
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["missing", "rejected", "ambiguous", "committed_and_authenticated"]},
        "authenticated": {"type": "boolean"},
        "ack_protocol": {
          "oneOf": [
            {"type": "null"},
            {"const": "bound_session_effect_receipt_v1"}
          ]
        },
        "durable_commit_observed": {"type": "boolean"},
        "durability_primitive": {
          "oneOf": [
            {"type": "null"},
            {
              "enum": [
                "file_and_parent_directory_sync",
                "platform_atomic_file_commit",
                "transactional_durable_store_commit"
              ]
            }
          ]
        },
        "bytes": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0}
          ]
        },
        "sha256": {"$ref": "#/$defs/sha256_or_null"},
        "commit_artifact_id": {"$ref": "#/$defs/artifact_ref_or_null"},
        "ack_artifact_id": {"$ref": "#/$defs/artifact_ref_or_null"}
      }
    },
    "file_transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_binding_sha256",
        "session_binding_sha256",
        "transfer_id_sha256",
        "sender_endpoint_id",
        "receiver_endpoint_id",
        "sender_observation",
        "receiver_observation",
        "durable_ack",
        "transfer_record_artifact_id"
      ],
      "properties": {
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"},
        "transfer_id_sha256": {"$ref": "#/$defs/sha256"},
        "sender_endpoint_id": {"$ref": "#/$defs/identifier"},
        "receiver_endpoint_id": {"$ref": "#/$defs/identifier"},
        "sender_observation": {"$ref": "#/$defs/file_observation"},
        "receiver_observation": {"$ref": "#/$defs/file_observation"},
        "durable_ack": {"$ref": "#/$defs/durable_ack"},
        "transfer_record_artifact_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "trust_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_state_sha256", "record_count", "authority_epoch", "artifact_id"],
      "properties": {
        "semantic_state_sha256": {"$ref": "#/$defs/sha256"},
        "record_count": {"type": "integer", "minimum": 0},
        "authority_epoch": {"type": "integer", "minimum": 0},
        "artifact_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "trust_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_binding_sha256",
        "session_binding_sha256",
        "endpoint_id",
        "before",
        "after",
        "unchanged"
      ],
      "properties": {
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"},
        "endpoint_id": {"$ref": "#/$defs/identifier"},
        "before": {"$ref": "#/$defs/trust_snapshot"},
        "after": {"$ref": "#/$defs/trust_snapshot"},
        "unchanged": {"type": "boolean"}
      }
    },
    "cleanup_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_binding_sha256",
        "session_binding_sha256",
        "endpoint_id",
        "owner_binding_sha256",
        "result",
        "artifact_id"
      ],
      "properties": {
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"},
        "endpoint_id": {"$ref": "#/$defs/identifier"},
        "owner_binding_sha256": {"$ref": "#/$defs/sha256"},
        "result": {"enum": ["not_verified", "failed", "owner_verified_and_released"]},
        "artifact_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_binding_sha256",
        "session_binding_sha256",
        "ownership_verified",
        "session_terminated",
        "foreign_resources_touched",
        "records"
      ],
      "properties": {
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"},
        "ownership_verified": {"type": "boolean"},
        "session_terminated": {"type": "boolean"},
        "foreign_resources_touched": {"type": "boolean"},
        "records": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "#/$defs/cleanup_record"}
        }
      }
    },
    "raw_preregistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_binding_sha256",
        "contract_id",
        "product_scope",
        "registered_at",
        "protocol_document_sha256"
      ],
      "properties": {
        "kind": {"const": "preregistration"},
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "contract_id": {"const": "policy-purpose-bound-session/experiment-evidence/v1"},
        "product_scope": {"const": "bidirectional_file_transfer_v1"},
        "registered_at": {"$ref": "#/$defs/utc_timestamp"},
        "protocol_document_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "raw_source_freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_binding_sha256",
        "repository_id",
        "commit"
      ],
      "properties": {
        "kind": {"const": "source_freeze"},
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "repository_id": {"$ref": "#/$defs/identifier"},
        "commit": {"$ref": "#/$defs/revision"}
      }
    },
    "raw_build_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_binding_sha256",
        "endpoint_id",
        "frozen_commit",
        "product_revision",
        "source_tree_state",
        "binary_sha256"
      ],
      "properties": {
        "kind": {"const": "build_record"},
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "endpoint_id": {"$ref": "#/$defs/identifier"},
        "frozen_commit": {"$ref": "#/$defs/revision"},
        "product_revision": {"$ref": "#/$defs/revision"},
        "source_tree_state": {"enum": ["clean", "dirty", "unknown"]},
        "binary_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "raw_device_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_binding_sha256",
        "endpoint_id",
        "platform",
        "device_class",
        "execution_environment",
        "device_pseudonym_sha256"
      ],
      "properties": {
        "kind": {"const": "device_record"},
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "endpoint_id": {"$ref": "#/$defs/identifier"},
        "platform": {"enum": ["android", "ios", "macos", "windows", "linux"]},
        "device_class": {"enum": ["phone", "tablet", "computer"]},
        "execution_environment": {
          "enum": [
            "physical_device",
            "simulator",
            "emulator",
            "virtual_machine",
            "container"
          ]
        },
        "device_pseudonym_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "raw_selected_ice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_binding_sha256",
        "session_binding_sha256",
        "endpoint_id",
        "protocol",
        "pair_correlation_sha256",
        "selected",
        "state",
        "candidate_pair_id",
        "local_candidate_type",
        "remote_candidate_type",
        "network_protocol"
      ],
      "properties": {
        "kind": {"const": "selected_ice"},
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"},
        "endpoint_id": {"$ref": "#/$defs/identifier"},
        "protocol": {"const": "webrtc_data_channel"},
        "pair_correlation_sha256": {"$ref": "#/$defs/sha256_or_null"},
        "selected": {"type": "boolean"},
        "state": {"enum": ["unknown", "checking", "failed", "succeeded"]},
        "candidate_pair_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/safe_text"}
          ]
        },
        "local_candidate_type": {"enum": ["unknown", "host", "srflx", "prflx", "relay"]},
        "remote_candidate_type": {"enum": ["unknown", "host", "srflx", "prflx", "relay"]},
        "network_protocol": {"enum": ["unknown", "udp", "tcp"]}
      }
    },
    "raw_pqc_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_binding_sha256",
        "session_binding_sha256",
        "endpoint_id",
        "authenticated",
        "protocol_id",
        "suite_id",
        "suite_name",
        "kem_combination",
        "hybrid_profile_id"
      ],
      "properties": {
        "kind": {"const": "pqc_session"},
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"},
        "endpoint_id": {"$ref": "#/$defs/identifier"},
        "authenticated": {"type": "boolean"},
        "protocol_id": {"$ref": "#/$defs/safe_text"},
        "suite_id": {"type": "integer", "minimum": 1, "maximum": 65535},
        "suite_name": {"$ref": "#/$defs/safe_text"},
        "kem_combination": {"$ref": "#/$defs/safe_text"},
        "hybrid_profile_id": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "raw_file_transfer_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_binding_sha256",
        "session_binding_sha256",
        "transfer_id_sha256",
        "sender_endpoint_id",
        "receiver_endpoint_id",
        "bytes",
        "sha256"
      ],
      "properties": {
        "kind": {"const": "file_transfer_record"},
        "run_binding_sha256": {"$ref": "#/$defs/sha256"},
        "session_binding_sha256": {"$ref": "#/$defs/sha256"},
        "transfer_id_sha256": {"$ref": "#/$defs/sha256"},
        "sender_endpoint_id": {"$ref": "#/$defs/identifier"},
        "receiver_endpoint_id": {"$ref": "#/$defs/identifier"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
