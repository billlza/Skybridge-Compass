# ==========================================
# 云桥司南 - 部署环境变量配置模板
# ==========================================
# 
# 使用说明：
# 1. 复制此文件为 .env: cp env.example .env
# 2. 填写实际的配置值
# 3. 确保 .env 文件不被提交到 Git 仓库
#

# ==========================================
# 前端配置
# ==========================================

# Supabase 项目配置
VITE_SUPABASE_URL=https://hloqytmhjludmuhwyyzb.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhsb3F5dG1oamx1ZG11aHd5eXpiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTUzNTE3ODUsImV4cCI6MjA3MDkyNzc4NX0.xmDCgBo5IpDlzIerIz7y2jruh34MEYrtcepeK3x_HT0

# Nebula OAuth / PKCE 配置
# 本地联调可指向 SkyBridge Web/backend 默认地址 http://127.0.0.1:3000
# 生产环境请填写实际 Nebula issuer，例如 https://auth.example.com
VITE_NEBULA_BASE_URL=
VITE_NEBULA_CLIENT_ID=skybridge_compass_web
VITE_NEBULA_SCOPE=openid profile email offline_access

# 品牌与站点配置
VITE_SITE_BRAND=skybridge.com
VITE_PUBLIC_SITE_URL=https://nebula-technologies.net
VITE_AUTH_API_BASE_URL=https://api.skybridge.com

# ==========================================
# 后端配置 (如果使用 Rust 后端)
# ==========================================

# 数据库连接
DATABASE_URL=postgresql://postgres:password@db.hloqytmhjludmuhwyyzb.supabase.co:5432/postgres

# Supabase 服务密钥 (从 Supabase Dashboard 获取)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT 密钥 (从 Supabase Dashboard -> Settings -> API -> JWT Secret)
JWT_SECRET=your-jwt-secret-here

# CLI 浏览器登录桥
PUBLIC_SITE_URL=https://skybridge.com
CLI_LOGIN_ENCRYPTION_KEY=

# CORS 配置
# 开发环境可以使用 * ，生产环境建议指定具体域名
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,https://skybridge-compass.vercel.app,https://nebula-technologies.net,https://www.nebula-technologies.net,https://skybridge.com,https://www.skybridge.com

# 验证码发送服务
VERIFICATION_BRAND_NAME=skybridge.com
VERIFICATION_SUPPORT_EMAIL=support@nebula-technologies.net
VERIFICATION_EMAIL_FROM=Skybridge <no-reply@nebula-technologies.net>
VERIFICATION_EMAIL_REPLY_TO=support@nebula-technologies.net
RESEND_API_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 阿里云号码认证服务（短信认证）
# 这里请填写阿里云号码认证控制台“短信认证参数配置”里实际启用的签名
ALIYUN_SMS_VERIFY_SIGN_NAME=云桥司南验证平台
ALIYUN_SMS_VERIFY_TEMPLATE_BIND=100004
ALIYUN_SMS_VERIFY_TEMPLATE_UNBIND=100002
ALIYUN_SMS_VERIFY_TEMPLATE_VERIFY=100001
ALIYUN_SMS_VERIFY_ENDPOINT=dypnsapi.aliyuncs.com
# 兼容旧的普通短信变量名；若未配置会优先回退到上面的短信认证配置
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# 如果未使用 Messaging Service，可改为配置具体发信号码
TWILIO_FROM_PHONE=

# 日志级别: trace, debug, info, warn, error
LOG_LEVEL=info

# ==========================================
# 注意事项
# ==========================================
# 
# 1. SUPABASE_URL 和 SUPABASE_ANON_KEY 是公开的，可以在前端代码中使用
# 2. SUPABASE_SERVICE_ROLE_KEY 具有完全权限，务必保密，仅在后端使用
# 3. JWT_SECRET 用于验证 JWT 令牌，必须与 Supabase 项目设置中的值一致
# 4. 生产环境中，请修改所有密钥为实际值，不要使用默认值
# 5. 确保 .env 文件权限设置为 600 (仅所有者可读写)
#
